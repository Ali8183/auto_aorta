<!DOCTYPE html>
<html lang="tr" class="h-full bg-[#080B11] text-slate-100 antialiased">
  <head>
    <title><%= content_for(:title) || "AutoAorta | Sertifikalı 360° & 3D Otomobil Showroomu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Türkiye'nin ilk 3D Gaussian Splatting ve 360° stüdyo teknolojisiyle doğrulanmış premium ikinci el otomobil platformu. 160-Nokta TSE onaylı ekspertiz ve 7 gün iade garantisi.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: #080B11;
        color: #F1F5F9;
      }
      h1, h2, h3, h4, .font-display, .font-headline {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-mono-code {
        font-family: 'JetBrains Mono', monospace;
      }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
      }
      /* Custom luxury scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #080B11;
      }
      ::-webkit-scrollbar-thumb {
        background: #1E293B;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #334155;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-[#080B11] text-slate-100 selection:bg-blue-600 selection:text-white relative overflow-x-hidden">
    <!-- Top Ambient Lighting Cones -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[400px] bg-gradient-to-b from-blue-600/12 via-indigo-600/5 to-transparent blur-[140px] pointer-events-none z-0"></div>
    <div class="fixed top-1/3 -left-[200px] w-[500px] h-[500px] bg-blue-500/5 blur-[160px] pointer-events-none z-0"></div>
    <div class="fixed top-1/2 -right-[200px] w-[500px] h-[500px] bg-indigo-500/5 blur-[160px] pointer-events-none z-0"></div>

    <!-- Top VIP Customer Hotline & Trust Bar -->
    <div class="relative z-50 bg-[#0B0F17]/90 text-slate-400 text-xs py-2 px-4 sm:px-6 lg:px-8 border-b border-white/[0.06] backdrop-blur-md">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <div class="flex items-center gap-4 text-[11px] sm:text-xs">
          <span class="inline-flex items-center gap-1.5 text-emerald-400 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Maslak Showroom Açık (09:00 - 19:30)</span>
          </span>
          <span class="text-slate-700 hidden sm:inline">•</span>
          <span class="flex items-center gap-1.5 text-slate-300">
            <span class="material-symbols-outlined text-sm text-blue-400">verified</span>
            <span>TSE Onaylı 160-Nokta Ekspertiz</span>
          </span>
          <span class="text-slate-700 hidden md:inline">•</span>
          <span class="hidden md:flex items-center gap-1.5 text-slate-300">
            <span class="material-symbols-outlined text-sm text-amber-400">lock</span>
            <span>7 Gün / 500 km Koşulsuz Para İadesi</span>
          </span>
        </div>

        <div class="flex items-center gap-4 text-[11px] sm:text-xs text-slate-300">
          <a href="tel:08503008090" class="flex items-center gap-1.5 hover:text-white transition">
            <span class="material-symbols-outlined text-sm text-blue-400">phone_in_talk</span>
            <span>VIP Satış Hattı: <strong class="text-white font-semibold">0850 300 80 90</strong></span>
          </a>
          <span class="text-slate-700">|</span>
          <a href="https://wa.me/905325004030?text=Merhaba,%20araçlar%20hakkında%20bilgi%20almak%20istiyorum." target="_blank" class="flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 transition font-medium">
            <span class="material-symbols-outlined text-sm">chat</span>
            <span>WhatsApp Concierge</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Header (Floating Glassmorphism) -->
    <header class="sticky top-0 z-40 bg-[#080B11]/80 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <!-- Brand Logo -->
        <div class="flex items-center gap-8">
          <%= link_to root_path, class: "flex items-center gap-3.5 group" do %>
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center shadow-lg shadow-blue-600/30 ring-1 ring-white/20 group-hover:scale-105 transition-all duration-300">
              <span class="material-symbols-outlined text-white text-2xl">view_in_ar</span>
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-2">
                <span class="font-display font-extrabold text-xl tracking-tight text-white group-hover:text-blue-400 transition">AutoAorta</span>
                <span class="px-2 py-0.5 text-[9px] font-bold tracking-[0.2em] uppercase rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/30">ATELIER</span>
              </div>
              <span class="text-[10px] tracking-wider uppercase font-semibold text-slate-400">3D & 360° Showroom</span>
            </div>
          <% end %>

          <div class="hidden lg:block h-6 w-px bg-white/10"></div>

          <!-- Primary Navigation Links -->
          <nav class="hidden md:flex items-center gap-6 text-xs uppercase tracking-wider font-semibold">
            <%= link_to root_path, class: "flex items-center gap-2 py-2 #{current_page?(root_path) ? 'text-white border-b-2 border-blue-500' : 'text-slate-400 hover:text-white'} transition" do %>
              <span class="material-symbols-outlined text-base text-blue-400">directions_car</span>
              <span>Araç Filosu</span>
            <% end %>

            <% sample_car = Listing.first %>
            <% if sample_car %>
              <%= link_to listing_path(sample_car), class: "flex items-center gap-2 py-2 #{defined?(@listing) && @listing&.persisted? ? 'text-white border-b-2 border-blue-500' : 'text-slate-400 hover:text-white'} transition" do %>
                <span class="material-symbols-outlined text-base text-indigo-400">360</span>
                <span>360° Showroom</span>
              <% end %>
            <% end %>

            <%= link_to capture_path, class: "flex items-center gap-2 py-2 #{current_page?(capture_path) ? 'text-white border-b-2 border-blue-500' : 'text-slate-400 hover:text-white'} transition" do %>
              <span class="material-symbols-outlined text-base text-emerald-400">videocam</span>
              <span>108 Kare 3D Çekim</span>
            <% end %>

            <a href="<%= root_path %>#customer-guarantees" class="flex items-center gap-2 py-2 text-slate-400 hover:text-white transition">
              <span class="material-symbols-outlined text-base text-amber-400">verified_user</span>
              <span>Ekspertiz Standartları</span>
            </a>
          </nav>
        </div>

        <!-- Right Action Center -->
        <div class="flex items-center gap-4">
          <!-- Search Bar -->
          <div class="relative hidden xl:block w-72">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-lg pointer-events-none">search</span>
            <input id="nav-search-input"
                   type="text"
                   placeholder="Araç ara (BMW, Tesla, Porsche...)"
                   onclick="const s = document.getElementById('fleet-search-input'); if (s) { s.focus(); s.scrollIntoView({ behavior: 'smooth', block: 'center' }); } else { window.location.href = '<%= root_path(anchor: 'fleet-search-input') %>'; }"
                   class="w-full h-10 pl-10 pr-4 rounded-xl bg-slate-900/80 border border-white/10 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition cursor-pointer" />
            <kbd class="absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5 rounded bg-slate-800 text-[10px] font-mono text-slate-400 border border-white/5">⌘K</kbd>
          </div>

          <!-- Add Listing CTA Button -->
          <%= link_to new_listing_path, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs shadow-lg shadow-blue-600/30 ring-1 ring-white/20 transition active:scale-95" do %>
            <span class="material-symbols-outlined text-base">add_circle</span>
            <span class="hidden sm:inline">Yeni İlan Ekle</span>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Flash Messages Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4 relative z-30">
      <% if notice %>
        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/60 backdrop-blur-md p-4 text-emerald-300 flex items-start gap-3 shadow-xl mb-4">
          <span class="material-symbols-outlined text-emerald-400 text-xl mt-0.5">check_circle</span>
          <div class="text-sm font-medium leading-relaxed">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="rounded-2xl border border-amber-500/30 bg-amber-950/60 backdrop-blur-md p-4 text-amber-300 flex items-start gap-3 shadow-xl mb-4">
          <span class="material-symbols-outlined text-amber-400 text-xl mt-0.5">warning</span>
          <div class="text-sm font-medium leading-relaxed">
            <%= alert %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Main Content Canvas -->
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full relative z-10">
      <%= yield %>
    </main>

    <!-- Real Customer-Facing Luxury Automotive Footer -->
    <footer class="border-t border-white/[0.08] bg-[#06080D] mt-24 text-slate-400 text-xs relative z-10">
      <!-- 4 Pillars Ribbon (Luxury Bento Row) -->
      <div class="border-b border-white/[0.06] bg-slate-900/30 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.05] flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-2xl">view_in_ar</span>
            </div>
            <div>
              <span class="font-bold text-white text-sm block">Gerçek 3D & 360° Vitrin</span>
              <p class="text-slate-400 text-xs mt-1 leading-relaxed">Fotoğraf esnetme veya sahte çizim yok; aracın gerçek piksel verisiyle 3D inceleyin.</p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.05] flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-2xl">verified</span>
            </div>
            <div>
              <span class="font-bold text-white text-sm block">160-Nokta TSE Ekspertiz</span>
              <p class="text-slate-400 text-xs mt-1 leading-relaxed">Kaporta, motor, şasi, mekanik ve elektronik aksam bağımsız teknisyenlerce incelenir.</p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.05] flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-2xl">lock</span>
            </div>
            <div>
              <span class="font-bold text-white text-sm block">7 Gün İade Garantisi</span>
              <p class="text-slate-400 text-xs mt-1 leading-relaxed">Satın aldığınız aracı 7 gün veya 500 km boyunca test edin, memnun kalmazsanız iade edin.</p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.05] flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-2xl">local_shipping</span>
            </div>
            <div>
              <span class="font-bold text-white text-sm block">81 İle Kapıda Teslimat</span>
              <p class="text-slate-400 text-xs mt-1 leading-relaxed">Türkiye'nin her yerine özel kapalı kasa çekici ile aracınızı kapınıza teslim ediyoruz.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Footer Columns -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
        <!-- Col 1: Brand Info -->
        <div class="lg:col-span-2 space-y-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white ring-1 ring-white/20">
              <span class="material-symbols-outlined text-xl">view_in_ar</span>
            </div>
            <div>
              <span class="font-display font-extrabold text-lg text-white">AutoAorta Atelier</span>
              <p class="text-[10px] text-slate-500 tracking-wider uppercase font-semibold">Luxury Automotive Showcase</p>
            </div>
          </div>
          <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
            AutoAorta, ikinci el otomotiv perakendeciliğinde güven, şeffaflık ve ileri görsel teknolojiyi buluşturan yeni nesil otomobil platformudur. Araçların tüm kusurları ve ekspertiz kayıtları şeffaf bir şekilde sergilenir.
          </p>
          <div class="flex items-center gap-3 pt-2">
            <span class="px-3 py-1.5 rounded-lg bg-white/[0.05] border border-white/10 text-white font-semibold text-[11px] hover:bg-white/10 transition cursor-pointer">Instagram</span>
            <span class="px-3 py-1.5 rounded-lg bg-white/[0.05] border border-white/10 text-white font-semibold text-[11px] hover:bg-white/10 transition cursor-pointer">YouTube</span>
            <span class="px-3 py-1.5 rounded-lg bg-white/[0.05] border border-white/10 text-white font-semibold text-[11px] hover:bg-white/10 transition cursor-pointer">LinkedIn</span>
          </div>
        </div>

        <!-- Col 2: Araçlar -->
        <div class="space-y-4">
          <span class="font-bold text-white text-xs uppercase tracking-widest block">Araç Filosu</span>
          <ul class="space-y-2.5 text-xs">
            <li><%= link_to "Tüm İkinci El Araçlar", root_path, class: "hover:text-blue-400 transition" %></li>
            <li><a href="<%= root_path %>?fuel=elektrik" class="hover:text-blue-400 transition">Elektrikli Araçlar (EV)</a></li>
            <li><a href="<%= root_path %>?body=suv" class="hover:text-blue-400 transition">Premium SUV Modeller</a></li>
            <li><a href="<%= root_path %>?brand=bmw" class="hover:text-blue-400 transition">BMW M & Spor Serisi</a></li>
            <li><a href="<%= root_path %>?brand=tesla" class="hover:text-blue-400 transition">Tesla Model 3 & Y</a></li>
            <li><a href="<%= root_path %>?brand=porsche" class="hover:text-blue-400 transition">Porsche Macan & Taycan</a></li>
          </ul>
        </div>

        <!-- Col 3: Hizmetler & Güvenceler -->
        <div class="space-y-4">
          <span class="font-bold text-white text-xs uppercase tracking-widest block">Müşteri Güvenceleri</span>
          <ul class="space-y-2.5 text-xs">
            <li><a href="#customer-guarantees" class="hover:text-blue-400 transition">160-Nokta Ekspertiz Standardı</a></li>
            <li><a href="#customer-guarantees" class="hover:text-blue-400 transition">7 Gün Koşulsuz Para İadesi</a></li>
            <li><a href="#customer-guarantees" class="hover:text-blue-400 transition">12 Ay Kapsamlı Mekanik Garanti</a></li>
            <li><a href="#" class="hover:text-blue-400 transition">Taşıt Kredisi & Finansman Simülatörü</a></li>
            <li><a href="#" class="hover:text-blue-400 transition">Hızlı Takas Değerleme</a></li>
            <li><%= link_to "108 Kare 3D Çekim ile Aracını Sat", capture_path, class: "hover:text-blue-400 transition" %></li>
          </ul>
        </div>

        <!-- Col 4: İletişim & Showroom -->
        <div class="space-y-4">
          <span class="font-bold text-white text-xs uppercase tracking-widest block">Atelier Showroom</span>
          <div class="space-y-2.5 text-xs text-slate-400">
            <p class="text-white font-semibold">AutoAorta Maslak Showroom</p>
            <p>Büyükdere Cad. No: 142, Maslak / Sarıyer / İstanbul</p>
            <p><strong class="text-slate-300">Telefon:</strong> 0850 300 80 90</p>
            <p><strong class="text-slate-300">E-posta:</strong> atelier@autoaorta.com</p>
            <div class="pt-2 text-[11px] text-slate-500">
              <p>Pazartesi – Cumartesi: 09:00 – 19:30</p>
              <p>Pazar: 11:00 – 18:00</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="border-t border-white/[0.06] py-6 text-[11px] text-slate-500">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            &copy; <%= Time.current.year %> AutoAorta Otomotiv Tic. A.Ş. Tüm hakları saklıdır.
          </div>
          <div class="flex items-center gap-6">
            <a href="#" class="hover:text-slate-300 transition">Gizlilik Politikası</a>
            <a href="#" class="hover:text-slate-300 transition">Kullanım Koşulları</a>
            <a href="#" class="hover:text-slate-300 transition">KVKK Aydınlatma Metni</a>
            <a href="#" class="hover:text-slate-300 transition">Çerez Tercihleri</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
