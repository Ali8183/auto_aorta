<!DOCTYPE html>
<html lang="tr" class="h-full bg-[#F8FAFC] text-[#0F172A] antialiased">
  <head>
    <title><%= content_for(:title) || "AutoAorta AI | Enterprise Vehicle Merchandising & 360 Spin Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      h1, h2, h3, h4, .font-display, .font-headline {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-mono-code {
        font-family: 'JetBrains Mono', monospace;
      }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-[#F8FAFC] text-[#0F172A] selection:bg-[#1D4ED8] selection:text-white">
    <!-- Top Enterprise Showroom Header (Stitch Daylight Design) -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-[0_1px_8px_rgba(0,0,0,0.03)]">
      <!-- Upper Command Tier -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <%= link_to root_path, class: "flex items-center gap-3 group" do %>
            <div class="w-10 h-10 rounded-xl bg-[#1D4ED8] flex items-center justify-center shadow-md shadow-blue-600/20 group-hover:bg-blue-800 transition">
              <span class="material-symbols-outlined text-white text-2xl">view_in_ar</span>
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-2">
                <span class="font-display font-extrabold text-lg tracking-tight text-[#0F172A]">AutoAorta</span>
                <span class="px-1.5 py-0.5 text-[10px] font-bold tracking-wider uppercase rounded bg-blue-50 text-[#1D4ED8] border border-blue-200">ENTERPRISE</span>
              </div>
              <span class="text-[11px] font-medium text-slate-500">Automotive Merchandising Studio</span>
            </div>
          <% end %>

          <div class="hidden md:block h-5 w-px bg-slate-200"></div>

          <!-- Flagship Location Pill -->
          <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium">
            <span class="material-symbols-outlined text-slate-400 text-sm">store</span>
            <span>AutoAorta Flagship • Premier Bay</span>
          </div>

          <!-- Live Dome Status -->
          <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Daylight Bay 04 • Online</span>
          </div>
        </div>

        <!-- Right Quick Controls -->
        <div class="flex items-center gap-3">
          <button type="button"
                  onclick="const s = document.getElementById('fleet-search-input'); if (s) { s.focus(); s.scrollIntoView({ behavior: 'smooth', block: 'center' }); } else { window.location.href = '<%= root_path(anchor: 'fleet-search-input') %>'; }"
                  class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 text-slate-500 text-xs hover:bg-slate-200 transition cursor-pointer">
            <span class="material-symbols-outlined text-sm">search</span>
            <span>Quick search inventory</span>
            <kbd class="px-1.5 py-0.5 rounded bg-white text-slate-600 font-mono text-[10px] shadow-xs">⌘K</kbd>
          </button>

          <%= link_to new_listing_path, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs shadow-sm transition active:scale-[0.99]" do %>
            <span class="material-symbols-outlined text-sm">photo_camera</span>
            <span>Yeni Araç Ingest</span>
          <% end %>

          <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
            <div class="w-8 h-8 rounded-full bg-slate-200 border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-700">
              MS
            </div>
            <div class="hidden xl:flex flex-col text-left">
              <span class="text-xs font-semibold text-slate-800 leading-tight">Marcus S.</span>
              <span class="text-[10px] text-slate-400 leading-tight">Studio Lead</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Lower Navigation & Telemetry Tier -->
      <% studio_target_listing = (@listing if defined?(@listing) && @listing&.persisted?) || Listing.order(created_at: :desc).first %>
      <div class="border-t border-slate-200 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-10 flex items-center justify-between text-xs">
          <nav class="flex items-center gap-6 h-full font-medium">
            <%= link_to root_path, class: "h-full flex items-center border-b-2 #{current_page?(root_path) ? 'border-[#1D4ED8] text-[#1D4ED8] font-semibold' : 'border-transparent text-slate-600 hover:text-slate-900'} transition-colors" do %>
              Inventory & Merchandising
            <% end %>
            <%= link_to (studio_target_listing ? listing_path(studio_target_listing, anchor: "turntable-container") : root_path),
                        class: "h-full flex items-center border-b-2 #{defined?(@listing) && @listing&.persisted? ? 'border-[#1D4ED8] text-[#1D4ED8] font-semibold' : 'border-transparent text-slate-600 hover:text-slate-900'} transition-colors" do %>
              Vehicle 360 Studio
            <% end %>
            <%= link_to (defined?(@listing) && @listing&.persisted? ? listing_path(@listing, anchor: "before-after-analytics") : root_path(anchor: "telemetry-analytics")),
                        class: "h-full flex items-center border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition-colors" do %>
              CTR & Performance Analytics
            <% end %>
            <%= link_to new_listing_path,
                        class: "h-full flex items-center border-b-2 #{current_page?(new_listing_path) ? 'border-[#1D4ED8] text-[#1D4ED8] font-semibold' : 'border-transparent text-slate-600 hover:text-slate-900'} transition-colors" do %>
              Studio Asset Enhancer / Staging
            <% end %>
          </nav>

          <div class="hidden md:flex items-center gap-4 text-slate-500 font-medium">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[#1D4ED8] text-sm">wb_sunny</span>
              <span>Daylight D65 • 5400K Dome</span>
            </span>
            <span class="text-slate-300">•</span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-emerald-600 text-sm">360</span>
              <span>360 Turntable Ready (72/72 Frames)</span>
            </span>
            <span class="text-slate-300">•</span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-emerald-600 text-sm">sync</span>
              <span>Lot Sync: Active</span>
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Flash Messages -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
      <% if notice %>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900 flex items-start gap-3 shadow-sm mb-4">
          <span class="material-symbols-outlined text-emerald-600 text-xl mt-0.5">check_circle</span>
          <div class="text-sm font-medium leading-relaxed">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900 flex items-start gap-3 shadow-sm mb-4">
          <span class="material-symbols-outlined text-amber-600 text-xl mt-0.5">warning</span>
          <div class="text-sm font-medium leading-relaxed">
            <%= alert %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Main Content Canvas -->
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
      <%= yield %>
    </main>

    <!-- Daylight Architectural Studio Footer -->
    <footer class="border-t border-slate-200 bg-white py-6 mt-16 text-slate-500 text-xs shadow-[0_-1px_4px_rgba(0,0,0,0.02)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="font-bold text-slate-800 tracking-tight">AutoAorta Automotive Retail Platform</span>
          <span class="text-slate-300">|</span>
          <span class="text-slate-500 font-mono">v4.8.2 Studio Engine</span>
        </div>
        <div class="flex items-center gap-6 text-slate-400">
          <span>Certified ISO Daylight Standard (D65 / 1000 Lux)</span>
          <span>&copy; <%= Time.current.year %> AutoAorta Technologies. All rights reserved.</span>
        </div>
      </div>
    </footer>
  </body>
</html>

