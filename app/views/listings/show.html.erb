<div class="space-y-8">
  <% fallback_src = vehicle_fallback_image(@listing) %>
  <% hero_src = listing_hero_image_url(@listing) %>
  <% brand_gallery = brand_angle_gallery(@listing) %>
  <% spin_image_urls = safe_spin_image_urls(@listing, @spin_photos) %>
  <% spin_angle_labels = @spin_photos.any? ? @spin_photos.map.with_index do |p, idx|
       analysis = @photo_analyses.find { |a| a.blob_id == p.blob_id }
       analysis&.detected_angle&.titleize || "Açı #{idx + 1}"
     end : ["Front Three Quarter", "Front", "Side", "Rear Three Quarter", "Rear"] %>

  <!-- Top Breadcrumb & Studio Command Bar (Stitch Daylight Design) -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <%= link_to "Inventory & Merchandising", root_path, class: "hover:text-[#1D4ED8] transition" %>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-700"><%= @listing.brand %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-800 font-semibold"><%= @listing.model_name %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-mono text-[11px]">
          VIN: <%= @listing.brand[0..2].upcase %><%= @listing.id.to_s.rjust(8, '0') %>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <h1 class="font-headline text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight">
          <%= @listing.title %>
        </h1>

        <!-- Status Badges Row -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Daylight Merchandised
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 text-[#1D4ED8] border border-blue-200 text-xs font-semibold shadow-xs">
            <span class="material-symbols-outlined text-sm">360</span>
            360° Spin Hazır (72 Kare)
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium shadow-xs">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified</span>
            160-Nokta Sertifikalı
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Studio Actions Toolbar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- AI Optimizasyonunu Başlat -->
      <%= button_to optimize_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition cursor-pointer" do %>
        <span class="material-symbols-outlined text-sm text-[#1D4ED8]">sync</span>
        <span>Re-shoot Turntable</span>
      <% end %>

      <!-- Yayına Al -->
      <% unless @listing.published? %>
        <%= button_to publish_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs shadow-sm transition cursor-pointer active:scale-[0.99]" do %>
          <span class="material-symbols-outlined text-sm">rocket_launch</span>
          <span>Publish Live to Portals</span>
        <% end %>
      <% end %>

      <!-- 24 Saat İleri Sar (SLA Testi) -->
      <%= button_to simulate_time_lapse_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-amber-800 border border-slate-200 font-semibold text-xs transition cursor-pointer", title: "24 saat kuralını simüle eder" do %>
        <span class="material-symbols-outlined text-sm text-amber-600">timer</span>
        <span>24h SLA Simüle Et</span>
      <% end %>

      <!-- Sil -->
      <%= button_to listing_path(@listing), method: :delete, data: { turbo_confirm: "Bu aracı filodan silmek istediğinize emin misiniz?" }, class: "p-2 rounded-xl bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 border border-slate-200 transition cursor-pointer", title: "İlanı Sil" do %>
        <span class="material-symbols-outlined text-base">delete</span>
      <% end %>
    </div>
  </div>

  <!-- SLA 24 Saat Bilgilendirme Çubuğu (Daylight) -->
  <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-slate-700 shadow-xs">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-blue-100 text-[#1D4ED8] flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-base">schedule</span>
      </div>
      <div>
        <span class="font-bold text-slate-900">24 Saatlik Otomatik Yayınlama SLA Kuralı:</span>
        <span class="text-slate-600"> AI ile optimize edilen araç fotoğrafları 24 saat içinde onaylanmazsa sistem otomatik olarak vitrine ve syndication kanallarına iletir.</span>
      </div>
    </div>
    <% if @listing.optimized? && @listing.optimized_at.present? %>
      <div class="px-3 py-1 rounded-lg bg-white border border-blue-200 text-[#1D4ED8] font-mono text-xs whitespace-nowrap shadow-xs">
        Kalan Süre: <%= [((@listing.optimized_at + 24.hours - Time.current) / 3600).round(1), 0].max %> saat
      </div>
    <% elsif @listing.published? && @listing.auto_published_at.present? %>
      <div class="px-3 py-1 rounded-lg bg-white border border-emerald-200 text-emerald-700 font-mono text-xs whitespace-nowrap shadow-xs">
        Auto-Published: <%= @listing.auto_published_at.strftime("%d.%m.%Y %H:%M") %> (SLA)
      </div>
    <% end %>
  </div>

  <!-- MAIN STUDIO GRID: 12-Column Responsive Layout (Stitch Daylight) -->
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <!-- SOL 8 KOLON: Central Interactive 360 Studio Turntable Stage & Details -->
    <div class="xl:col-span-8 space-y-6">
      <!-- 1. 360° VİTRİN İÇİN MOD SEÇİCİ (TABS) -->
      <div class="bg-white rounded-2xl border border-slate-200 p-2 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2" role="tablist" aria-label="360 Vitrin Mod Seçici">
        <button type="button"
                id="tab-btn-photo"
                onclick="switchShowroomTab('photo')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-[#1D4ED8] text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition cursor-pointer">
          <span>📸 360° Doğrulanmış Fotoğraf Turu</span>
          <span class="px-1.5 py-0.5 rounded-full bg-white/20 text-[10px] font-mono"><%= spin_image_urls.size %> Kare</span>
        </button>

        <button type="button"
                id="tab-btn-playcanvas"
                onclick="switchShowroomTab('playcanvas')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
          <span>🎮 PlayCanvas 3D Canlı Showroom</span>
          <span class="px-1.5 py-0.5 rounded-full bg-blue-100 text-[#1D4ED8] text-[10px] font-mono">WebGL</span>
        </button>

        <button type="button"
                id="tab-btn-guardrail"
                onclick="switchShowroomTab('guardrail')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
          <span>🛡️ Tüketici Güvenliği & Ekspertiz Kilidi</span>
        </button>
      </div>

      <!-- TAB 1 PANEL: 360° Doğrulanmış Fotoğraf Turu & Carvana Kusur/Hasar Pinleri -->
      <div id="tab-panel-photo" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden select-none relative group flex flex-col justify-between">
        <div id="turntable-container" class="relative flex flex-col justify-between w-full">
          <!-- Studio Mode Overhead Softbox Light Glow Gradient -->
          <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-slate-100/90 via-slate-50/30 to-transparent pointer-events-none z-10"></div>
          <!-- Ground Architectural Reflection Ellipse -->
          <div class="absolute bottom-6 inset-x-12 h-16 bg-gradient-to-t from-slate-200/50 via-slate-100/20 to-transparent rounded-full filter blur-xl pointer-events-none"></div>

          <div data-controller="vehicle-spin"
               data-vehicle-spin-images-value="<%= spin_image_urls.to_json %>"
               data-vehicle-spin-angles-value="<%= spin_angle_labels.to_json %>"
               data-vehicle-spin-current-index-value="0"
               class="flex flex-col w-full">

            <!-- Studio HUD Top Bar -->
            <div class="relative z-20 w-full p-4 flex flex-wrap items-center justify-between gap-2 pointer-events-auto">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded bg-white/90 backdrop-blur-md text-slate-800 font-mono text-xs font-bold tracking-tight shadow-xs border border-slate-200">
                  GERÇEK PİKSEL • SIFIR HALÜSİNASYON
                </span>
                <span class="px-2.5 py-1 rounded bg-white/90 backdrop-blur-md text-[#1D4ED8] font-mono text-xs font-semibold shadow-xs border border-slate-200"
                      data-vehicle-spin-target="angleLabel">
                  <%= spin_angle_labels.first %>
                </span>
              </div>

              <!-- View Modes & Fullscreen -->
              <div class="flex items-center gap-2">
                <button type="button"
                        onclick="document.querySelectorAll('.hotspot-pin').forEach(p => p.classList.toggle('hidden'))"
                        class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-50/95 backdrop-blur-md hover:bg-amber-100 text-amber-900 text-xs font-semibold border border-amber-300 shadow-xs transition cursor-pointer">
                  <span class="material-symbols-outlined text-sm text-amber-600">pin_drop</span>
                  <span>Carvana Kusur & Ekspertiz Pinleri (3 Aktif)</span>
                </button>
                <button type="button"
                        data-action="click->vehicle-spin#toggleFullscreen"
                        class="p-1 rounded-lg bg-white/90 backdrop-blur-md hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-xs transition cursor-pointer"
                        title="Tam Ekran">
                  <span class="material-symbols-outlined text-base">fullscreen</span>
                </button>
              </div>
            </div>

            <!-- Vehicle Visual Viewport Stage -->
            <div class="relative z-10 w-full aspect-[16/10] flex items-center justify-center cursor-grab px-6 overflow-hidden"
                 data-vehicle-spin-target="spinContainer"
                 data-action="pointerdown->vehicle-spin#onPointerDown">

              <img id="turntable-main-image"
                   data-vehicle-spin-target="image"
                   src="<%= spin_image_urls.first || fallback_src %>"
                   alt="<%= @listing.title %>"
                   class="w-full h-full max-h-[460px] object-contain pointer-events-none select-none transition-transform duration-75"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />

              <!-- 3. CARVANA STANDARDI "KUSUR & HASAR PİNLERİ" (HOTSPOTS) -->
              <!-- Pin 1 (Ön Tampon): Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez) -->
              <div class="hotspot-pin absolute bottom-[34%] left-[22%] z-30 group/pin cursor-pointer"
                   onpointerdown="event.stopPropagation();"
                   onclick="event.stopPropagation(); selectHotspotInspection(1);">
                <div class="relative flex items-center justify-center">
                  <div class="w-7 h-7 rounded-full bg-amber-500/30 animate-ping absolute"></div>
                  <div class="w-6 h-6 rounded-full bg-amber-500 hover:bg-amber-600 text-white flex items-center justify-center shadow-lg border-2 border-white transform group-hover/pin:scale-110 transition-transform text-xs font-extrabold">
                    1
                  </div>
                  <div id="hotspot-popover-1" class="hotspot-popover absolute bottom-8 left-0 hidden group-hover/pin:flex flex-col w-64 p-3 rounded-xl bg-white/98 backdrop-blur-md shadow-xl border-2 border-amber-400 z-40">
                    <div class="flex items-center justify-between gap-1 text-amber-700 text-[11px] font-extrabold uppercase">
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-xs">warning</span>
                        <span>Pin 1 • Ön Tampon</span>
                      </span>
                      <span class="px-1.5 py-0.2 rounded bg-amber-100 text-amber-800 text-[9px]">Şeffaf Kayıt</span>
                    </div>
                    <p class="text-xs font-semibold text-slate-800 mt-1">
                      Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez)
                    </p>
                    <span class="text-[10px] text-emerald-700 font-medium mt-1">
                      ✓ AI bu kusuru gizlemedi, orijinal piksel korundu.
                    </span>
                  </div>
                </div>
              </div>

              <!-- Pin 2 (Jant): 19 inç M-Sport Jant: Çiziksiz, balans hatasız -->
              <div class="hotspot-pin absolute bottom-[26%] right-[30%] z-30 group/pin cursor-pointer"
                   onpointerdown="event.stopPropagation();"
                   onclick="event.stopPropagation(); selectHotspotInspection(2);">
                <div class="relative flex items-center justify-center">
                  <div class="w-7 h-7 rounded-full bg-blue-500/25 animate-ping absolute"></div>
                  <div class="w-6 h-6 rounded-full bg-[#1D4ED8] hover:bg-blue-800 text-white flex items-center justify-center shadow-lg border-2 border-white transform group-hover/pin:scale-110 transition-transform text-xs font-extrabold">
                    2
                  </div>
                  <div id="hotspot-popover-2" class="hotspot-popover absolute bottom-8 -left-28 hidden group-hover/pin:flex flex-col w-64 p-3 rounded-xl bg-white/98 backdrop-blur-md shadow-xl border-2 border-blue-500 z-40">
                    <div class="flex items-center justify-between gap-1 text-[#1D4ED8] text-[11px] font-extrabold uppercase">
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-xs">tire_repair</span>
                        <span>Pin 2 • Jant Kondisyonu</span>
                      </span>
                      <span class="px-1.5 py-0.2 rounded bg-blue-50 text-[#1D4ED8] text-[9px]">Kusursuz</span>
                    </div>
                    <p class="text-xs font-semibold text-slate-800 mt-1">
                      19 inç M-Sport Jant: Çiziksiz, balans hatasız
                    </p>
                    <span class="text-[10px] text-slate-500 mt-1">
                      Lazer salgı ve kaldırım sürtmesi kontrolü: 0 hata.
                    </span>
                  </div>
                </div>
              </div>

              <!-- Pin 3 (Ön Cam): Orijinal fabrika camı: Çatlak yok -->
              <div class="hotspot-pin absolute top-[32%] left-[44%] z-30 group/pin cursor-pointer"
                   onpointerdown="event.stopPropagation();"
                   onclick="event.stopPropagation(); selectHotspotInspection(3);">
                <div class="relative flex items-center justify-center">
                  <div class="w-7 h-7 rounded-full bg-emerald-500/25 animate-ping absolute"></div>
                  <div class="w-6 h-6 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center shadow-lg border-2 border-white transform group-hover/pin:scale-110 transition-transform text-xs font-extrabold">
                    3
                  </div>
                  <div id="hotspot-popover-3" class="hotspot-popover absolute bottom-8 -left-24 hidden group-hover/pin:flex flex-col w-64 p-3 rounded-xl bg-white/98 backdrop-blur-md shadow-xl border-2 border-emerald-500 z-40">
                    <div class="flex items-center justify-between gap-1 text-emerald-700 text-[11px] font-extrabold uppercase">
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-xs">verified</span>
                        <span>Pin 3 • Ön Cam</span>
                      </span>
                      <span class="px-1.5 py-0.2 rounded bg-emerald-50 text-emerald-700 text-[9px]">OEM Onaylı</span>
                    </div>
                    <p class="text-xs font-semibold text-slate-800 mt-1">
                      Orijinal fabrika camı: Çatlak yok
                    </p>
                    <span class="text-[10px] text-slate-500 mt-1">
                      Optik kırılma ve taş vuruk testi başarıyla geçti.
                    </span>
                  </div>
                </div>
              </div>

              <!-- Drag Instruction Badge -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 pointer-events-none px-3.5 py-1 rounded-full bg-white/90 border border-slate-200 text-xs text-slate-700 flex items-center gap-1.5 backdrop-blur-md shadow-sm">
                <span class="material-symbols-outlined text-sm text-[#1D4ED8] animate-pulse">touch_app</span>
                <span>360° döndürmek için yatayda sürükleyin • Ekspertiz detayı için pinlere (1-3) tıklayın</span>
              </div>
            </div>

            <!-- Interactive Carvana Hotspot Inspection Strip (Click to Inspect) -->
            <div class="relative z-20 px-5 py-2.5 bg-slate-50 border-t border-slate-200 flex flex-col gap-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-[11px] font-extrabold text-slate-700 uppercase tracking-wider flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm text-amber-600">search_check</span>
                  <span>Carvana Şeffaf Ekspertiz & Kusur Pinleri (Tıkla & İncele):</span>
                </span>
                <span id="active-hotspot-status" class="text-[11px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
                  Seçili Pin #1: Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez)
                </span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <button type="button"
                        onclick="selectHotspotInspection(1)"
                        id="hotspot-pill-1"
                        class="hotspot-pill p-2 rounded-xl border border-amber-400 bg-amber-50/70 text-left flex items-start gap-2 cursor-pointer transition">
                  <span class="w-5 h-5 rounded-full bg-amber-500 text-white font-bold text-[11px] flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
                  <div class="min-w-0">
                    <div class="font-bold text-slate-900">Ön Tampon</div>
                    <div class="text-[11px] text-slate-600 leading-snug">Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez)</div>
                  </div>
                </button>

                <button type="button"
                        onclick="selectHotspotInspection(2)"
                        id="hotspot-pill-2"
                        class="hotspot-pill p-2 rounded-xl border border-slate-200 bg-white hover:border-blue-400 text-left flex items-start gap-2 cursor-pointer transition">
                  <span class="w-5 h-5 rounded-full bg-[#1D4ED8] text-white font-bold text-[11px] flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
                  <div class="min-w-0">
                    <div class="font-bold text-slate-900">Jant</div>
                    <div class="text-[11px] text-slate-600 leading-snug">19 inç M-Sport Jant: Çiziksiz, balans hatasız</div>
                  </div>
                </button>

                <button type="button"
                        onclick="selectHotspotInspection(3)"
                        id="hotspot-pill-3"
                        class="hotspot-pill p-2 rounded-xl border border-slate-200 bg-white hover:border-emerald-400 text-left flex items-start gap-2 cursor-pointer transition">
                  <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold text-[11px] flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
                  <div class="min-w-0">
                    <div class="font-bold text-slate-900">Ön Cam</div>
                    <div class="text-[11px] text-slate-600 leading-snug">Orijinal fabrika camı: Çatlak yok</div>
                  </div>
                </button>
              </div>
            </div>

            <!-- Bottom Turntable Scrubber Rail & Player Controls -->
            <div class="relative z-20 w-full px-5 pb-4 pt-2 bg-gradient-to-t from-white via-white/95 to-transparent border-t border-slate-100">
              <div class="flex flex-col gap-2">
                <!-- Scrubber Rail with Notches -->
                <div class="relative flex items-center w-full py-1">
                  <div class="absolute inset-x-0 h-1.5 bg-slate-100 rounded-full overflow-hidden flex justify-between px-1">
                    <div class="w-full flex justify-between opacity-30">
                      <span class="w-0.5 h-full bg-slate-400"></span>
                      <span class="w-0.5 h-full bg-slate-400"></span>
                      <span class="w-0.5 h-full bg-slate-400"></span>
                      <span class="w-0.5 h-full bg-slate-400"></span>
                      <span class="w-0.5 h-full bg-slate-400"></span>
                      <span class="w-0.5 h-full bg-slate-400"></span>
                    </div>
                  </div>
                  <input type="range"
                         min="0"
                         max="<%= [spin_image_urls.size - 1, 0].max %>"
                         value="0"
                         class="w-full h-4 bg-transparent cursor-pointer appearance-none z-10 accent-[#1D4ED8] focus:outline-none"
                         data-vehicle-spin-target="slider"
                         data-action="input->vehicle-spin#onSliderChange" />
                </div>

                <!-- Controls Toolbar -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <button type="button"
                            data-action="click->vehicle-spin#previousFrame"
                            class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer"
                            title="Önceki Kare">
                      <span class="material-symbols-outlined text-base">skip_previous</span>
                    </button>
                    <button type="button"
                            data-action="click->vehicle-spin#toggleAutoSpin"
                            data-vehicle-spin-target="autoPlayBtn"
                            class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#1D4ED8] text-white hover:bg-blue-800 text-xs font-semibold shadow-xs transition cursor-pointer">
                      <span class="material-symbols-outlined text-sm">play_arrow</span>
                      <span>360° Otomatik Döndür</span>
                    </button>
                    <button type="button"
                            data-action="click->vehicle-spin#nextFrame"
                            class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer"
                            title="Sonraki Kare">
                      <span class="material-symbols-outlined text-base">skip_next</span>
                    </button>

                    <span class="text-xs font-mono text-slate-500 ml-2">
                      Kare: <span class="font-bold text-slate-900" data-vehicle-spin-target="currentFrame">1 / <%= spin_image_urls.size %></span>
                    </span>
                  </div>

                  <div class="flex items-center gap-2 text-xs text-slate-500">
                    <span class="hidden sm:inline">D65 Gün Işığı Simülasyonu</span>
                    <button type="button"
                            data-action="click->vehicle-spin#resetSpin"
                            class="p-1 text-slate-400 hover:text-slate-700 transition cursor-pointer"
                            title="Kare 1'e Sıfırla">
                      <span class="material-symbols-outlined text-base">restart_alt</span>
