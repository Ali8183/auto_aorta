<div class="space-y-8">
  <% fallback_src = vehicle_fallback_image(@listing) %>
  <% hero_src = listing_hero_image_url(@listing) %>
  <% brand_gallery = brand_angle_gallery(@listing) %>
  <% v3d = vehicle_3d_config(@listing) %>
  <% spin_image_urls = [
       brand_gallery[:front_three_quarter],
       brand_gallery[:front],
       brand_gallery[:side],
       brand_gallery[:rear_three_quarter],
       brand_gallery[:rear]
     ] %>
  <% spin_angle_labels = [
       "Ön 3/4 (45° Altın Açı)",
       "Ön (90°)",
       "Yan Profil (180°)",
       "Arka 3/4 (225°)",
       "Arka (270°)"
     ] %>
  <% verified_six_angles = [
       { key: "front_three_quarter", label: "Ön 3/4 (45° Altın Açı)", short: "Ön 3/4",   title: "Altın Oran Vitrin", src: brand_gallery[:front_three_quarter], deg: "45°" },
       { key: "front",               label: "Ön (90°)",               short: "Ön",       title: "Ön Izgara & Far",   src: brand_gallery[:front],               deg: "90°" },
       { key: "side",                label: "Yan Profil (180°)",      short: "Yan",      title: "Gövde & Jant",      src: brand_gallery[:side],                deg: "180°" },
       { key: "rear_three_quarter",  label: "Arka 3/4 (225°)",        short: "Arka 3/4", title: "Arka Omuz Çizgisi", src: brand_gallery[:rear_three_quarter],  deg: "225°" },
       { key: "rear",                label: "Arka (270°)",            short: "Arka",     title: "Arka Difüzör",      src: brand_gallery[:rear],                deg: "270°" },
       { key: "interior",            label: "Kokpit (İç Mekan)",      short: "Kokpit",   title: "İç Mekan & Ekran",  src: brand_gallery[:interior],            deg: "360°" }
     ] %>

  <!-- Top Breadcrumb & Studio Command Bar (Stitch Daylight Design) -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <%= link_to "Inventory & Merchandising", root_path, class: "hover:text-[#1D4ED8] transition" %>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-700"><%= @listing.brand %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-800 font-semibold"><%= @listing.model_name %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-mono text-[11px]">
          VIN: <%= @listing.brand[0..2].upcase %><%= @listing.id.to_s.rjust(8, '0') %>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <h1 class="font-headline text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight">
          <%= @listing.title %>
        </h1>

        <!-- Status Badges Row -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Daylight Merchandised
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 text-[#1D4ED8] border border-blue-200 text-xs font-semibold shadow-xs">
            <span class="material-symbols-outlined text-sm">360</span>
            360° Spin Hazır (72 Kare)
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium shadow-xs">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified</span>
            160-Nokta Sertifikalı
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Studio Actions Toolbar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- AI Optimizasyonunu Başlat -->
      <%= button_to optimize_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition cursor-pointer" do %>
        <span class="material-symbols-outlined text-sm text-[#1D4ED8]">sync</span>
        <span>Re-shoot Turntable</span>
      <% end %>

      <!-- Yayına Al -->
      <% unless @listing.published? %>
        <%= button_to publish_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs shadow-sm transition cursor-pointer active:scale-[0.99]" do %>
          <span class="material-symbols-outlined text-sm">rocket_launch</span>
          <span>Publish Live to Portals</span>
        <% end %>
      <% end %>

      <!-- 24 Saat İleri Sar (SLA Testi) -->
      <%= button_to simulate_time_lapse_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-amber-800 border border-slate-200 font-semibold text-xs transition cursor-pointer", title: "24 saat kuralını simüle eder" do %>
        <span class="material-symbols-outlined text-sm text-amber-600">timer</span>
        <span>24h SLA Simüle Et</span>
      <% end %>

      <!-- Sil -->
      <%= button_to listing_path(@listing), method: :delete, data: { turbo_confirm: "Bu aracı filodan silmek istediğinize emin misiniz?" }, class: "p-2 rounded-xl bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 border border-slate-200 transition cursor-pointer", title: "İlanı Sil" do %>
        <span class="material-symbols-outlined text-base">delete</span>
      <% end %>
    </div>
  </div>

  <!-- SLA 24 Saat Bilgilendirme Çubuğu (Daylight) -->
  <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-slate-700 shadow-xs">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-blue-100 text-[#1D4ED8] flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-base">schedule</span>
      </div>
      <div>
        <span class="font-bold text-slate-900">24 Saatlik Otomatik Yayınlama SLA Kuralı:</span>
        <span class="text-slate-600"> AI ile optimize edilen araç fotoğrafları 24 saat içinde onaylanmazsa sistem otomatik olarak vitrine ve syndication kanallarına iletir.</span>
      </div>
    </div>
    <% if @listing.optimized? && @listing.optimized_at.present? %>
      <div class="px-3 py-1 rounded-lg bg-white border border-blue-200 text-[#1D4ED8] font-mono text-xs whitespace-nowrap shadow-xs">
        Kalan Süre: <%= [((@listing.optimized_at + 24.hours - Time.current) / 3600).round(1), 0].max %> saat
      </div>
    <% elsif @listing.published? && @listing.auto_published_at.present? %>
      <div class="px-3 py-1 rounded-lg bg-white border border-emerald-200 text-emerald-700 font-mono text-xs whitespace-nowrap shadow-xs">
        Auto-Published: <%= @listing.auto_published_at.strftime("%d.%m.%Y %H:%M") %> (SLA)
      </div>
    <% end %>
  </div>

  <!-- MAIN STUDIO GRID: 12-Column Responsive Layout (Stitch Daylight) -->
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <!-- SOL 8 KOLON: Central Interactive 360 Studio Turntable Stage & Details -->
    <div class="xl:col-span-8 space-y-6">
      <!-- 1. 360° VİTRİN İÇİN MOD SEÇİCİ (TABS) -->
      <div class="bg-white rounded-2xl border border-slate-200 p-2 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2" role="tablist" aria-label="360 Vitrin Mod Seçici">
        <button type="button"
                id="tab-btn-playcanvas"
                onclick="switchShowroomTab('playcanvas')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-[#1D4ED8] text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition cursor-pointer">
          <span>⚡ PlayCanvas / 3D Gaussian Splatting Canlı Showroom</span>
          <span class="px-1.5 py-0.5 rounded-full bg-white/20 text-[10px] font-mono">.splat WebGL</span>
        </button>

        <button type="button"
                id="tab-btn-photo"
                onclick="switchShowroomTab('photo')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
          <span>📸 360° Doğrulanmış Fotoğraf Turu (2D Stüdyo)</span>
          <span class="px-1.5 py-0.5 rounded-full bg-blue-100 text-[#1D4ED8] text-[10px] font-mono"><%= spin_image_urls.size %> Açı</span>
        </button>

        <button type="button"
                id="tab-btn-guardrail"
                onclick="switchShowroomTab('guardrail')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
          <span>🛡️ Tüketici Güvenliği & Ekspertiz Kilidi</span>
        </button>
      </div>

      <!-- ANA SAHNE (AKTİF): 3D GAUSSIAN SPLATTING / PHOTOGRAMMETRY WEBGL ENGINE -->
      <div id="tab-panel-playcanvas" class="space-y-3">
        <div id="gaussian-splat-container"
             data-splat-url="/vehicles/bmw/vehicle_digital_twin.splat"
             data-photos="<%= verified_six_angles.map { |a| a[:src] }.to_json %>"
             data-labels="<%= verified_six_angles.map { |a| a[:label] }.to_json %>"
             class="w-full h-[580px] rounded-2xl bg-slate-950 border border-slate-700 shadow-2xl relative overflow-hidden select-none cursor-grab active:cursor-grabbing">

          <!-- Üst Kurumsal Rozet: 3D Gaussian Splatting Reconstruction -->
          <div class="absolute top-0 inset-x-0 z-30 px-4 py-3 bg-slate-950/85 backdrop-blur-md border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="text-[11px] sm:text-xs font-extrabold text-white tracking-tight">
                ⚡ 3D GAUSSIAN SPLATTING RECONSTRUCTION - Fotoğraf Piksellerinden Üretilmiş Gerçek 3D Dijital İkiz (Zero-CAD / 100% Real Pixels)
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span id="splat-camera-hud" class="px-2.5 py-1 rounded-lg bg-blue-500/20 text-blue-300 border border-blue-500/30 font-mono text-[11px] font-bold">
                3D Kamera: Ön 3/4 (45° Altın Açı) • Zoom: 1.00x
              </span>
              <button type="button"
                      onclick="resetSplatCamera()"
                      class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-[11px] font-semibold transition cursor-pointer">
                Kamerayı Sıfırla
              </button>
            </div>
          </div>

          <!-- WebGL 3D Gaussian Splatting & Photogrammetry Canvas -->
          <canvas id="gaussian-splat-canvas" class="w-full h-full block"></canvas>

          <!-- 3D Uzay Koordinatlarına Bağlı Carvana Kusur & Ekspertiz Pinleri -->
          <!-- Pin 1 (Ön Tampon - 3D Koordinat: x:-0.42, y:-0.16, z:0.78) -->
          <div id="splat-pin-1"
               data-x="-0.42" data-y="-0.16" data-z="0.78"
               onpointerdown="event.stopPropagation();"
               onclick="event.stopPropagation(); selectHotspotInspection(1);"
               class="hotspot-pin absolute z-30 -translate-x-1/2 -translate-y-1/2 group/pin cursor-pointer transition-transform duration-75"
               style="left: 34%; top: 64%;">
            <div class="relative flex items-center gap-1.5">
              <div class="w-8 h-8 rounded-full bg-amber-500/40 animate-ping absolute -left-0.5"></div>
              <div class="w-7 h-7 rounded-full bg-amber-500 hover:bg-amber-600 text-white flex items-center justify-center shadow-lg border-2 border-white text-xs font-extrabold">
                1
              </div>
              <span class="px-2.5 py-1 rounded-full bg-slate-950/90 text-white text-[11px] font-bold shadow-md border border-amber-400/80 backdrop-blur-md whitespace-nowrap">
                2mm Taş İzi (Boya Gerektirmez)
              </span>
              <div id="hotspot-popover-1" class="hotspot-popover absolute bottom-10 left-0 hidden group-hover/pin:flex flex-col w-72 p-3.5 rounded-xl bg-white/98 backdrop-blur-md shadow-2xl border-2 border-amber-400 z-40">
                <div class="flex items-center justify-between gap-1 text-amber-700 text-[11px] font-extrabold uppercase">
                  <span>Pin 1 • Ön Tampon (3D Koordinat Kilidi)</span>
                  <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[9px]">Şeffaf Kayıt</span>
                </div>
                <p class="text-xs font-bold text-slate-900 mt-1">
                  Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez)
                </p>
                <span class="text-[10px] text-emerald-700 font-semibold mt-1">
                  ✓ 3D Gaussian Splatting bu kusuru silmez, gerçek piksel %100 korunur.
                </span>
              </div>
            </div>
          </div>

          <!-- Pin 2 (Jant - 3D Koordinat: x:0.18, y:-0.24, z:0.72) -->
          <div id="splat-pin-2"
               data-x="0.18" data-y="-0.24" data-z="0.72"
               onpointerdown="event.stopPropagation();"
               onclick="event.stopPropagation(); selectHotspotInspection(2);"
               class="hotspot-pin absolute z-30 -translate-x-1/2 -translate-y-1/2 group/pin cursor-pointer transition-transform duration-75"
               style="left: 56%; top: 68%;">
            <div class="relative flex items-center gap-1.5">
              <div class="w-8 h-8 rounded-full bg-blue-500/35 animate-ping absolute -left-0.5"></div>
              <div class="w-7 h-7 rounded-full bg-[#1D4ED8] hover:bg-blue-800 text-white flex items-center justify-center shadow-lg border-2 border-white text-xs font-extrabold">
                2
              </div>
              <span class="px-2.5 py-1 rounded-full bg-slate-950/90 text-white text-[11px] font-bold shadow-md border border-blue-400/80 backdrop-blur-md whitespace-nowrap">
                19 inç M-Sport Jant (Hatasız)
              </span>
              <div id="hotspot-popover-2" class="hotspot-popover absolute bottom-10 -left-24 hidden group-hover/pin:flex flex-col w-72 p-3.5 rounded-xl bg-white/98 backdrop-blur-md shadow-2xl border-2 border-blue-500 z-40">
                <div class="flex items-center justify-between gap-1 text-[#1D4ED8] text-[11px] font-extrabold uppercase">
                  <span>Pin 2 • Jant Kondisyonu (3D Koordinat Kilidi)</span>
                  <span class="px-1.5 py-0.5 rounded bg-blue-50 text-[#1D4ED8] text-[9px]">Kusursuz</span>
                </div>
                <p class="text-xs font-bold text-slate-900 mt-1">
                  19 inç M-Sport Jant: Çiziksiz, balans hatasız
                </p>
                <span class="text-[10px] text-slate-500 mt-1">
                  Lazer salgı ve kaldırım sürtmesi kontrolü: 0 hata.
                </span>
              </div>
            </div>
          </div>

          <!-- Pin 3 (Ön Cam - 3D Koordinat: x:-0.05, y:0.26, z:0.42) -->
          <div id="splat-pin-3"
               data-x="-0.05" data-y="0.26" data-z="0.42"
               onpointerdown="event.stopPropagation();"
               onclick="event.stopPropagation(); selectHotspotInspection(3);"
               class="hotspot-pin absolute z-30 -translate-x-1/2 -translate-y-1/2 group/pin cursor-pointer transition-transform duration-75"
               style="left: 48%; top: 38%;">
            <div class="relative flex items-center gap-1.5">
              <div class="w-8 h-8 rounded-full bg-emerald-500/35 animate-ping absolute -left-0.5"></div>
              <div class="w-7 h-7 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center shadow-lg border-2 border-white text-xs font-extrabold">
                3
              </div>
              <span class="px-2.5 py-1 rounded-full bg-slate-950/90 text-white text-[11px] font-bold shadow-md border border-emerald-400/80 backdrop-blur-md whitespace-nowrap">
                Orijinal Fabrika Camı
              </span>
              <div id="hotspot-popover-3" class="hotspot-popover absolute bottom-10 -left-20 hidden group-hover/pin:flex flex-col w-72 p-3.5 rounded-xl bg-white/98 backdrop-blur-md shadow-2xl border-2 border-emerald-500 z-40">
                <div class="flex items-center justify-between gap-1 text-emerald-700 text-[11px] font-extrabold uppercase">
                  <span>Pin 3 • Ön Cam (3D Koordinat Kilidi)</span>
                  <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 text-[9px]">OEM Onaylı</span>
                </div>
                <p class="text-xs font-bold text-slate-900 mt-1">
                  Orijinal fabrika camı: Çatlak yok
                </p>
                <span class="text-[10px] text-slate-500 mt-1">
                  Optik kırılma ve taş vuruk testi başarıyla geçti.
                </span>
              </div>
            </div>
          </div>

          <!-- Alt Orbit Kontrol Rehberi -->
          <div class="absolute bottom-3 inset-x-4 z-30 flex flex-wrap items-center justify-between gap-2 px-4 py-2 rounded-xl bg-slate-950/85 backdrop-blur-md border border-slate-800 text-[11px] text-slate-300 pointer-events-none">
            <div class="flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-1 text-emerald-400 font-mono font-bold">
                <span class="material-symbols-outlined text-sm">3d_rotation</span>
                <span>Orbit Controls:</span>
              </span>
              <span><strong>Sol Tık:</strong> 360° Serbest Döndürme</span>
              <span>•</span>
              <span><strong>Sağ Tık:</strong> Kaydırma (Pan)</span>
              <span>•</span>
              <span><strong>Tekerlek:</strong> Yakınlaşma / Uzaklaşma</span>
            </div>
            <span class="font-mono text-blue-400 font-semibold">
              Bizzat Aynı Araç: <%= @listing.color %> • 24,000 Gerçek Piksel Splat
            </span>
          </div>
        </div>

        <!-- ŞEFFAF CARVANA EKSPERTİZ KARTI (3D Pinlere Tıklandığında Güncellenir) -->
        <div id="carvana-inspection-card" class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col gap-2.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base text-amber-600">verified</span>
              <span>3D Uzay Koordinatlarına Bağlı Carvana Ekspertiz Pinleri:</span>
            </span>
            <span id="active-hotspot-status" class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-300 px-3 py-1 rounded-full shadow-2xs">
              Pin #1 (Ön Tampon): 2mm Taş İzi (Boya Gerektirmez) — Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez)
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
            <button type="button"
                    onclick="selectHotspotInspection(1)"
                    id="hotspot-pill-1"
                    class="hotspot-pill p-2.5 rounded-xl border-2 border-[#1D4ED8] bg-blue-50/60 text-left flex items-start gap-2.5 cursor-pointer transition shadow-xs">
              <span class="w-6 h-6 rounded-full bg-amber-500 text-white font-extrabold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
              <div class="min-w-0">
                <div class="font-extrabold text-slate-900">2mm Taş İzi (Boya Gerektirmez)</div>
                <div class="text-[11px] text-slate-600 leading-snug">Ön Tampon • Kozmetik Durum: 2mm yüzeysel taş izi (Boya gerektirmez)</div>
              </div>
            </button>

            <button type="button"
                    onclick="selectHotspotInspection(2)"
                    id="hotspot-pill-2"
                    class="hotspot-pill p-2.5 rounded-xl border border-slate-200 bg-white hover:border-blue-400 text-left flex items-start gap-2.5 cursor-pointer transition">
              <span class="w-6 h-6 rounded-full bg-[#1D4ED8] text-white font-extrabold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
              <div class="min-w-0">
                <div class="font-extrabold text-slate-900">19 inç M-Sport Jant (Hatasız)</div>
                <div class="text-[11px] text-slate-600 leading-snug">Jant • 19 inç M-Sport Jant: Çiziksiz, balans hatasız</div>
              </div>
            </button>

            <button type="button"
                    onclick="selectHotspotInspection(3)"
                    id="hotspot-pill-3"
                    class="hotspot-pill p-2.5 rounded-xl border border-slate-200 bg-white hover:border-emerald-400 text-left flex items-start gap-2.5 cursor-pointer transition">
              <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-extrabold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
              <div class="min-w-0">
                <div class="font-extrabold text-slate-900">Orijinal Fabrika Camı</div>
                <div class="text-[11px] text-slate-600 leading-snug">Ön Cam • Orijinal fabrika camı: Çatlak yok</div>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- SEKME 2: 2D FOTOĞRAFİK DÖNER VİTRİN -->
      <div id="tab-panel-photo" class="hidden bg-white rounded-2xl border border-slate-200 shadow-lg overflow-hidden select-none relative group flex flex-col justify-between">
        <div id="turntable-container" class="relative flex flex-col justify-between w-full bg-gradient-to-b from-slate-100 via-slate-50 to-white">
          <div data-controller="vehicle-spin"
               data-vehicle-spin-images-value="<%= spin_image_urls.to_json %>"
               data-vehicle-spin-angles-value="<%= spin_angle_labels.to_json %>"
               data-vehicle-spin-current-index-value="0"
               class="flex flex-col w-full">

            <div class="relative z-20 w-full px-5 py-3.5 bg-white/90 backdrop-blur-md border-b border-slate-200/80 flex flex-wrap items-center justify-between gap-2 pointer-events-auto">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 text-white font-mono text-xs font-bold tracking-tight shadow-xs">
                  <span class="w-2.5 h-2.5 rounded-full border border-white/40" style="background-color: <%= v3d[:hex] %>;"></span>
                  <span><%= @listing.color %></span>
                </span>
                <span id="turntable-angle-badge"
                      class="px-3 py-1 rounded-full bg-blue-50 text-[#1D4ED8] font-mono text-xs font-extrabold shadow-xs border border-blue-200"
                      data-vehicle-spin-target="angleLabel">
                  <%= spin_angle_labels.first %>
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        onclick="switchShowroomTab('playcanvas')"
                        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white text-xs font-bold shadow-sm transition cursor-pointer">
                  <span>⚡ 3D Gaussian Splatting Sahnesine Dön</span>
                </button>
              </div>
            </div>

            <div id="turntable-drag-stage"
                 class="relative z-10 w-full h-[540px] flex items-center justify-center cursor-grab active:cursor-grabbing px-4 sm:px-8 overflow-hidden bg-gradient-to-b from-slate-100/80 via-white to-slate-100/90"
                 data-vehicle-spin-target="spinContainer"
                 data-action="pointerdown->vehicle-spin#onPointerDown">

              <img id="turntable-main-image"
                   data-vehicle-spin-target="image"
                   src="<%= spin_image_urls.first || fallback_src %>"
                   alt="<%= @listing.title %>"
                   class="w-full h-[540px] object-contain pointer-events-none select-none transition-transform duration-75"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
            </div>

            <div class="relative z-20 w-full px-5 pb-4 pt-2.5 bg-slate-50 border-t border-slate-200">
              <div class="flex flex-col gap-2">
                <div class="relative flex items-center w-full py-1">
                  <input id="turntable-angle-slider"
                         type="range"
                         min="0"
                         max="<%= [spin_image_urls.size - 1, 0].max %>"
                         value="0"
                         oninput="syncTurntableByIndex(parseInt(this.value, 10))"
                         class="w-full h-4 bg-transparent cursor-pointer appearance-none z-10 accent-[#1D4ED8] focus:outline-none"
                         data-vehicle-spin-target="slider"
                         data-action="input->vehicle-spin#onSliderChange" />
                </div>

                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <button type="button"
                            onclick="stepTurntableAngle(-1)"
                            data-action="click->vehicle-spin#previousFrame"
                            class="p-1.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition cursor-pointer">
                      <span class="material-symbols-outlined text-base">skip_previous</span>
                    </button>
                    <button type="button"
                            data-action="click->vehicle-spin#toggleAutoSpin"
                            data-vehicle-spin-target="autoPlayBtn"
                            class="flex items-center gap-1 px-3.5 py-1.5 rounded-lg bg-[#1D4ED8] text-white hover:bg-blue-800 text-xs font-bold shadow-xs transition cursor-pointer">
                      <span class="material-symbols-outlined text-sm">play_arrow</span>
                      <span>360° Otomatik Döndür</span>
                    </button>
                    <button type="button"
                            onclick="stepTurntableAngle(1)"
                            data-action="click->vehicle-spin#nextFrame"
                            class="p-1.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition cursor-pointer">
                      <span class="material-symbols-outlined text-base">skip_next</span>
                    </button>
                    <span class="text-xs font-mono text-slate-600 ml-2">
                      Açı Kare: <span id="turntable-frame-counter" class="font-bold text-slate-900" data-vehicle-spin-target="currentFrame">1 / <%= spin_image_urls.size %></span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3 PANEL: TÜKETİCİ GÜVENLİĞİ & EKSPERTİZ KİLİDİ -->
      <div id="tab-panel-guardrail" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5">
        <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-2xl">verified_user</span>
            </div>
            <div>
              <h3 class="font-headline text-base font-extrabold text-slate-900">
                🛡️ Tüketici Güvenliği & Eksik Fotoğraf Emniyet Kilidi
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                İkinci el otomotiv ticaretinde üretken yapay zekâ halüsinasyonlarını engelleyen etik koruma protokolü.
              </p>
            </div>
          </div>
          <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold whitespace-nowrap">
            SHA-256 Piksel Kilidi Aktif
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-rose-50/60 border border-rose-200 space-y-2">
            <div class="font-extrabold text-rose-800 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">block</span>
              <span>Neden Üretken 3D Halüsinasyon Yasaktır?</span>
            </div>
            <p class="text-slate-600 leading-relaxed">
              Eksik açılardan aracın görünmeyen yanını veya arka tamponunu yapay zekâ ile "tahmin ederek" sahte model üretmek, gerçek araçtaki <strong>göçükleri, taş izlerini ve boya kusurlarını gizler</strong>.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-emerald-50/60 border border-emerald-200 space-y-2">
            <div class="font-extrabold text-emerald-800 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">check_circle</span>
              <span>AutoAorta AI Sıfır-Halüsinasyon Standardı</span>
            </div>
            <p class="text-slate-600 leading-relaxed">
              AutoAorta AI yalnızca <strong>gerçek kamera sensöründen gelen doğrulanmış pikselleri</strong> 3D Gaussian Splatting uzayına taşır ve Carvana standardında kozmetik kusurları (ör. 2mm taş izi) 3D koordinatlara kilitli şeffaf pinlerle gösterir.
            </p>
          </div>
        </div>
      </div>

      <!-- BİZZAT AYNI ARACA AİT 6 DOĞRULANMIŞ AÇI SEÇİCİ (Tıklandığında 3D Kamera Tween/Lerp İle Odaklanır) -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#1D4ED8] text-lg">360</span>
            <span class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">
              Bizzat Aynı Araca Ait 6 Doğrulanmış Açı (Tıkla & 3D Gaussian Splatting Kamerasını Odakla)
            </span>
          </div>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
            1:1 Renk & Model Uyumu: <%= @listing.color %>
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5">
          <% verified_six_angles.each_with_index do |ang, idx| %>
            <button type="button"
                    id="sync-angle-btn-<%= idx %>"
                    onclick="syncVehicleAngle(<%= idx %>, '<%= ang[:label] %>', '<%= ang[:src] %>')"
                    class="sync-angle-btn flex flex-col gap-1 p-1.5 rounded-xl bg-white border-2 <%= idx == 0 ? 'border-[#1D4ED8] ring-2 ring-blue-500/20' : 'border-slate-200 hover:border-[#1D4ED8]' %> shadow-xs transition text-left cursor-pointer group">
              <div class="relative w-full aspect-[16/10] rounded-lg overflow-hidden bg-slate-100">
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                     src="<%= ang[:src] %>"
                     alt="<%= ang[:label] %>"
                     onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                     onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
                <span class="absolute bottom-1 left-1 px-1.5 py-0.2 rounded bg-slate-900/85 text-white font-mono text-[9px] font-bold">
                  <%= ang[:short] %>
                </span>
              </div>
              <div class="flex items-center justify-between px-0.5">
                <span class="text-[10px] font-bold text-slate-800 group-hover:text-[#1D4ED8] truncate"><%= ang[:title] %></span>
                <span class="text-[9px] font-mono text-slate-500 font-semibold"><%= ang[:deg] %></span>
              </div>
            </button>
          <% end %>
        </div>

        <!-- 3D GAUSSIAN SPLATTING & AI ARAÇ TUTARLILIK DOĞRULAYICISI ROZETLERİ -->
        <div class="p-3 rounded-xl bg-emerald-50/80 border border-emerald-200 flex items-start sm:items-center gap-2.5 text-xs text-slate-900">
          <span class="material-symbols-outlined text-emerald-600 text-lg flex-shrink-0">view_in_ar</span>
          <span class="font-bold">
            ⚡ 3D GAUSSIAN SPLATTING RECONSTRUCTION - Fotoğraf Piksellerinden Üretilmiş Gerçek 3D Dijital İkiz (Zero-CAD / 100% Real Pixels)
          </span>
        </div>

        <div class="p-3 rounded-xl bg-blue-50/70 border border-blue-200 flex items-start sm:items-center gap-2.5 text-xs text-slate-800">
          <span class="material-symbols-outlined text-[#1D4ED8] text-lg flex-shrink-0">fact_check</span>
          <span class="font-semibold">
            ✓ AI Bütünlük Kontrolü: 6 görselin tamamı aynı gövde rengine (<%= @listing.color %>) ve M-Sport paketine ait olarak doğrulandı. Farklı araç anomalisi yok.
          </span>
        </div>
      </div>

      <!-- 4. EKSİK FOTOĞRAF EMNİYET KİLİDİ (ANTİ-HALÜSİNASYON BANNERI) -->
      <div class="rounded-2xl border-2 border-emerald-500/40 bg-gradient-to-r from-emerald-50 via-white to-blue-50 p-4 shadow-sm flex items-start sm:items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center flex-shrink-0 shadow-xs">
          <span class="material-symbols-outlined text-xl">shield_lock</span>
        </div>
        <div class="space-y-0.5 text-xs leading-relaxed">
          <p class="font-bold text-slate-900">
            ✓ Sıfır Halüsinasyon Güvencesi: AutoAorta AI, eksik fotoğraflardan göçük/çizik silen üretken yapay zekâ tahminleri UYDURMAZ. Fotoğraflanmayan açılar gizlenmez, gerçek ekspertiz pikselleri %100 korunur.
          </p>
          <p class="text-[11px] text-slate-500">
            Carvana & Impel.io Dürüst Otomotiv Perakendeciliği Standardı • Kamera Orijinallik İmzası Doğrulandı
          </p>
        </div>
      </div>

      <!-- BEFORE vs AFTER: Vitrin Karşılaştırma Kartı (Impel.io & Carvana Standardı) -->
      <div id="before-after-analytics" class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm scroll-mt-24">
        <div class="px-5 py-3.5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-blue-100 text-[#1D4ED8] flex items-center justify-center">
              <span class="material-symbols-outlined text-base">compare_arrows</span>
            </div>
            <div>
              <h2 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">Önce / Sonra (Before vs After) Vitrin Karşılaştırması</h2>
              <p class="text-[11px] text-slate-500">Geleneksel galeri çekimi ile AutoAorta AI Hero Shot vitrin performans analizi</p>
            </div>
          </div>
          <span class="hidden sm:inline-flex px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
            🔥 CTR Artışı: +%170
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200">
          <!-- SOL: Geleneksel Galeri İlanı -->
          <div class="p-5 space-y-3 bg-slate-50/50">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-xs font-bold">
                <span>❌ Geleneksel Galeri İlanı</span>
              </span>
              <span class="text-[11px] text-slate-400">Standart Çekim</span>
            </div>

            <div class="relative aspect-video rounded-xl overflow-hidden bg-slate-200 border border-slate-200">
              <img class="w-full h-full object-cover filter brightness-90 contrast-90"
                   src="<%= spin_image_urls.last || brand_gallery[:rear] || fallback_src %>"
                   alt="Geleneksel Yan Açı"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
              <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-slate-900/80 text-[10px] text-slate-200">
                ⚠️ Düşük Vitrin Çekiciliği
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-1 text-center">
              <div class="p-2 rounded-lg bg-white border border-slate-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Tıklanma (CTR)</div>
                <div class="text-base font-extrabold text-slate-800 mt-0.5">%1.4</div>
                <div class="text-[10px] text-rose-600 font-medium">Sektör Altı</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-slate-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Vitrin Puanı</div>
                <div class="text-base font-extrabold text-slate-800 mt-0.5">42/100</div>
                <div class="text-[10px] text-slate-400">Optimizasyonsuz</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-slate-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Satış Süresi</div>
                <div class="text-base font-extrabold text-slate-800 mt-0.5">38 Gün</div>
                <div class="text-[10px] text-slate-400">Ortalama Stok</div>
              </div>
            </div>
          </div>

          <!-- SAĞ: AutoAorta AI Optimize İlan -->
          <div class="p-5 space-y-3 bg-blue-50/20">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
                <span>⭐ AutoAorta AI Optimize Vitrin</span>
              </span>
              <span class="text-xs text-[#1D4ED8] font-semibold">Impel.io Standardı</span>
            </div>

            <div class="relative aspect-video rounded-xl overflow-hidden bg-white border-2 border-blue-500 shadow-md">
              <img class="w-full h-full object-cover"
                   src="<%= hero_src %>"
                   alt="AutoAorta Hero Shot"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
              <div class="absolute top-2 right-2 px-2 py-0.5 rounded bg-[#1D4ED8] text-white text-[11px] font-bold shadow-xs">
                ⭐ 45° Hero Vitrin
              </div>
              <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-white/95 text-[10px] text-[#1D4ED8] font-semibold border border-blue-200">
                ✓ 360° Döner Sekans Aktif
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-1 text-center">
              <div class="p-2 rounded-lg bg-white border border-blue-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Tıklanma (CTR)</div>
                <div class="text-base font-extrabold text-emerald-600 mt-0.5">%3.8</div>
                <div class="text-[10px] text-emerald-700 font-bold">+%170 Artış</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-blue-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Vitrin Puanı</div>
                <div class="text-base font-extrabold text-[#1D4ED8] mt-0.5"><%= @hero_analysis&.quality_score || 98 %>/100</div>
                <div class="text-[10px] text-blue-700 font-medium">Stüdyo Simetrisi</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-blue-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Satış Süresi</div>
                <div class="text-base font-extrabold text-emerald-600 mt-0.5">27 Gün</div>
                <div class="text-[10px] text-emerald-700 font-bold">-11 Gün Hızlı</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SAĞ 4 KOLON: Merchandising Valuation, Specs, Deal & Embed (Col 9-12) -->
    <div class="xl:col-span-4 space-y-6">
      <!-- Pricing & Acquisition Card -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-5">
        <div class="flex items-baseline justify-between">
          <div class="space-y-0.5">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">İlan Satış Fiyatı</span>
            <div class="font-headline text-3xl font-black text-slate-900 tracking-tight">
              <%= number_to_currency(@listing.price, unit: "₺", precision: 0, format: "%n %u") %>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-emerald-600 block">Stokta Hazır</span>
            <span class="text-xs text-slate-500">Krediye Uygun</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200">
          <span class="material-symbols-outlined text-emerald-600 text-xl">monetization_on</span>
          <div class="flex flex-col text-left">
            <span class="text-xs font-semibold text-slate-800">Dealer Price Protection Güvencesi</span>
            <span class="text-[11px] text-slate-500">Piyasa emsallerine göre rekabetçi fiyatlandırma.</span>
          </div>
        </div>

        <!-- Deal Action Buttons -->
        <div class="space-y-2.5">
          <a href="https://wa.me/<%= @listing.dealer_phone.to_s.gsub(/[^0-9]/, '') %>?text=Merhaba,%20<%= ERB::Util.url_encode(@listing.title) %>%20hakkında%20bilgi%20almak%20istiyorum."
             target="_blank"
             class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition active:scale-[0.99]">
            <span class="material-symbols-outlined text-base">chat</span>
            <span>WhatsApp ile Müşteri Teklifi Başlat</span>
          </a>

          <a href="tel:<%= @listing.dealer_phone %>"
             class="w-full py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center gap-2 border border-slate-200 transition">
            <span class="material-symbols-outlined text-base text-[#1D4ED8]">call</span>
            <span>Yetkiliyi Ara: <%= @listing.dealer_phone %></span>
          </a>
        </div>
      </div>

      <!-- Studio Merchandising Quality Index (MQI) Card with Circular Gauge -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#1D4ED8] text-xl">auto_awesome</span>
            <span class="font-headline text-sm font-bold text-slate-900">Studio Merchandising Index</span>
          </div>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
            Tier 1 Elite
          </span>
        </div>

        <div class="flex items-center gap-4">
          <!-- Inline Circular SVG Gauge -->
          <div class="relative w-20 h-20 flex-shrink-0 flex items-center justify-center">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36">
              <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3.5"></path>
              <path class="text-emerald-500" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="98, 100" stroke-linecap="round" stroke-width="3.5"></path>
            </svg>
            <div class="absolute flex flex-col items-center leading-none">
              <span class="font-headline text-lg font-bold text-slate-900">98</span>
              <span class="text-[9px] text-slate-400 font-semibold uppercase">/ 100</span>
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <span class="font-headline text-sm font-bold text-slate-900">+%170 CTR vs Sektör</span>
            <p class="text-xs text-slate-500 leading-snug">72-kare döner tabla çekimi ve D65 renk standardı alıcı oturum süresini 2.4 kat uzatır.</p>
          </div>
        </div>

        <!-- Quality Parameter Rows -->
        <div class="space-y-2 pt-2 border-t border-slate-100 text-xs">
          <div>
            <div class="flex items-center justify-between text-slate-600 font-medium mb-1">
              <span>Aydınlatma Standardı (D65 CIE ISO)</span>
              <span class="text-emerald-600 font-semibold">100% Kalibre</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 100%"></div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-slate-600 font-medium mb-1">
              <span>Hotspot Açıklama Kapsamı</span>
              <span class="text-emerald-600 font-semibold">4 / 4 Tamamlandı</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 100%"></div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-slate-600 font-medium mb-1">
              <span>Turntable Kare Titreme Payı</span>
              <span class="text-emerald-600 font-semibold">0.0% (Sıfır Titreme)</span>
