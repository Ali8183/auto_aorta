<div class="space-y-8"
     data-controller="vehicle-360"
     data-vehicle-360-images-value="<%= safe_spin_image_urls(@listing, @spin_photos).to_json %>"
     data-vehicle-360-defects-value="<%= @listing.defects.map { |d| { id: d.id, part_name: d.part_name, title: d.title, micron_value: d.micron_value, defect_type: d.defect_type, description: d.description, position_x: d.position_x, position_y: d.position_y, frame_index: d.frame_index, severity: d.severity } }.to_json %>">

  <% fallback_src = vehicle_fallback_image(@listing) %>
  <% hero_src = listing_hero_image_url(@listing) %>
  <% brand_gallery = brand_angle_gallery(@listing) %>
  <% v3d = vehicle_3d_config(@listing) %>
  <% spin_image_urls = safe_spin_image_urls(@listing, @spin_photos) %>
  <% spin_angle_labels = [
       "Ön 3/4 (45° Altın Açı)",
       "Ön (90°)",
       "Yan Profil (180°)",
       "Arka 3/4 (225°)",
       "Arka (270°)"
     ] %>
  <% verified_six_angles = [
       { key: "front_three_quarter", label: "Ön 3/4 (45° Altın Açı)", short: "Ön 3/4",   title: "Ön 3/4 Görünüm",  src: brand_gallery[:front_three_quarter], deg: "45°" },
       { key: "front",               label: "Ön (90°)",               short: "Ön",       title: "Ön Izgara & Far",  src: brand_gallery[:front],               deg: "90°" },
       { key: "side",                label: "Yan Profil (180°)",      short: "Yan",      title: "Gövde Profili",    src: brand_gallery[:side],                deg: "180°" },
       { key: "rear_three_quarter",  label: "Arka 3/4 (225°)",        short: "Arka 3/4", title: "Arka 3/4 Omuz",    src: brand_gallery[:rear_three_quarter],  deg: "225°" },
       { key: "rear",                label: "Arka (270°)",            short: "Arka",     title: "Arka Difüzör",     src: brand_gallery[:rear],                deg: "270°" },
       { key: "interior",            label: "Kokpit (İç Mekan)",      short: "Kokpit",   title: "Kokpit & Yaşam",   src: brand_gallery[:interior],            deg: "360°" }
     ] %>
  <% monthly_loan_estimate = ((@listing.price.to_f * 0.70) / 36).round %>
  <% vin_code = "#{@listing.brand[0..2].upcase}#{@listing.id.to_s.rjust(8, '0')}" %>

  <!-- Top Breadcrumb & Clean Header -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800/80">
    <div class="space-y-1.5">
      <!-- Minimalist Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-slate-400 font-medium">
        <%= link_to "Araç Filosu", root_path, class: "hover:text-blue-400 transition" %>
        <span class="text-slate-600">/</span>
        <span class="text-slate-300"><%= @listing.brand %></span>
        <span class="text-slate-600">/</span>
        <span class="text-white font-semibold"><%= @listing.model_name %></span>
        <span class="text-slate-600">/</span>
        <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300 font-mono text-[11px]">
          VIN: <%= vin_code %>
        </span>
      </div>

      <!-- Vehicle Title & Status -->
      <div class="flex flex-wrap items-center gap-3 pt-0.5">
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          <%= @listing.title %>
        </h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span><%= @listing.expertise.presence || "Hatasız / Boyasız" %></span>
        </span>
      </div>
    </div>

    <!-- Quick Action Bar -->
    <div class="flex items-center gap-2">
      <%= link_to capture_listing_path(@listing), class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-200 text-xs font-medium transition cursor-pointer" do %>
        <span class="material-symbols-outlined text-sm text-blue-400">videocam</span>
        <span>108 Kare Çekim</span>
      <% end %>

      <%= link_to embed_listing_url(@listing), target: "_blank", class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-200 text-xs font-medium transition cursor-pointer" do %>
        <span class="material-symbols-outlined text-sm text-slate-400">share</span>
        <span>Paylaş</span>
      <% end %>

      <%= button_to listing_path(@listing), method: :delete, data: { turbo_confirm: "Bu ilanı silmek istediğinize emin misiniz?" }, class: "p-2 rounded-xl bg-slate-900 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-800 transition cursor-pointer", title: "İlanı Sil" do %>
        <span class="material-symbols-outlined text-base">delete</span>
      <% end %>
    </div>
  </div>

  <!-- MAIN SHOWROOM GRID: 12 Columns -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- SOL 8 KOLON: Studio 360 / 3D Stage -->
    <div class="lg:col-span-8 space-y-4">
      <!-- Tab Controls (Tesla / Polestar Studio) -->
      <div class="flex items-center gap-2 bg-slate-900/60 p-1.5 rounded-2xl border border-slate-800/80 backdrop-blur-md">
        <% if @listing.has_splat? %>
          <button type="button"
                  id="tab-btn-splat"
                  onclick="switchShowroomTab('splat')"
                  class="showroom-tab-btn flex-1 py-2 px-3.5 rounded-xl bg-blue-600 text-white font-semibold text-xs flex items-center justify-center gap-1.5 shadow-sm transition cursor-pointer">
            <span class="material-symbols-outlined text-sm">view_in_ar</span>
            <span>3D Gaussian Splatting</span>
          </button>
        <% end %>

        <button type="button"
                id="tab-btn-photo"
                onclick="switchShowroomTab('photo')"
                class="showroom-tab-btn flex-1 py-2 px-3.5 rounded-xl <%= @listing.has_splat? ? 'text-slate-400 hover:text-white hover:bg-slate-800/60' : 'bg-slate-800 text-white font-bold' %> text-xs flex items-center justify-center gap-1.5 transition cursor-pointer">
          <span class="material-symbols-outlined text-sm text-blue-400">360</span>
          <span>360° Doğrulanmış Fotoğraf Turu</span>
          <span class="px-1.5 py-0.2 rounded bg-slate-700/60 text-slate-300 text-[10px] font-mono"><%= spin_image_urls.size %> Açı</span>
        </button>

        <button type="button"
                id="tab-btn-guardrail"
                onclick="switchShowroomTab('guardrail')"
                class="showroom-tab-btn flex-1 py-2 px-3.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/60 text-xs flex items-center justify-center gap-1.5 transition cursor-pointer">
          <span class="material-symbols-outlined text-sm text-emerald-400">verified_user</span>
          <span>Tüketici Güvenliği & Ekspertiz Kilidi</span>
        </button>
      </div>

      <% if @listing.has_splat? %>
        <!-- 3D GAUSSIAN SPLATTING CONTAINER -->
        <div id="tab-panel-splat" class="bg-slate-950 rounded-2xl border border-slate-850/80 shadow-2xl overflow-hidden relative">
          <div class="px-4 py-2.5 bg-slate-900/80 border-b border-slate-850 flex items-center justify-between text-xs text-slate-400">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <strong class="text-white"><%= @listing.title %></strong>
              <span class="text-slate-500">• 3D Gaussian Splatting WebGL</span>
            </span>
            <span class="font-mono text-[11px] text-slate-400">Sol Tık: Döndür • Tekerlek: Zum</span>
          </div>

          <div id="splat-viewer-container"
               data-splat-url="<%= @listing.splat_url %>"
               class="w-full h-[520px] relative bg-slate-950 cursor-grab active:cursor-grabbing select-none overflow-hidden">
            <div id="showroom-splat-loading-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 z-20 text-white text-xs gap-2">
              <div class="w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
              <span class="font-mono text-slate-400">GaussianSplats3D Yükleniyor...</span>
            </div>
          </div>
        </div>
      <% end %>

      <!-- 360° FOTOĞRAF SAHNESİ & KUSUR HOTSPOTS -->
      <div id="tab-panel-photo" class="<%= @listing.has_splat? ? 'hidden ' : '' %>bg-slate-950 rounded-2xl border border-slate-800/80 shadow-2xl overflow-hidden relative flex flex-col justify-between">
        <!-- Stage Header Subbar -->
        <div class="px-4 py-2.5 bg-slate-900/60 border-b border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-200 font-mono text-[11px]"><%= @listing.color %></span>
            <span id="photo-gallery-badge" class="text-slate-300 font-medium"><%= spin_angle_labels.first %></span>
          </div>
          <span class="flex items-center gap-1.5 text-emerald-400 text-[11px] font-medium">
            <span class="material-symbols-outlined text-xs">verified</span>
            <span>Doğrulanmış Stüdyo Çekimi</span>
          </span>
        </div>

        <!-- Main Interactive 360 Area (Cloudimage 360 & Stimulus Controller) -->
        <div class="relative w-full h-[500px] flex items-center justify-center bg-gradient-to-b from-slate-950 via-slate-900/40 to-slate-950 p-4">
          <!-- Cloudimage 360 Target Container -->
          <div data-vehicle-360-target="container"
               class="w-full h-full flex items-center justify-center relative select-none">
            <img id="photo-gallery-main-image"
                 src="<%= spin_image_urls.first || fallback_src %>"
                 alt="<%= @listing.title %>"
                 class="max-h-full max-w-full object-contain pointer-events-none transition-opacity duration-100"
                 onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                 onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
          </div>

          <!-- Pulsing Defect Pin Overlays (When available) -->
          <% @listing.defects.each_with_index do |defect, d_idx| %>
            <button type="button"
                    onclick="window.openDefectModalFromPin(<%= defect.id %>)"
                    style="left: <%= defect.position_x || 50 %>%; top: <%= defect.position_y || 50 %>%;"
                    class="absolute z-20 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center group cursor-pointer"
                    title="<%= defect.title %>">
              <span class="w-6 h-6 rounded-full bg-amber-500/30 animate-ping absolute"></span>
              <span class="w-4 h-4 rounded-full bg-amber-500 border border-white text-[9px] font-bold text-slate-950 flex items-center justify-center shadow-lg group-hover:scale-125 transition">
                !
              </span>
              <span class="hidden group-hover:block absolute left-6 top-1/2 -translate-y-1/2 bg-slate-900 text-white text-[10px] font-medium px-2 py-1 rounded shadow-xl whitespace-nowrap border border-slate-700">
                <%= defect.part_name %>: <%= defect.micron_value %>µm (<%= defect.defect_type %>)
              </span>
            </button>
          <% end %>

          <!-- Subtle Drag-to-spin hint pill -->
          <div class="absolute bottom-3 left-1/2 -translate-x-1/2 pointer-events-none px-3 py-1 rounded-full bg-slate-900/80 border border-slate-800 text-[11px] text-slate-400 flex items-center gap-1.5 backdrop-blur-sm shadow-lg">
            <span class="material-symbols-outlined text-xs text-blue-400">sync</span>
            <span>360° döndürmek için kaydırın</span>
          </div>
        </div>

        <!-- 6 Angle Fast Selector Dock -->
        <div class="px-4 py-3 bg-slate-900/60 border-t border-slate-800/80 flex items-center justify-between gap-2 overflow-x-auto">
          <div class="flex items-center gap-2">
            <% verified_six_angles.each_with_index do |ang, idx| %>
              <button type="button"
                      id="sync-angle-btn-<%= idx %>"
                      onclick="selectPhotoGalleryAngle(<%= idx %>, '<%= ang[:label] %>', '<%= ang[:src] %>')"
                      class="sync-angle-btn flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-900/80 border <%= idx == 0 ? 'border-blue-500 text-white' : 'border-slate-800 text-slate-400 hover:text-white' %> text-xs transition cursor-pointer">
                <span class="w-1.5 h-1.5 rounded-full <%= idx == 0 ? 'bg-blue-400' : 'bg-slate-600' %>"></span>
                <span class="font-medium"><%= ang[:short] %></span>
              </button>
            <% end %>
          </div>
          <span class="text-[11px] font-mono text-slate-500 whitespace-nowrap">
            Kare: <strong id="photo-gallery-counter" class="text-slate-300">1 / <%= spin_image_urls.size %></strong>
          </span>
        </div>
      </div>

      <!-- TAB PANEL: TÜKETİCİ GÜVENLİĞİ & EKSPERTİZ KİLİDİ -->
      <div id="tab-panel-guardrail" class="hidden bg-slate-900/80 rounded-2xl border border-slate-800/80 p-6 space-y-4 text-xs">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-800">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-lg">verified_user</span>
          </div>
          <div>
            <h3 class="font-bold text-white text-sm">Tüketici Güvenliği & Ekspertiz Kilidi</h3>
            <p class="text-slate-400 text-[11px]">Gerçek araç fotoğrafı güvencesi</p>
          </div>
        </div>
        <p class="text-slate-300 leading-relaxed">
          Sıfır Halüsinasyon Güvencesi: AutoAorta vitrinindeki hiçbir görsel yapay zeka ile boyanmamış veya kusurları gizlenmemiştir. Aracın tüm kaporta ve boya durumu ekspertiz raporuyla eşleştirilmiştir.
        </p>
      </div>

      <!-- Before vs After Analiz Kartı (Required Citation) -->
      <div id="before-after-analytics" class="p-4 rounded-2xl bg-slate-900/40 border border-slate-800/80 text-xs text-slate-400 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-white">Stüdyo Kalite ve Tıklanma Performansı</span>
          <span class="text-emerald-400 font-mono font-bold">+%170 CTR Artışı</span>
        </div>
        <p id="ctr-source-note" class="text-[11px] text-slate-500">
          Kaynak: Cox Automotive sektör araştırması; bu ilana özel ölçüm değildir.
        </p>
      </div>
    </div>

    <!-- SAĞ 4 KOLON: Fiyat, Ekspertiz ve Satış Kartı (Tesla/Polestar Style) -->
    <div class="lg:col-span-4 space-y-5">
      <!-- Satış ve Fiyat Paneli -->
      <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800/80 shadow-xl space-y-5">
        <!-- Fiyat & Durum -->
        <div class="space-y-1 pb-4 border-b border-slate-800">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Satış Fiyatı</span>
          <div class="font-display text-3xl font-extrabold text-white">
            <%= number_to_currency(@listing.price, unit: "₺", precision: 0, format: "%n %u") %>
          </div>
          <div class="flex items-center gap-2 pt-1 text-xs">
            <span class="text-emerald-400 font-semibold">Tramer Tutarı: <%= @listing.tramer.presence || "0 TL" %></span>
            <span class="text-slate-600">•</span>
            <span class="text-slate-400">~₺<%= number_with_delimiter(monthly_loan_estimate) %>/ay</span>
          </div>
        </div>

        <!-- Araç Özellikleri Bento -->
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <span class="text-[10px] text-slate-500 block uppercase">Kilometre</span>
            <span class="font-bold text-white font-mono"><%= number_with_delimiter(@listing.mileage) %> km</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <span class="text-[10px] text-slate-500 block uppercase">Model Yılı</span>
            <span class="font-bold text-white"><%= @listing.year %></span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <span class="text-[10px] text-slate-500 block uppercase">Yakıt / Motor</span>
            <span class="font-bold text-white"><%= @listing.fuel_type %></span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <span class="text-[10px] text-slate-500 block uppercase">Şanzıman</span>
            <span class="font-bold text-white"><%= @listing.transmission %></span>
          </div>
        </div>

        <!-- Aksiyon Butonları -->
        <div class="space-y-2.5 pt-1">
          <!-- Rezerve Et -->
          <button type="button"
                  onclick="alert('Tebrikler! <%= j @listing.title %> için rezervasyon kaydınız oluşturuldu. Satış danışmanımız sizi arayacaktır.');"
                  class="w-full py-3.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-blue-600/25 transition cursor-pointer active:scale-98">
            <span class="material-symbols-outlined text-sm">lock</span>
            <span>15.000 ₺ Kapora ile Rezerve Et</span>
          </button>

          <!-- PDF Ekspertiz Raporu İndir -->
          <button type="button"
                  onclick="alert('TSE Onaylı 160-Nokta Ekspertiz Raporu PDF olarak indiriliyor...');"
                  class="w-full py-3 px-4 rounded-xl bg-slate-950 hover:bg-slate-800 text-slate-200 border border-slate-800 font-semibold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
            <span class="material-symbols-outlined text-sm text-emerald-400">picture_as_pdf</span>
            <span>PDF Ekspertiz Raporunu İndir</span>
          </button>

          <!-- Takas Teklifi İlet -->
          <button type="button"
                  onclick="alert('Takas değerlendirme formu açılıyor. Mevcut aracınızın ruhsat ve km bilgilerini girerek anında değerleme alabilirsiniz.');"
                  class="w-full py-3 px-4 rounded-xl bg-slate-950 hover:bg-slate-800 text-slate-200 border border-slate-800 font-semibold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
            <span class="material-symbols-outlined text-sm text-blue-400">swap_horizontal_circle</span>
            <span>Takas Teklifi İlet</span>
          </button>

          <!-- WhatsApp İletişim -->
          <a href="https://wa.me/<%= @listing.dealer_phone.to_s.gsub(/[^0-9]/, '') %>?text=Merhaba,%20AutoAorta'daki%20<%= ERB::Util.url_encode(@listing.title) %>%20(VIN:%20#{vin_code})%20hakkında%20bilgi%20almak%20istiyorum."
             target="_blank"
             class="w-full py-3 px-4 rounded-xl bg-emerald-600/90 hover:bg-emerald-600 text-white font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
            <span class="material-symbols-outlined text-sm">chat</span>
            <span>WhatsApp ile Danışmana Bağlan</span>
          </a>
        </div>
      </div>

      <!-- Showroom Konumu & İletişim -->
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800/80 text-xs space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center font-bold">
            AA
          </div>
          <div>
            <h4 class="font-bold text-white"><%= @listing.dealer_name %></h4>
            <p class="text-[11px] text-slate-400">Maslak 1453 Showroom • 0850 300 80 90</p>
          </div>
        </div>
        <p class="text-[11px] text-slate-500 border-t border-slate-800/80 pt-2">
          Pazartesi – Cumartesi: 09:00 – 19:30 (Pazar günleri randevulu açıktır).
        </p>
      </div>
    </div>
  </div>

  <!-- DETAYLI EKSPERTİZ ŞEMASI (ALT BÖLÜM - 2D GÖVDE MİKRON HARİTASI) -->
  <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 shadow-xl space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800/80 pb-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-emerald-400 text-xl">fact_check</span>
          <h2 class="font-display text-lg sm:text-xl font-bold text-white">
            2D Gövde Mikron ve Parça Ekspertiz Karnesi
          </h2>
          <span id="inspection-demo-badge" class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/30 text-[10px] font-bold uppercase">
            Örnek / Demo Veri
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">
          Lazer mikron kalınlık ölçer ve ultrasonik boya kalınlık testi sonuçları.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
          160 / 160 Nokta Onaylandı (Demo)
        </span>
      </div>
    </div>

    <!-- 2D Araç Parça Durumu Matrisi (Preline Table Pattern) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
      <% body_parts = [
           { name: "Ön Kaput",           micron: 120, status: "Orijinal", is_defect: false },
           { name: "Tavan",              micron: 110, status: "Orijinal", is_defect: false },
           { name: "Bagaj Kapağı",       micron: 115, status: "Orijinal", is_defect: false },
           { name: "Sol Ön Çamurluk",    micron: 125, status: "Orijinal", is_defect: false },
           { name: "Sol Ön Kapı",        micron: 120, status: "Orijinal", is_defect: false },
           { name: "Sol Arka Kapı",       micron: 120, status: "Orijinal", is_defect: false }
         ] %>

      <!-- Inject real defects into parts if matching -->
      <% @listing.defects.each do |defect| %>
        <% if defect.part_name.present? %>
          <% matched = body_parts.find { |p| p[:name].downcase == defect.part_name.downcase } %>
          <% if matched %>
            <% matched[:micron] = defect.micron_value %>
            <% matched[:status] = defect.defect_type %>
            <% matched[:is_defect] = true %>
          <% else %>
            <% body_parts << { name: defect.part_name, micron: defect.micron_value, status: defect.defect_type, is_defect: true } %>
          <% end %>
        <% end %>
      <% end %>

      <% body_parts.each do |part| %>
        <div class="p-3.5 rounded-2xl <%= part[:is_defect] ? 'bg-amber-500/10 border border-amber-500/30' : 'bg-slate-950/60 border border-slate-800/80' %> space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-medium text-slate-300 text-[11px]"><%= part[:name] %></span>
            <span class="w-2 h-2 rounded-full <%= part[:is_defect] ? 'bg-amber-400' : 'bg-emerald-400' %>"></span>
          </div>
          <div class="font-mono text-sm font-bold <%= part[:is_defect] ? 'text-amber-300' : 'text-white' %>">
            <%= part[:micron] %> µm
          </div>
          <div class="text-[10px] <%= part[:is_defect] ? 'text-amber-400 font-semibold' : 'text-slate-400' %>">
            <%= part[:status] %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Kusur Listesi Tablosu (Varsa) -->
    <% if @listing.defects.any? %>
      <div class="pt-2">
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Tespit Edilen Kusur ve İşlem Detayları</h4>
        <div class="divide-y divide-slate-800 border border-slate-800 rounded-2xl overflow-hidden bg-slate-950/40 text-xs">
          <% @listing.defects.each do |d| %>
            <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono text-[10px] font-bold">
                  <%= d.part_name %>
                </span>
                <span class="font-semibold text-white"><%= d.title %></span>
              </div>
              <div class="text-slate-400 text-[11px]">
                <%= d.description %> (<strong class="text-white font-mono"><%= d.micron_value %> µm</strong>)
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- HOTSPOT DEFECT DETAILS MODAL (Preline / Tailwind) -->
  <div data-vehicle-360-target="modal"
       class="hidden fixed inset-0 z-50 overflow-x-hidden overflow-y-auto bg-slate-950/80 backdrop-blur-md items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl space-y-4">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold">
            !
          </div>
          <div>
            <h3 data-vehicle-360-target="modalTitle" class="font-bold text-white text-sm">Kusur Detayı</h3>
            <span data-vehicle-360-target="modalPart" class="text-slate-400 text-xs">Gövde Aksamı</span>
          </div>
        </div>
        <button type="button"
                data-action="click->vehicle-360#closeModal"
                class="p-1 rounded-lg text-slate-400 hover:text-white bg-slate-800 transition cursor-pointer">
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-2 text-xs py-1">
        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
          <span class="text-[10px] text-slate-500 block">Mikron Değeri</span>
          <span data-vehicle-360-target="modalMicron" class="font-bold text-amber-300 font-mono text-sm">165 µm</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
          <span class="text-[10px] text-slate-500 block">İşlem Türü</span>
          <span data-vehicle-360-target="modalType" class="font-bold text-white">Lokal Boya</span>
        </div>
      </div>

      <div class="text-xs text-slate-300 bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
        <p data-vehicle-360-target="modalDesc">Açıklama</p>
      </div>

      <div class="flex items-center justify-between pt-1 text-xs">
        <span data-vehicle-360-target="modalSeverity" class="text-amber-400 text-[11px] font-medium">Hafif Kusur</span>
        <button type="button"
                data-action="click->vehicle-360#closeModal"
                class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium transition cursor-pointer">
          Kapat
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Global helper for opening modal from defect pins
  window.openDefectModalFromPin = function(defectId) {
    const defects = <%= raw(@listing.defects.map { |d| { id: d.id, part_name: d.part_name, title: d.title, micron_value: d.micron_value, defect_type: d.defect_type, description: d.description, severity: d.severity } }.to_json) %>;
    const matched = defects.find(d => d.id === defectId);
    if (matched) {
      const controllerEl = document.querySelector('[data-controller="vehicle-360"]');
      if (controllerEl) {
        const controller = window.Stimulus?.getControllerForElementAndIdentifier(controllerEl, 'vehicle-360');
        if (controller && controller.openDefectModal) {
          controller.openDefectModal(matched);
        }
      }
    }
  };

  // Showroom tab switcher
  window.switchShowroomTab = function(mode) {
    const panels = {
      "splat": document.getElementById("tab-panel-splat"),
      "photo": document.getElementById("tab-panel-photo"),
      "guardrail": document.getElementById("tab-panel-guardrail")
    };
    const buttons = {
      "splat": document.getElementById("tab-btn-splat"),
      "photo": document.getElementById("tab-btn-photo"),
      "guardrail": document.getElementById("tab-btn-guardrail")
    };

    Object.keys(panels).forEach((key) => {
      if (panels[key]) panels[key].classList.toggle("hidden", key !== mode);
      if (buttons[key]) {
        if (key === mode) {
          buttons[key].className = "showroom-tab-btn flex-1 py-2 px-3.5 rounded-xl bg-slate-800 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-sm transition cursor-pointer";
        } else {
          buttons[key].className = "showroom-tab-btn flex-1 py-2 px-3.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/60 text-xs flex items-center justify-center gap-1.5 transition cursor-pointer";
        }
      }
    });

    if (mode === "splat" && window.initSplatViewer) {
      window.initSplatViewer();
    }
  };

  window.selectPhotoGalleryAngle = function(idx, label, url) {
    const mainImg = document.getElementById("photo-gallery-main-image");
    if (mainImg && url) {
      mainImg.style.opacity = "0.5";
      setTimeout(() => {
        mainImg.src = url;
        mainImg.style.opacity = "1.0";
      }, 50);
    }
    const badge = document.getElementById("photo-gallery-badge");
    if (badge && label) badge.textContent = label;
    const counter = document.getElementById("photo-gallery-counter");
    if (counter) counter.textContent = `${idx + 1} / <%= spin_image_urls.size %>`;

    for (let i = 0; i < 6; i++) {
      const btn = document.getElementById(`sync-angle-btn-${i}`);
      if (btn) {
        if (i === idx) {
          btn.className = "sync-angle-btn flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-900/80 border border-blue-500 text-white text-xs transition cursor-pointer";
        } else {
          btn.className = "sync-angle-btn flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-400 hover:text-white text-xs transition cursor-pointer";
        }
      }
    }
  };
</script>

<% if @listing.has_splat? %>
  <script src="https://unpkg.com/@mkkellogg/gaussian-splats-3d@0.4.4/build/gaussian-splats-3d.umd.cjs"></script>
  <script>
    window.initSplatViewer = function() {
      const container = document.getElementById("splat-viewer-container");
      if (!container || window.splatViewerInstance) return;
      const splatUrl = container.dataset.splatUrl;
      if (!splatUrl) return;

      try {
        const GaussianSplats3D = window.GaussianSplats3D || window["Gaussian Splats 3D"];
        if (!GaussianSplats3D || !GaussianSplats3D.Viewer) {
          setTimeout(window.initSplatViewer, 100);
          return;
        }
        const viewer = new GaussianSplats3D.Viewer({
          rootElement: container,
          cameraUp: [0, -1, -0.6],
          initialCameraPosition: [-1, -4, 6],
          initialCameraLookAt: [0, 4, 0],
          useBuiltInControls: true
        });
        window.splatViewerInstance = viewer;
        viewer.addSplatScene(splatUrl, {
          format: GaussianSplats3D.SceneFormat ? GaussianSplats3D.SceneFormat.Splat : 1,
          showLoadingUI: false
        }).then(() => {
          viewer.start();
          const overlay = document.getElementById("showroom-splat-loading-overlay");
          if (overlay) overlay.style.display = "none";
        }).catch(() => {
          const overlay = document.getElementById("showroom-splat-loading-overlay");
          if (overlay) overlay.style.display = "none";
        });
      } catch (e) {
        console.warn("GaussianSplats3D error:", e);
      }
    };
  </script>
<% end %>
