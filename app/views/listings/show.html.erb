<script>
  window.turntableFrames = <%= raw(spin_image_urls.to_json) %>;
  window.turntableLabels = <%= raw(spin_angle_labels.to_json) %>;
  window.verifiedSixAngles = <%= raw(verified_six_angles.to_json) %>;
  window.turntableCurrentIndex = 0;
  window.showroomActiveMode = "<%= @listing.has_splat? ? 'splat' : 'photo' %>";

  // Preload all real vehicle photographs for zero-latency 360° spin
  (function preloadTurntablePhotos() {
    const allUrls = <%= raw(verified_six_angles.map { |a| a[:src] }.to_json) %>;
    allUrls.forEach((url) => {
      if (url) {
        const img = new Image();
        img.src = url;
      }
    });
  })();

  // 1. Sekme Değiştirici
  window.switchShowroomTab = function(mode) {
    window.showroomActiveMode = mode;
    const panels = {
      "splat": document.getElementById("tab-panel-splat"),
      "photo": document.getElementById("tab-panel-photo"),
      "guardrail": document.getElementById("tab-panel-guardrail")
    };
    const buttons = {
      "splat": document.getElementById("tab-btn-splat"),
      "photo": document.getElementById("tab-btn-photo"),
      "guardrail": document.getElementById("tab-btn-guardrail")
    };

    Object.keys(panels).forEach((key) => {
      if (panels[key]) {
        panels[key].classList.toggle("hidden", key !== mode);
      }
      if (buttons[key]) {
        if (key === mode) {
          buttons[key].className = "showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-[#1D4ED8] text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition cursor-pointer";
        } else {
          buttons[key].className = "showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer";
        }
      }
    });

    if (mode === "splat" && window.initSplatViewer) {
      window.initSplatViewer();
    }
  };

  // 2. 2D Fotoğraf Galerisi Seçici (Yüksek çözünürlüklü, optik deformasyonsuz / esnemesiz)
  window.selectPhotoGalleryAngle = function(idx, label, url) {
    const mainImg = document.getElementById("photo-gallery-main-image");
    if (mainImg && url) {
      mainImg.style.opacity = "0.5";
      setTimeout(() => {
        mainImg.src = url;
        mainImg.style.opacity = "1.0";
      }, 50);
    }

    const badge = document.getElementById("photo-gallery-badge");
    if (badge && label) badge.textContent = label;

    const counter = document.getElementById("photo-gallery-counter");
    if (counter) counter.textContent = `${idx + 1} / <%= spin_image_urls.size %>`;

    const thumbBtns = document.querySelectorAll(".photo-thumb-btn");
    thumbBtns.forEach((btn, i) => {
      if (i === idx) {
        btn.className = "photo-thumb-btn w-14 h-10 rounded-lg overflow-hidden border-2 border-[#1D4ED8] ring-2 ring-blue-500/20 transition flex-shrink-0 cursor-pointer";
      } else {
        btn.className = "photo-thumb-btn w-14 h-10 rounded-lg overflow-hidden border-2 border-slate-300 hover:border-slate-400 transition flex-shrink-0 cursor-pointer";
      }
    });

    window.highlightAngleButton(idx);
  };

  // 3. 6 Doğrulanmış Açı Seçici (Tıklandığında fotoğrafı o açıya getirir)
  window.syncVehicleAngle = function(idx, label, src) {
    if (window.switchShowroomTab && window.showroomActiveMode !== "photo" && !document.getElementById("tab-panel-splat")) {
      window.switchShowroomTab("photo");
    }
    window.selectPhotoGalleryAngle(idx, label, src);
    window.highlightAngleButton(idx);
  };

  window.highlightAngleButton = function(activeIdx) {
    for (let i = 0; i < 6; i++) {
      const btn = document.getElementById(`sync-angle-btn-${i}`);
      if (btn) {
        if (i === activeIdx) {
          btn.className = "sync-angle-btn flex flex-col gap-1 p-1.5 rounded-xl bg-white border-2 border-[#1D4ED8] ring-2 ring-blue-500/20 shadow-xs transition text-left cursor-pointer group";
        } else {
          btn.className = "sync-angle-btn flex flex-col gap-1 p-1.5 rounded-xl bg-white border-2 border-slate-200 hover:border-[#1D4ED8] shadow-xs transition text-left cursor-pointer group";
        }
      }
    }
  };

  // 4. Kredi Simülatörü Hesaplama Fonksiyonu
  window.updateLoanEstimate = function(downPaymentPct) {
    const totalVehiclePrice = <%= @listing.price.to_f %>;
    const downPaymentRatio = parseInt(downPaymentPct, 10) / 100;
    const loanAmount = totalVehiclePrice * (1 - downPaymentRatio);
    const months = 36;
    const monthlyPayment = Math.round(loanAmount / months);

    const downPaymentEl = document.getElementById("loan-downpayment-text");
    if (downPaymentEl) {
      downPaymentEl.textContent = `%${downPaymentPct} Peşinat (₺${Math.round(totalVehiclePrice * downPaymentRatio).toLocaleString()})`;
    }

    const badgeEl = document.getElementById("loan-monthly-badge");
    if (badgeEl) {
      badgeEl.textContent = `~₺${monthlyPayment.toLocaleString()} / ay`;
    }
  };
</script>

<% if @listing.has_splat? %>
  <script src="https://unpkg.com/@mkkellogg/gaussian-splats-3d@0.4.4/build/gaussian-splats-3d.umd.cjs"></script>
  <script>
    window.splatViewerInstance = null;

    window.initSplatViewer = function() {
      const container = document.getElementById("splat-viewer-container");
      if (!container || window.splatViewerInstance) return;

      const overlay = document.getElementById("showroom-splat-loading-overlay");
      const splatUrl = container.dataset.splatUrl;
      if (!splatUrl) return;

      try {
        const GaussianSplats3D = window.GaussianSplats3D || window["Gaussian Splats 3D"];
        if (!GaussianSplats3D || !GaussianSplats3D.Viewer) {
          setTimeout(window.initSplatViewer, 100);
          return;
        }

        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        const viewer = new GaussianSplats3D.Viewer({
          rootElement: container,
          cameraUp: [0, -1, -0.6],
          initialCameraPosition: [-1, -4, 6],
          initialCameraLookAt: [0, 4, 0],
          useBuiltInControls: true,
          devicePixelRatio: dpr,
          integerBasedSort: true,
          halfPrecisionCovariancesOnGPU: true,
          splatAlphaRemovalThreshold: 15
        });
        window.splatViewerInstance = viewer;

        viewer.addSplatScene(splatUrl, {
          format: GaussianSplats3D.SceneFormat ? GaussianSplats3D.SceneFormat.Splat : 1,
          showLoadingUI: false
        }).then(() => {
          viewer.start();
          if (overlay) overlay.style.display = "none";
        }).catch((err) => {
          console.warn("GaussianSplats3D scene error:", err);
          if (overlay) overlay.style.display = "none";
        });
      } catch (e) {
        console.warn("GaussianSplats3D init error:", e);
        if (overlay) overlay.style.display = "none";
      }
    };

    window.resetSplatCamera = function() {
      if (window.splatViewerInstance && window.splatViewerInstance.controls) {
        window.splatViewerInstance.controls.reset();
      }
    };

    window.toggleSplatHotspots = function() {
      const layer = document.getElementById("showroom-splat-hotspots-layer");
      if (!layer) return;
      const isHidden = layer.style.display === "none";
      layer.style.display = isHidden ? "block" : "none";
      const pins = layer.querySelectorAll(".hotspot-3d-pin");
      pins.forEach(p => p.style.display = isHidden ? "block" : "none");
    };

    // DeepSeek R1 Bellek & WebGL Context Optimizasyonu
    document.addEventListener("visibilitychange", () => {
      if (!window.splatViewerInstance) return;
      if (document.hidden) {
        if (typeof window.splatViewerInstance.stop === "function") try { window.splatViewerInstance.stop(); } catch (_) {}
      } else if (window.showroomActiveMode === "splat") {
        if (typeof window.splatViewerInstance.start === "function") try { window.splatViewerInstance.start(); } catch (_) {}
      }
    });

    function cleanupSplatViewer() {
      if (window.splatViewerInstance) {
        try {
          if (typeof window.splatViewerInstance.dispose === "function") window.splatViewerInstance.dispose();
        } catch (_) {}
        window.splatViewerInstance = null;
      }
    }
    document.addEventListener("turbo:before-cache", cleanupSplatViewer);
    document.addEventListener("turbo:before-render", cleanupSplatViewer);

    document.addEventListener("turbo:load", () => {
      if (document.getElementById("splat-viewer-container")) {
        window.initSplatViewer();
      }
    });
    if (document.readyState === "complete" || document.readyState === "interactive") {
      setTimeout(() => {
        if (document.getElementById("splat-viewer-container")) {
          window.initSplatViewer();
        }
      }, 150);
    }
  </script>
<% end %>
