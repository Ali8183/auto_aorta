<div class="space-y-8">
  <% fallback_src = vehicle_fallback_image(@listing) %>
  <% hero_src = listing_hero_image_url(@listing) %>
  <% brand_gallery = brand_angle_gallery(@listing) %>
  <% v3d = vehicle_3d_config(@listing) %>
  <% spin_image_urls = [
       brand_gallery[:front_three_quarter],
       brand_gallery[:front],
       brand_gallery[:side],
       brand_gallery[:rear_three_quarter],
       brand_gallery[:rear]
     ] %>
  <% spin_angle_labels = [
       "Ön 3/4 (45° Altın Açı)",
       "Ön (90°)",
       "Yan Profil (180°)",
       "Arka 3/4 (225°)",
       "Arka (270°)"
     ] %>
  <% verified_six_angles = [
       { key: "front_three_quarter", label: "Ön 3/4 (45° Altın Açı)", short: "Ön 3/4",   title: "Altın Oran Vitrin", src: brand_gallery[:front_three_quarter], deg: "45°" },
       { key: "front",               label: "Ön (90°)",               short: "Ön",       title: "Ön Izgara & Far",   src: brand_gallery[:front],               deg: "90°" },
       { key: "side",                label: "Yan Profil (180°)",      short: "Yan",      title: "Gövde & Jant",      src: brand_gallery[:side],                deg: "180°" },
       { key: "rear_three_quarter",  label: "Arka 3/4 (225°)",        short: "Arka 3/4", title: "Arka Omuz Çizgisi", src: brand_gallery[:rear_three_quarter],  deg: "225°" },
       { key: "rear",                label: "Arka (270°)",            short: "Arka",     title: "Arka Difüzör",      src: brand_gallery[:rear],                deg: "270°" },
       { key: "interior",            label: "Kokpit (İç Mekan)",      short: "Kokpit",   title: "İç Mekan & Ekran",  src: brand_gallery[:interior],            deg: "360°" }
     ] %>
  <% monthly_loan_estimate = ((@listing.price.to_f * 0.70) / 36).round %>

  <!-- Top Customer Breadcrumb & Vehicle Summary Header -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div class="space-y-1.5">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <%= link_to "Araç Filosu", root_path, class: "hover:text-[#1D4ED8] transition" %>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-700"><%= @listing.brand %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-800 font-semibold"><%= @listing.model_name %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-mono text-[11px] font-semibold">
          VIN: <%= @listing.brand[0..2].upcase %><%= @listing.id.to_s.rjust(8, '0') %>
        </span>
      </div>

      <!-- Main Vehicle Title -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <h1 class="font-headline text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight">
          <%= @listing.title %>
        </h1>

        <!-- Trust Badges Row -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold shadow-xs">
            <span class="material-symbols-outlined text-sm text-emerald-600">verified</span>
            <span>160-Nokta Sertifikalı</span>
            <span id="inspection-demo-badge" class="ml-1 px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-300 text-[10px] font-bold uppercase">Örnek / Demo Veri</span>
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 text-[#1D4ED8] border border-blue-200 text-xs font-semibold shadow-xs">
            <span class="material-symbols-outlined text-sm">360</span>
            <span>360° Stüdyo Turu Hazır</span>
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 text-xs font-semibold shadow-xs">
            <span class="material-symbols-outlined text-xs text-amber-600">lock</span>
            <span>7 Gün İade Garantili</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Actions & Management Toolbar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- 108 Kare 3D Çekim -->
      <%= link_to capture_listing_path(@listing), class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-[#1D4ED8] border border-blue-200 font-semibold text-xs shadow-xs transition cursor-pointer", title: "108 Kare 3D Fotogrametri Çekim Stüdyosu" do %>
        <span class="material-symbols-outlined text-sm">videocam</span>
        <span>108 Kare 3D Çekim</span>
      <% end %>

      <!-- Paylaş / Embed Önizle -->
      <%= link_to embed_listing_url(@listing), target: "_blank", class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition cursor-pointer", title: "İlanı Paylaş veya Harici Sitede Önizle" do %>
        <span class="material-symbols-outlined text-sm text-[#1D4ED8]">ios_share</span>
        <span>Paylaş</span>
      <% end %>

      <!-- Yetkili Yönetim Dropdown (Re-shoot / Publish) -->
      <% unless @listing.published? %>
        <%= button_to publish_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs shadow-sm transition cursor-pointer active:scale-[0.99]" do %>
          <span class="material-symbols-outlined text-sm">rocket_launch</span>
          <span>Yayına Al</span>
        <% end %>
      <% end %>

      <!-- 24 Saat İleri Sar (SLA Testi) -->
      <%= button_to simulate_time_lapse_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-amber-800 border border-slate-200 font-semibold text-xs transition cursor-pointer", title: "24 saat kuralını simüle eder" do %>
        <span class="material-symbols-outlined text-sm text-amber-600">timer</span>
        <span>24h SLA Testi</span>
      <% end %>

      <!-- Sil -->
      <%= button_to listing_path(@listing), method: :delete, data: { turbo_confirm: "Bu aracı filodan silmek istediğinize emin misiniz?" }, class: "p-2 rounded-xl bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 border border-slate-200 transition cursor-pointer", title: "İlanı Sil" do %>
        <span class="material-symbols-outlined text-base">delete</span>
      <% end %>
    </div>
  </div>

  <!-- MAIN SHOWROOM GRID: 12-Column Responsive Layout -->
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <!-- SOL 8 KOLON: 3D / 360° Studio Showcase & Detailed Matrices -->
    <div class="xl:col-span-8 space-y-6">
      <!-- 1. 360° VİTRİN İÇİN MOD SEÇİCİ (TABS) -->
      <div class="bg-white rounded-2xl border border-slate-200 p-2 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2" role="tablist" aria-label="360 Vitrin Mod Seçici">
        <% if @listing.has_splat? %>
          <button type="button"
                  id="tab-btn-splat"
                  onclick="switchShowroomTab('splat')"
                  class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-[#1D4ED8] text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition cursor-pointer">
            <span class="material-symbols-outlined text-base">view_in_ar</span>
            <span>⚡ 3D Gaussian Splatting (Gerçek WebGL Simülasyonu)</span>
            <span class="px-1.5 py-0.5 rounded-full bg-blue-100 text-[#1D4ED8] text-[10px] font-mono">3D Splat</span>
          </button>
        <% end %>

        <button type="button"
                id="tab-btn-photo"
                onclick="switchShowroomTab('photo')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl <%= @listing.has_splat? ? 'bg-slate-100 hover:bg-slate-200 text-slate-700' : 'bg-[#1D4ED8] text-white shadow-sm' %> font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
          <span class="material-symbols-outlined text-base">360</span>
          <span>📸 360° Doğrulanmış Fotoğraf Turu</span>
          <span class="px-1.5 py-0.5 rounded-full <%= @listing.has_splat? ? 'bg-slate-200 text-slate-700' : 'bg-blue-100 text-[#1D4ED8]' %> text-[10px] font-mono"><%= spin_image_urls.size %> Açı</span>
        </button>

        <button type="button"
                id="tab-btn-guardrail"
                onclick="switchShowroomTab('guardrail')"
                class="showroom-tab-btn flex-1 py-2.5 px-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center gap-2 transition cursor-pointer">
          <span class="material-symbols-outlined text-base">verified_user</span>
          <span>🛡️ Tüketici Güvenliği & Ekspertiz Kilidi</span>
        </button>
      </div>

      <% if @listing.has_splat? %>
        <!-- SEKME 1: CANLI 3D GAUSSIAN SPLATTING WEBGL SHOWROOM -->
        <div id="tab-panel-splat" class="bg-slate-950 rounded-2xl border border-slate-700 shadow-xl overflow-hidden relative flex flex-col justify-between">
          <!-- Top Bar -->
          <div class="px-4 py-3 bg-slate-900 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-300">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="font-bold text-white"><%= @listing.title %></span>
              <span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 text-[10px] font-mono">GaussianSplats3D WebGL</span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-slate-800 text-slate-200 text-[11px] font-mono border border-slate-700">
                <span class="w-2 h-2 rounded-full" style="background-color: <%= v3d[:hex] %>;"></span>
                <span><%= @listing.color %></span>
              </span>
            </div>
            <div class="flex items-center gap-3 text-[11px] text-slate-400">
              <span id="showroom-splat-angle-badge" class="font-mono text-blue-400 font-bold">Ön 3/4 (45° Altın Açı)</span>
              <span>•</span>
              <span class="hidden sm:inline">Sol Tık: 360° Döndür • Tekerlek: Yakınlaş • Sağ Tık: Pan</span>
            </div>
          </div>

          <!-- 3D Splat Viewer Container -->
          <div id="splat-viewer-container"
               data-splat-url="<%= @listing.splat_url %>"
               data-car-brand="<%= @listing.brand %>"
               data-car-model="<%= @listing.model_name %>"
               data-car-color="<%= @listing.color %>"
               data-car-hex="<%= v3d[:hex] %>"
               data-car-body="<%= v3d[:body_style] %>"
               class="w-full h-[540px] relative bg-gradient-to-b from-[#090d16] via-[#0d1527] to-[#0a0f1d] cursor-grab active:cursor-grabbing select-none overflow-hidden">

            <div id="showroom-splat-loading-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 z-20 text-white text-xs gap-3">
              <div class="w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
              <span class="font-mono text-slate-300">3D Gaussian Splatting Modeli Yükleniyor...</span>
            </div>

            <!-- Hotspot Pins Layer in 3D Space -->
            <div id="showroom-splat-hotspots-layer" class="pointer-events-none absolute inset-0 z-10 overflow-hidden">
              <!-- Pin 1: Ön Tampon -->
              <div id="hotspot-pin-bumper" class="hotspot-3d-pin absolute pointer-events-auto cursor-pointer transform -translate-x-1/2 -translate-y-1/2 group" style="display: none; left: 42%; top: 62%;">
                <div class="relative flex items-center justify-center">
                  <span class="absolute w-6 h-6 rounded-full bg-amber-400/40 animate-ping"></span>
                  <span class="relative w-4 h-4 rounded-full bg-amber-500 border-2 border-white shadow-lg flex items-center justify-center text-[9px] text-white font-bold">1</span>
                </div>
                <div class="absolute left-6 top-1/2 -translate-y-1/2 hidden group-hover:flex flex-col bg-slate-900/95 text-white text-[11px] px-2.5 py-1.5 rounded-lg border border-slate-700 shadow-xl whitespace-nowrap z-30">
                  <span class="font-bold text-amber-400">Kozmetik Ekspertiz:</span>
                  <span class="text-slate-300">Ön Tampon 2mm Taş İzi (Boya Gerektirmez)</span>
                </div>
              </div>

              <!-- Pin 2: Jant -->
              <div id="hotspot-pin-wheel" class="hotspot-3d-pin absolute pointer-events-auto cursor-pointer transform -translate-x-1/2 -translate-y-1/2 group" style="display: none; left: 68%; top: 66%;">
                <div class="relative flex items-center justify-center">
                  <span class="absolute w-6 h-6 rounded-full bg-blue-400/40 animate-ping"></span>
                  <span class="relative w-4 h-4 rounded-full bg-blue-600 border-2 border-white shadow-lg flex items-center justify-center text-[9px] text-white font-bold">2</span>
                </div>
                <div class="absolute left-6 top-1/2 -translate-y-1/2 hidden group-hover:flex flex-col bg-slate-900/95 text-white text-[11px] px-2.5 py-1.5 rounded-lg border border-slate-700 shadow-xl whitespace-nowrap z-30">
                  <span class="font-bold text-blue-400">Jant &amp; Yürüyen Aksam:</span>
                  <span class="text-slate-300">19" Hafif Alaşım Jant (Çiziksiz / Orijinal Balans)</span>
                </div>
              </div>

              <!-- Pin 3: Ön Cam -->
              <div id="hotspot-pin-glass" class="hotspot-3d-pin absolute pointer-events-auto cursor-pointer transform -translate-x-1/2 -translate-y-1/2 group" style="display: none; left: 52%; top: 38%;">
                <div class="relative flex items-center justify-center">
                  <span class="absolute w-6 h-6 rounded-full bg-emerald-400/40 animate-ping"></span>
                  <span class="relative w-4 h-4 rounded-full bg-emerald-500 border-2 border-white shadow-lg flex items-center justify-center text-[9px] text-white font-bold">3</span>
                </div>
                <div class="absolute left-6 top-1/2 -translate-y-1/2 hidden group-hover:flex flex-col bg-slate-900/95 text-white text-[11px] px-2.5 py-1.5 rounded-lg border border-slate-700 shadow-xl whitespace-nowrap z-30">
                  <span class="font-bold text-emerald-400">Akustik Cam Kontrolü:</span>
                  <span class="text-slate-300">Orijinal Fabrika Ön Camı (Çatlak / Taş Kırığı Yok)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Controls Bar for 3D Splat -->
          <div class="px-4 py-3 bg-slate-900 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2">
              <button type="button"
                      id="btn-splat-reset-cam"
                      onclick="resetSplatCamera()"
                      class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-semibold text-xs transition cursor-pointer">
                <span>Kamerayı Sıfırla</span>
              </button>

              <button type="button"
                      id="btn-splat-toggle-hotspots"
                      onclick="toggleSplatHotspots()"
                      class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-semibold text-xs transition cursor-pointer">
                <span class="material-symbols-outlined text-sm text-emerald-400">verified</span>
                <span>Ekspertiz Pinleri</span>
              </button>
            </div>

            <div class="flex items-center gap-2 font-mono text-[11px] text-slate-400">
              <span>Dinamik Açı:</span>
              <span id="showroom-splat-degree" class="font-bold text-white bg-slate-800 px-2 py-0.5 rounded border border-slate-700">45°</span>
              <span class="text-slate-600">|</span>
              <span class="text-emerald-400 font-semibold">✓ 1:1 <%= @listing.color %> WebGL Simülasyonu</span>
            </div>
          </div>
        </div>
      <% end %>

      <!-- SEKME 2: 360° DOĞRULANMIŞ FOTOĞRAF TURU (BİREBİR AYNI ARAÇ) -->
      <div id="tab-panel-photo" class="<%= @listing.has_splat? ? 'hidden ' : '' %>bg-white rounded-2xl border border-slate-200 shadow-lg overflow-hidden flex flex-col justify-between">
        <!-- Top Bar -->
        <div class="px-5 py-3.5 bg-white border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-full bg-slate-900 text-white font-mono text-xs font-bold">
              <%= @listing.color %>
            </span>
            <span id="photo-gallery-badge" class="px-3 py-1 rounded-full bg-blue-50 text-[#1D4ED8] font-mono text-xs font-extrabold border border-blue-200">
              <%= spin_angle_labels.first %>
            </span>
          </div>
          <span class="text-xs text-slate-500 font-semibold flex items-center gap-1">
            <span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span>
            <span>Birebir Aynı Araç • Gerçek Piksel Fotoğrafları</span>
          </span>
        </div>

        <!-- Main Photo Stage (Clean, crisp, no artificial stretching or warping!) -->
        <div class="relative w-full h-[540px] flex items-center justify-center p-4 bg-gradient-to-b from-slate-100/70 via-white to-slate-100/70">
          <img id="photo-gallery-main-image"
               src="<%= spin_image_urls.first || fallback_src %>"
               alt="<%= @listing.title %>"
               class="w-full h-[520px] object-contain select-none transition-opacity duration-150"
               onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
               onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
        </div>

        <!-- Thumbnails Strip -->
        <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2 overflow-x-auto py-1">
            <% spin_image_urls.each_with_index do |url, idx| %>
              <button type="button"
                      onclick="selectPhotoGalleryAngle(<%= idx %>, '<%= spin_angle_labels[idx] %>', '<%= url %>')"
                      class="photo-thumb-btn w-14 h-10 rounded-lg overflow-hidden border-2 <%= idx == 0 ? 'border-[#1D4ED8] ring-2 ring-blue-500/20' : 'border-slate-300 hover:border-slate-400' %> transition flex-shrink-0 cursor-pointer">
                <img src="<%= url %>" class="w-full h-full object-cover" alt="Angle <%= idx + 1 %>" />
              </button>
            <% end %>
          </div>
          <span class="text-xs font-mono text-slate-600 whitespace-nowrap">
            Kare: <span id="photo-gallery-counter" class="font-bold text-slate-900">1 / <%= spin_image_urls.size %></span>
          </span>
        </div>
      </div>

      <!-- TAB 3 PANEL: TÜKETİCİ GÜVENLİĞİ & EKSPERTİZ KİLİDİ -->
      <div id="tab-panel-guardrail" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5">
        <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-2xl">verified_user</span>
            </div>
            <div>
              <h3 class="font-headline text-base font-extrabold text-slate-900">
                🛡️ Tüketici Güvenliği & Eksik Fotoğraf Emniyet Kilidi
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                İkinci el otomotiv ticaretinde üretken yapay zekâ halüsinasyonlarını engelleyen etik koruma protokolü.
              </p>
            </div>
          </div>
          <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold whitespace-nowrap">
            SHA-256 Piksel Kilidi Aktif
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-rose-50/60 border border-rose-200 space-y-2">
            <div class="font-extrabold text-rose-800 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">block</span>
              <span>Neden Üretken 3D Halüsinasyon Yasaktır?</span>
            </div>
            <p class="text-slate-600 leading-relaxed">
              Eksik açılardan aracın görünmeyen yanını veya arka tamponunu yapay zekâ ile "tahmin ederek" sahte model üretmek, gerçek araçtaki <strong>göçükleri, taş izlerini ve boya kusurlarını gizler</strong>.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-emerald-50/60 border border-emerald-200 space-y-2">
            <div class="font-extrabold text-emerald-800 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">check_circle</span>
              <span>AutoAorta AI Sıfır-Halüsinasyon Standardı</span>
            </div>
            <p class="text-slate-600 leading-relaxed">
              AutoAorta AI yalnızca <strong>gerçek kamera sensöründen gelen fotoğrafları</strong> gösterir; fotoğraflanmayan açılar üretken yapay zekâ ile tamamlanmaz ve kozmetik kusurlar gizlenmez.
            </p>
          </div>
        </div>
      </div>

      <!-- BİZZAT AYNI ARACA AİT 6 AÇI SEÇİCİ -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#1D4ED8] text-lg">360</span>
            <span class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">
              Bizzat Aynı Araca Ait 6 Açı (Tıkla &amp; Fotoğrafta Göster)
            </span>
          </div>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
            1:1 Renk & Model Uyumu: <%= @listing.color %>
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5">
          <% verified_six_angles.each_with_index do |ang, idx| %>
            <button type="button"
                    id="sync-angle-btn-<%= idx %>"
                    onclick="syncVehicleAngle(<%= idx %>, '<%= ang[:label] %>', '<%= ang[:src] %>')"
