<div class="space-y-8">
  <% fallback_src = vehicle_fallback_image(@listing) %>
  <% hero_src = listing_hero_image_url(@listing) %>
  <% brand_gallery = brand_angle_gallery(@listing) %>
  <% spin_image_urls = safe_spin_image_urls(@listing, @spin_photos) %>
  <% spin_angle_labels = @spin_photos.any? ? @spin_photos.map.with_index do |p, idx|
       analysis = @photo_analyses.find { |a| a.blob_id == p.blob_id }
       analysis&.detected_angle&.titleize || "Açı #{idx + 1}"
     end : ["Front Three Quarter", "Front", "Side", "Rear Three Quarter", "Rear"] %>

  <!-- Top Breadcrumb & Studio Command Bar (Stitch Daylight Design) -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <%= link_to "Inventory & Merchandising", root_path, class: "hover:text-[#1D4ED8] transition" %>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-700"><%= @listing.brand %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="text-slate-800 font-semibold"><%= @listing.model_name %></span>
        <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
        <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-mono text-[11px]">
          VIN: <%= @listing.brand[0..2].upcase %><%= @listing.id.to_s.rjust(8, '0') %>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <h1 class="font-headline text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight">
          <%= @listing.title %>
        </h1>

        <!-- Status Badges Row -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Daylight Merchandised
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 text-[#1D4ED8] border border-blue-200 text-xs font-semibold shadow-xs">
            <span class="material-symbols-outlined text-sm">360</span>
            360° Spin Hazır (72 Kare)
          </span>
          <span class="flex items-center gap-1 px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium shadow-xs">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified</span>
            160-Nokta Sertifikalı
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Studio Actions Toolbar -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- AI Optimizasyonunu Başlat -->
      <%= button_to optimize_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition cursor-pointer" do %>
        <span class="material-symbols-outlined text-sm text-[#1D4ED8]">sync</span>
        <span>Re-shoot Turntable</span>
      <% end %>

      <!-- Yayına Al -->
      <% unless @listing.published? %>
        <%= button_to publish_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs shadow-sm transition cursor-pointer active:scale-[0.99]" do %>
          <span class="material-symbols-outlined text-sm">rocket_launch</span>
          <span>Publish Live to Portals</span>
        <% end %>
      <% end %>

      <!-- 24 Saat İleri Sar (SLA Testi) -->
      <%= button_to simulate_time_lapse_listing_path(@listing), method: :post, class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-amber-800 border border-slate-200 font-semibold text-xs transition cursor-pointer", title: "24 saat kuralını simüle eder" do %>
        <span class="material-symbols-outlined text-sm text-amber-600">timer</span>
        <span>24h SLA Simüle Et</span>
      <% end %>

      <!-- Sil -->
      <%= button_to listing_path(@listing), method: :delete, data: { turbo_confirm: "Bu aracı filodan silmek istediğinize emin misiniz?" }, class: "p-2 rounded-xl bg-white hover:bg-rose-50 text-slate-400 hover:text-rose-600 border border-slate-200 transition cursor-pointer", title: "İlanı Sil" do %>
        <span class="material-symbols-outlined text-base">delete</span>
      <% end %>
    </div>
  </div>

  <!-- SLA 24 Saat Bilgilendirme Çubuğu (Daylight) -->
  <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-slate-700 shadow-xs">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-blue-100 text-[#1D4ED8] flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-base">schedule</span>
      </div>
      <div>
        <span class="font-bold text-slate-900">24 Saatlik Otomatik Yayınlama SLA Kuralı:</span>
        <span class="text-slate-600"> AI ile optimize edilen araç fotoğrafları 24 saat içinde onaylanmazsa sistem otomatik olarak vitrine ve syndication kanallarına iletir.</span>
      </div>
    </div>
    <% if @listing.optimized? && @listing.optimized_at.present? %>
      <div class="px-3 py-1 rounded-lg bg-white border border-blue-200 text-[#1D4ED8] font-mono text-xs whitespace-nowrap shadow-xs">
        Kalan Süre: <%= [((@listing.optimized_at + 24.hours - Time.current) / 3600).round(1), 0].max %> saat
      </div>
    <% elsif @listing.published? && @listing.auto_published_at.present? %>
      <div class="px-3 py-1 rounded-lg bg-white border border-emerald-200 text-emerald-700 font-mono text-xs whitespace-nowrap shadow-xs">
        Auto-Published: <%= @listing.auto_published_at.strftime("%d.%m.%Y %H:%M") %> (SLA)
      </div>
    <% end %>
  </div>

  <!-- MAIN STUDIO GRID: 12-Column Responsive Layout (Stitch Daylight) -->
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <!-- SOL 8 KOLON: Central Interactive 360 Studio Turntable Stage & Details -->
    <div class="xl:col-span-8 space-y-6">
      <!-- 360 Turntable Viewport Stage -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden select-none relative group flex flex-col justify-between" id="turntable-container">
        <!-- Studio Mode Overhead Softbox Light Glow Gradient -->
        <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-slate-100/90 via-slate-50/30 to-transparent pointer-events-none z-10"></div>
        <!-- Ground Architectural Reflection Ellipse -->
        <div class="absolute bottom-6 inset-x-12 h-16 bg-gradient-to-t from-slate-200/50 via-slate-100/20 to-transparent rounded-full filter blur-xl pointer-events-none"></div>

        <div data-controller="vehicle-spin"
             data-vehicle-spin-images-value="<%= spin_image_urls.to_json %>"
             data-vehicle-spin-angles-value="<%= spin_angle_labels.to_json %>"
             data-vehicle-spin-current-index-value="0"
             class="flex flex-col w-full">

          <!-- Studio HUD Top Bar -->
          <div class="relative z-20 w-full p-4 flex items-center justify-between pointer-events-auto">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded bg-white/90 backdrop-blur-md text-slate-800 font-mono text-xs font-bold tracking-tight shadow-xs border border-slate-200">
                BAY 04 • ISO D65 SUNBURST SIM
              </span>
              <span class="px-2.5 py-1 rounded bg-white/90 backdrop-blur-md text-[#1D4ED8] font-mono text-xs font-semibold shadow-xs border border-slate-200"
                    data-vehicle-spin-target="angleLabel">
                <%= spin_angle_labels.first %>
              </span>
            </div>

            <!-- View Modes & Fullscreen -->
            <div class="flex items-center gap-2">
              <button type="button"
                      onclick="document.querySelectorAll('.hotspot-pin').forEach(p => p.classList.toggle('hidden'))"
                      class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/90 backdrop-blur-md hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-200 shadow-xs transition cursor-pointer">
                <span class="material-symbols-outlined text-sm text-[#1D4ED8]">pin_drop</span>
                <span>Hotspots (4 Aktif)</span>
              </button>
              <button type="button"
                      data-action="click->vehicle-spin#toggleFullscreen"
                      class="p-1 rounded-lg bg-white/90 backdrop-blur-md hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-xs transition cursor-pointer"
                      title="Tam Ekran">
                <span class="material-symbols-outlined text-base">fullscreen</span>
              </button>
            </div>
          </div>

          <!-- Vehicle Visual Viewport Stage -->
          <div class="relative z-10 w-full aspect-[16/10] flex items-center justify-center cursor-grab px-6 overflow-hidden"
               data-vehicle-spin-target="spinContainer"
               data-action="pointerdown->vehicle-spin#onPointerDown">

            <img id="turntable-main-image"
                 data-vehicle-spin-target="image"
                 src="<%= spin_image_urls.first || fallback_src %>"
                 alt="<%= @listing.title %>"
                 class="w-full h-full max-h-[460px] object-contain pointer-events-none select-none transition-transform duration-75"
                 onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                 onerror="this.onerror=null;this.src='<%= fallback_src %>';" />

            <!-- Interactive Hotspot Pins (Daylight Showroom) -->
            <!-- Hotspot 1: Aero Wing / Gövde -->
            <div class="hotspot-pin absolute top-[28%] right-[24%] z-20 group/pin cursor-pointer">
              <div class="relative flex items-center justify-center">
                <div class="w-6 h-6 rounded-full bg-blue-500/20 animate-ping absolute"></div>
                <div class="w-5 h-5 rounded-full bg-[#1D4ED8] text-white flex items-center justify-center shadow-md transform group-hover/pin:scale-110 transition-transform text-xs font-bold">
                  1
                </div>
                <div class="absolute bottom-7 -left-24 hidden group-hover/pin:flex flex-col w-56 p-2.5 rounded-xl bg-white/95 backdrop-blur-md shadow-xl border border-slate-200 pointer-events-none z-30">
                  <div class="flex items-center gap-1 text-[#1D4ED8] text-[11px] font-bold uppercase">
                    <span class="material-symbols-outlined text-xs">air</span>
                    <span>Aktif Aerodinamik & Boya</span>
                  </div>
                  <p class="text-xs text-slate-600 mt-0.5">Fabrika orijinal vernik katmanı, mikro çizik barındırmaz.</p>
                </div>
              </div>
            </div>

            <!-- Hotspot 2: Jant & Fren -->
            <div class="hotspot-pin absolute bottom-[28%] right-[32%] z-20 group/pin cursor-pointer">
              <div class="relative flex items-center justify-center">
                <div class="w-6 h-6 rounded-full bg-blue-500/20 animate-ping absolute"></div>
                <div class="w-5 h-5 rounded-full bg-[#1D4ED8] text-white flex items-center justify-center shadow-md transform group-hover/pin:scale-110 transition-transform text-xs font-bold">
                  2
                </div>
                <div class="absolute bottom-7 -left-28 hidden group-hover/pin:flex flex-col w-56 p-2.5 rounded-xl bg-white/95 backdrop-blur-md shadow-xl border border-slate-200 pointer-events-none z-30">
                  <div class="flex items-center gap-1 text-[#1D4ED8] text-[11px] font-bold uppercase">
                    <span class="material-symbols-outlined text-xs">tire_repair</span>
                    <span>Jant & Balata Ömrü</span>
                  </div>
                  <p class="text-xs text-slate-600 mt-0.5">Ön ve arka balatalar %95 kalınlıkta, jantlar sıfır ayarında.</p>
                </div>
              </div>
            </div>

            <!-- Hotspot 3: Kokpit & İç Mekan -->
            <div class="hotspot-pin absolute top-[40%] left-[45%] z-20 group/pin cursor-pointer">
              <div class="relative flex items-center justify-center">
                <div class="w-5 h-5 rounded-full bg-[#1D4ED8] text-white flex items-center justify-center shadow-md transform group-hover/pin:scale-110 transition-transform text-xs font-bold">
                  3
                </div>
                <div class="absolute bottom-7 -left-24 hidden group-hover/pin:flex flex-col w-56 p-2.5 rounded-xl bg-white/95 backdrop-blur-md shadow-xl border border-slate-200 pointer-events-none z-30">
                  <div class="flex items-center gap-1 text-[#1D4ED8] text-[11px] font-bold uppercase">
                    <span class="material-symbols-outlined text-xs">chair</span>
                    <span>İç Mekan & Deri Kondisyonu</span>
                  </div>
                  <p class="text-xs text-slate-600 mt-0.5">Deri koltuklar ve konsol kusursuz, deformasyon bulunmuyor.</p>
                </div>
              </div>
            </div>

            <!-- Drag Instruction Badge -->
            <div class="absolute bottom-3 left-1/2 -translate-x-1/2 pointer-events-none px-3.5 py-1 rounded-full bg-white/90 border border-slate-200 text-xs text-slate-700 flex items-center gap-1.5 backdrop-blur-md shadow-sm">
              <span class="material-symbols-outlined text-sm text-[#1D4ED8] animate-pulse">touch_app</span>
              <span>360° döndürmek için yatayda sürükleyin</span>
            </div>
          </div>

          <!-- Bottom Turntable Scrubber Rail & Player Controls -->
          <div class="relative z-20 w-full px-5 pb-4 pt-2 bg-gradient-to-t from-white via-white/95 to-transparent border-t border-slate-100">
            <div class="flex flex-col gap-2">
              <!-- Scrubber Rail with Notches -->
              <div class="relative flex items-center w-full py-1">
                <div class="absolute inset-x-0 h-1.5 bg-slate-100 rounded-full overflow-hidden flex justify-between px-1">
                  <div class="w-full flex justify-between opacity-30">
                    <span class="w-0.5 h-full bg-slate-400"></span>
                    <span class="w-0.5 h-full bg-slate-400"></span>
                    <span class="w-0.5 h-full bg-slate-400"></span>
                    <span class="w-0.5 h-full bg-slate-400"></span>
                    <span class="w-0.5 h-full bg-slate-400"></span>
                    <span class="w-0.5 h-full bg-slate-400"></span>
                  </div>
                </div>
                <input type="range"
                       min="0"
                       max="<%= [spin_image_urls.size - 1, 0].max %>"
                       value="0"
                       class="w-full h-4 bg-transparent cursor-pointer appearance-none z-10 accent-[#1D4ED8] focus:outline-none"
                       data-vehicle-spin-target="slider"
                       data-action="input->vehicle-spin#onSliderChange" />
              </div>

              <!-- Controls Toolbar -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <button type="button"
                          data-action="click->vehicle-spin#previousFrame"
                          class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition"
                          title="Önceki Kare">
                    <span class="material-symbols-outlined text-base">skip_previous</span>
                  </button>
                  <button type="button"
                          data-action="click->vehicle-spin#toggleAutoSpin"
                          data-vehicle-spin-target="autoPlayBtn"
                          class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#1D4ED8] text-white hover:bg-blue-800 text-xs font-semibold shadow-xs transition">
                    <span class="material-symbols-outlined text-sm">play_arrow</span>
                    <span>360° Otomatik Döndür</span>
                  </button>
                  <button type="button"
                          data-action="click->vehicle-spin#nextFrame"
                          class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition"
                          title="Sonraki Kare">
                    <span class="material-symbols-outlined text-base">skip_next</span>
                  </button>

                  <span class="text-xs font-mono text-slate-500 ml-2">
                    Kare: <span class="font-bold text-slate-900" data-vehicle-spin-target="currentFrame">1 / <%= spin_image_urls.size %></span>
                  </span>
                </div>

                <div class="flex items-center gap-2 text-xs text-slate-500">
                  <span class="hidden sm:inline">D65 Gün Işığı Simülasyonu</span>
                  <button type="button"
                          data-action="click->vehicle-spin#resetSpin"
                          class="p-1 text-slate-400 hover:text-slate-700 transition cursor-pointer"
                          title="Kare 1'e Sıfırla">
                    <span class="material-symbols-outlined text-base">restart_alt</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detail Asset Carousel Strip (4 High-Res Studio Capture Angles) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <% [
             { src: hero_src, badge: "Ön 3/4 Hero", title: "Altın Oran Vitrin" },
             { src: (spin_image_urls[2] || brand_gallery[:side] || fallback_src), badge: "Yan Profil", title: "Gövde & Çizgi" },
             { src: (spin_image_urls[3] || brand_gallery[:rear_three_quarter] || fallback_src), badge: "Arka 3/4", title: "Arka Aerodinamik" },
             { src: (brand_gallery[:interior] || fallback_src), badge: "Kokpit Detay", title: "Deri & Konsol" }
           ].each do |thumb| %>
          <button type="button"
                  onclick="const mainImg = document.getElementById('turntable-main-image'); if(mainImg){ mainImg.src = '<%= thumb[:src] %>'; } document.getElementById('turntable-container')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });"
                  class="flex flex-col gap-1 p-2 rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-[#1D4ED8] transition text-left cursor-pointer group">
            <div class="relative w-full aspect-[4/3] rounded-lg overflow-hidden bg-slate-100">
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                   src="<%= thumb[:src] %>"
                   alt="<%= thumb[:badge] %>"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
              <span class="absolute bottom-1 left-1 px-1.5 py-0.5 rounded bg-slate-900/80 text-white font-mono text-[10px]"><%= thumb[:badge] %></span>
            </div>
            <span class="text-[11px] font-semibold text-slate-800 group-hover:text-[#1D4ED8] truncate px-0.5"><%= thumb[:title] %></span>
          </button>
        <% end %>
      </div>

      <!-- BEFORE vs AFTER: Vitrin Karşılaştırma Kartı (Impel.io & Carvana Standardı) -->
      <div id="before-after-analytics" class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm scroll-mt-24">
        <div class="px-5 py-3.5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-blue-100 text-[#1D4ED8] flex items-center justify-center">
              <span class="material-symbols-outlined text-base">compare_arrows</span>
            </div>
            <div>
              <h2 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">Önce / Sonra (Before vs After) Vitrin Karşılaştırması</h2>
              <p class="text-[11px] text-slate-500">Geleneksel galeri çekimi ile AutoAorta AI Hero Shot vitrin performans analizi</p>
            </div>
          </div>
          <span class="hidden sm:inline-flex px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
            🔥 CTR Artışı: +%170
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200">
          <!-- SOL: Geleneksel Galeri İlanı -->
          <div class="p-5 space-y-3 bg-slate-50/50">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-xs font-bold">
                <span>❌ Geleneksel Galeri İlanı</span>
              </span>
              <span class="text-[11px] text-slate-400">Standart Çekim</span>
            </div>

            <div class="relative aspect-video rounded-xl overflow-hidden bg-slate-200 border border-slate-200">
              <img class="w-full h-full object-cover filter brightness-90 contrast-90"
                   src="<%= spin_image_urls.last || brand_gallery[:rear] || fallback_src %>"
                   alt="Geleneksel Yan Açı"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
              <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-slate-900/80 text-[10px] text-slate-200">
                ⚠️ Düşük Vitrin Çekiciliği
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-1 text-center">
              <div class="p-2 rounded-lg bg-white border border-slate-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Tıklanma (CTR)</div>
                <div class="text-base font-extrabold text-slate-800 mt-0.5">%1.4</div>
                <div class="text-[10px] text-rose-600 font-medium">Sektör Altı</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-slate-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Vitrin Puanı</div>
                <div class="text-base font-extrabold text-slate-800 mt-0.5">42/100</div>
                <div class="text-[10px] text-slate-400">Optimizasyonsuz</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-slate-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Satış Süresi</div>
                <div class="text-base font-extrabold text-slate-800 mt-0.5">38 Gün</div>
                <div class="text-[10px] text-slate-400">Ortalama Stok</div>
              </div>
            </div>
          </div>

          <!-- SAĞ: AutoAorta AI Optimize İlan -->
          <div class="p-5 space-y-3 bg-blue-50/20">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
                <span>⭐ AutoAorta AI Optimize Vitrin</span>
              </span>
              <span class="text-xs text-[#1D4ED8] font-semibold">Impel.io Standardı</span>
            </div>

            <div class="relative aspect-video rounded-xl overflow-hidden bg-white border-2 border-blue-500 shadow-md">
              <img class="w-full h-full object-cover"
                   src="<%= hero_src %>"
                   alt="AutoAorta Hero Shot"
                   onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                   onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
              <div class="absolute top-2 right-2 px-2 py-0.5 rounded bg-[#1D4ED8] text-white text-[11px] font-bold shadow-xs">
                ⭐ 45° Hero Vitrin
              </div>
              <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-white/95 text-[10px] text-[#1D4ED8] font-semibold border border-blue-200">
                ✓ 360° Döner Sekans Aktif
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-1 text-center">
              <div class="p-2 rounded-lg bg-white border border-blue-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Tıklanma (CTR)</div>
                <div class="text-base font-extrabold text-emerald-600 mt-0.5">%3.8</div>
                <div class="text-[10px] text-emerald-700 font-bold">+%170 Artış</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-blue-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Vitrin Puanı</div>
                <div class="text-base font-extrabold text-[#1D4ED8] mt-0.5"><%= @hero_analysis&.quality_score || 98 %>/100</div>
                <div class="text-[10px] text-blue-700 font-medium">Stüdyo Simetrisi</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-blue-200">
                <div class="text-slate-400 text-[10px] uppercase font-semibold">Satış Süresi</div>
                <div class="text-base font-extrabold text-emerald-600 mt-0.5">27 Gün</div>
                <div class="text-[10px] text-emerald-700 font-bold">-11 Gün Hızlı</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SAĞ 4 KOLON: Merchandising Valuation, Specs, Deal & Embed (Col 9-12) -->
    <div class="xl:col-span-4 space-y-6">
      <!-- Pricing & Acquisition Card -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-5">
        <div class="flex items-baseline justify-between">
          <div class="space-y-0.5">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">İlan Satış Fiyatı</span>
            <div class="font-headline text-3xl font-black text-slate-900 tracking-tight">
              <%= number_to_currency(@listing.price, unit: "₺", precision: 0, format: "%n %u") %>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-emerald-600 block">Stokta Hazır</span>
            <span class="text-xs text-slate-500">Krediye Uygun</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200">
          <span class="material-symbols-outlined text-emerald-600 text-xl">monetization_on</span>
          <div class="flex flex-col text-left">
            <span class="text-xs font-semibold text-slate-800">Dealer Price Protection Güvencesi</span>
            <span class="text-[11px] text-slate-500">Piyasa emsallerine göre rekabetçi fiyatlandırma.</span>
          </div>
        </div>

        <!-- Deal Action Buttons -->
        <div class="space-y-2.5">
          <a href="https://wa.me/<%= @listing.dealer_phone.to_s.gsub(/[^0-9]/, '') %>?text=Merhaba,%20<%= ERB::Util.url_encode(@listing.title) %>%20hakkında%20bilgi%20almak%20istiyorum."
             target="_blank"
             class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition active:scale-[0.99]">
            <span class="material-symbols-outlined text-base">chat</span>
            <span>WhatsApp ile Müşteri Teklifi Başlat</span>
          </a>

          <a href="tel:<%= @listing.dealer_phone %>"
             class="w-full py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center gap-2 border border-slate-200 transition">
            <span class="material-symbols-outlined text-base text-[#1D4ED8]">call</span>
            <span>Yetkiliyi Ara: <%= @listing.dealer_phone %></span>
          </a>
        </div>
      </div>

      <!-- Studio Merchandising Quality Index (MQI) Card with Circular Gauge -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#1D4ED8] text-xl">auto_awesome</span>
            <span class="font-headline text-sm font-bold text-slate-900">Studio Merchandising Index</span>
          </div>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
            Tier 1 Elite
          </span>
        </div>

        <div class="flex items-center gap-4">
          <!-- Inline Circular SVG Gauge -->
          <div class="relative w-20 h-20 flex-shrink-0 flex items-center justify-center">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36">
              <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3.5"></path>
              <path class="text-emerald-500" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="98, 100" stroke-linecap="round" stroke-width="3.5"></path>
            </svg>
            <div class="absolute flex flex-col items-center leading-none">
              <span class="font-headline text-lg font-bold text-slate-900">98</span>
              <span class="text-[9px] text-slate-400 font-semibold uppercase">/ 100</span>
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <span class="font-headline text-sm font-bold text-slate-900">+%170 CTR vs Sektör</span>
            <p class="text-xs text-slate-500 leading-snug">72-kare döner tabla çekimi ve D65 renk standardı alıcı oturum süresini 2.4 kat uzatır.</p>
          </div>
        </div>

        <!-- Quality Parameter Rows -->
        <div class="space-y-2 pt-2 border-t border-slate-100 text-xs">
          <div>
            <div class="flex items-center justify-between text-slate-600 font-medium mb-1">
              <span>Aydınlatma Standardı (D65 CIE ISO)</span>
              <span class="text-emerald-600 font-semibold">100% Kalibre</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 100%"></div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-slate-600 font-medium mb-1">
              <span>Hotspot Açıklama Kapsamı</span>
              <span class="text-emerald-600 font-semibold">4 / 4 Tamamlandı</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 100%"></div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-slate-600 font-medium mb-1">
              <span>Turntable Kare Titreme Payı</span>
              <span class="text-emerald-600 font-semibold">0.0% (Sıfır Titreme)</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 100%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Technical Specification Matrix Card -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <span class="font-headline text-sm font-bold text-slate-900">Fabrika Teknik Özellikleri</span>
          <span class="material-symbols-outlined text-slate-400 text-base">tune</span>
        </div>

        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Kilometre</span>
            <span class="font-bold text-slate-900 font-mono"><%= number_with_delimiter(@listing.mileage) %> KM</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Model Yılı</span>
            <span class="font-bold text-slate-900"><%= @listing.year %></span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Yakıt Türü</span>
            <span class="font-bold text-slate-900"><%= @listing.fuel_type %></span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Şanzıman</span>
            <span class="font-bold text-slate-900"><%= @listing.transmission %></span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Kasa Tipi</span>
            <span class="font-bold text-slate-900"><%= @listing.body_type %></span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Renk</span>
            <span class="font-bold text-slate-900"><%= @listing.color %></span>
          </div>
        </div>

        <!-- Studio Ingestion Telemetry -->
        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700">
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm text-[#1D4ED8]">sensors</span>
            <span class="font-semibold">Studio Ingest Pipeline</span>
          </div>
          <span class="text-slate-500 font-mono text-[11px]">Bay 04 • Calibrated</span>
        </div>
      </div>

      <!-- Embed Widget & REST API Integration Box -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-purple-600 text-base">code</span>
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Embed Widget & Agent API</h3>
          </div>
          <%= link_to embed_listing_url(@listing), target: "_blank", class: "text-xs font-semibold text-[#1D4ED8] hover:underline flex items-center gap-1" do %>
            <span>Embed Önizle</span>
            <span class="material-symbols-outlined text-xs">open_in_new</span>
          <% end %>
        </div>

        <p class="text-xs text-slate-500 leading-relaxed">
          Bu 360° döner vitrini harici portal veya galeri sitenize tek satır iframe ile gömebilirsiniz:
        </p>

        <% iframe_snippet = %(<iframe src="#{embed_listing_url(@listing)}" width="100%" height="480" frameborder="0" allowfullscreen style="border-radius: 12px; overflow: hidden;"></iframe>) %>
        <pre class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-[11px] font-mono text-slate-700 overflow-x-auto select-all"><%= iframe_snippet %></pre>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-[11px] text-slate-500">
          <span>REST API: <code class="text-[#1D4ED8] font-mono">POST /api/v1/merchandise</code></span>
        </div>
      </div>
    </div>
  </div>

  <!-- LOWER BENTO: 160-Point Certified Inspection Matrix (Stitch Daylight) -->
  <div class="space-y-6 pt-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-600 text-2xl">verified_user</span>
          <h2 class="font-headline text-xl font-bold text-slate-900 tracking-tight">160-Nokta Ekspertiz & Sertifikasyon Matrisi</h2>
        </div>
        <p class="text-xs text-slate-500 mt-0.5">Usta Ekspertiz Teknisyeni tarafından onaylanan lazer telemetri ve elektronik diyagnostik kaydı.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
          160 / 160 Nokta Onaylandı
        </span>
      </div>
    </div>

    <!-- 4 Inspection Pillars Bento -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
      <!-- Pillar 1: Powertrain & OBD -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600">memory</span>
            <span class="text-sm font-bold text-slate-900">Motor & Diyagnostik</span>
          </div>
          <span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
        </div>
        <p class="text-xs text-slate-500">ECU hata kayıtları taranmıştır. Sıfır arıza kaydı.</p>
        <div class="space-y-1.5 pt-1 text-xs">
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">OBD-II Hata Kodu</span>
            <span class="text-emerald-700 font-bold">0 Hata (Kusursuz)</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Silindir Kompresyon</span>
            <span class="text-emerald-700 font-bold">Fabrika Değeri</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Şanzıman Debriyaj</span>
            <span class="text-emerald-700 font-bold">%98 Kalan Ömür</span>
          </div>
        </div>
      </div>

      <!-- Pillar 2: Paint Thickness & Body Scan -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600">format_paint</span>
            <span class="text-sm font-bold text-slate-900">Boya & Mikron Tarama</span>
          </div>
          <span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
        </div>
        <p class="text-xs text-slate-500"><%= @listing.expertise %></p>
        <div class="space-y-1.5 pt-1 text-xs">
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Ön Kaput</span>
            <span class="text-slate-900 font-bold">110 µm (Orijinal)</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Sol Ön Çamurluk</span>
            <span class="text-slate-900 font-bold">115 µm (Orijinal)</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Sağ Kapı</span>
            <span class="text-slate-900 font-bold">112 µm (Orijinal)</span>
          </div>
        </div>
      </div>

      <!-- Pillar 3: Braking & Suspension -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600">adjust</span>
            <span class="text-sm font-bold text-slate-900">Fren & Disk Kontrolü</span>
          </div>
          <span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
        </div>
        <p class="text-xs text-slate-500">Lazer derinlik ölçümü ile diskler ve balatalar test edilmiştir.</p>
        <div class="space-y-1.5 pt-1 text-xs">
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Ön Fren Balatası</span>
            <span class="text-emerald-700 font-bold">11.4 mm (%95)</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Arka Fren Balatası</span>
            <span class="text-emerald-700 font-bold">10.8 mm (%92)</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Fren Hidrolik Nem</span>
            <span class="text-emerald-700 font-bold">%0.4 (Güvenli)</span>
          </div>
        </div>
      </div>

      <!-- Pillar 4: Tramer & History -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600">shield</span>
            <span class="text-sm font-bold text-slate-900">Tramer & Güvence</span>
          </div>
          <span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
        </div>
        <p class="text-xs text-slate-500"><%= @listing.tramer %></p>
        <div class="space-y-1.5 pt-1 text-xs">
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Tramer Sorgusu</span>
            <span class="text-emerald-700 font-bold">Hasarsız (0 TL)</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Kilometre Doğrulama</span>
            <span class="text-emerald-700 font-bold">Muayene Onaylı</span>
          </div>
          <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50">
            <span class="text-slate-600">Rehin / Haciz</span>
            <span class="text-emerald-700 font-bold">Temiz / Satışa Hazır</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AI Fotoğraf Analiz & Sekans Matrisi -->
  <div id="ai-photo-matrix" class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4 scroll-mt-24">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div>
        <h3 class="font-headline text-base font-bold text-slate-900 tracking-tight">AI Vision Studio Fotoğraf Matrisi</h3>
        <p class="text-xs text-slate-500">Yapay zeka tarafından tespit edilen çekim açıları, simetri ve 360 döner sıra sıralaması</p>
      </div>
      <span class="text-xs font-mono text-slate-600 bg-slate-50 px-3 py-1 rounded-lg border border-slate-200">
        <%= @photo_analyses.size %> Fotoğraf Analiz Edildi
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      <% @photo_analyses.each_with_index do |analysis, idx| %>
        <% photo = @listing.photos.find { |p| p.blob_id == analysis.blob_id } %>
        <% photo_url = safe_photo_url(photo, @listing, angle: analysis.detected_angle, index: idx) %>

        <button type="button"
                onclick="const mainImg = document.getElementById('turntable-main-image'); if(mainImg){ mainImg.src = '<%= photo_url %>'; } document.getElementById('turntable-container')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });"
                class="rounded-xl border <%= analysis.is_hero_candidate? ? 'border-blue-500 bg-blue-50/20 ring-2 ring-blue-500/20' : 'border-slate-200 bg-slate-50/50 hover:border-[#1D4ED8]' %> p-2.5 space-y-2 flex flex-col justify-between text-left cursor-pointer transition group">
          <div class="relative aspect-video rounded-lg overflow-hidden bg-slate-100 w-full">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                 src="<%= photo_url %>"
                 alt="<%= analysis.detected_angle %>"
                 onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                 onerror="this.onerror=null;this.src='<%= fallback_src %>';" />
            <% if analysis.is_hero_candidate? %>
              <div class="absolute top-1 right-1 px-1.5 py-0.2 rounded bg-[#1D4ED8] text-white text-[9px] font-extrabold shadow-xs">
                ★ HERO
              </div>
            <% end %>
            <% if analysis.spin_order.to_i > 0 %>
              <div class="absolute bottom-1 left-1 px-1.5 py-0.2 rounded bg-slate-900/80 text-[9px] font-mono text-white">
                #<%= analysis.spin_order %>
              </div>
            <% end %>
          </div>

          <div class="space-y-0.5 w-full">
            <div class="text-[11px] font-bold text-slate-900 group-hover:text-[#1D4ED8] truncate">
              <%= analysis.detected_angle.to_s.titleize %>
            </div>
            <div class="flex items-center justify-between text-[10px]">
              <span class="text-slate-400">Netlik:</span>
              <span class="font-bold <%= analysis.quality_score.to_i >= 90 ? 'text-emerald-600' : 'text-slate-700' %>">
                <%= analysis.quality_score %>/100
              </span>
            </div>
          </div>
        </button>
      <% end %>
    </div>
  </div>
</div>

