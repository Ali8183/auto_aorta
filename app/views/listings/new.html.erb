<div class="max-w-4xl mx-auto space-y-8">
  <!-- Top Navigation & Header -->
  <div class="space-y-1">
    <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
      <%= link_to "Inventory & Merchandising", root_path, class: "hover:text-[#1D4ED8] transition" %>
      <span class="material-symbols-outlined text-xs text-slate-300">chevron_right</span>
      <span class="text-slate-800 font-semibold">Yeni Araç & AI Studio Ingest</span>
    </div>
    <h1 class="font-headline text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Yeni Araç İlanı Ekle</h1>
    <p class="text-sm text-slate-500">
      Araç bilgilerini ve ticari kondisyonu girin. AutoAorta AI motoru 360° döner vitrin sekansını ve altın oran Hero Shot vitrin açısını otomatik oluşturacaktır.
    </p>
  </div>

  <!-- Form Container -->
  <%= form_with model: @listing, local: true, class: "space-y-8" do |f| %>
    <% if @listing.errors.any? %>
      <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm space-y-1 shadow-xs">
        <div class="font-bold">Lütfen formdaki hataları düzeltin:</div>
        <ul class="list-disc list-inside text-xs space-y-0.5">
          <% @listing.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Card 1: Temel Bilgiler & Ticari Özellikler -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-6 shadow-sm">
      <h2 class="font-headline text-lg font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-blue-50 text-[#1D4ED8] border border-blue-200 flex items-center justify-center text-xs font-black">1</span>
        <span>Araç Tanımı & Ticari Bilgiler</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :title, "İlan Başlığı", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :title, placeholder: "Örn: 2023 BMW 320i M Sport Hatasız Stüdyo Çekim", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :brand, "Marka", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :brand, placeholder: "BMW, Tesla, Porsche, Mercedes-Benz...", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :model_name, "Model / Seri", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :model_name, placeholder: "Örn: 320i Sedan M Sport", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :year, "Model Yılı", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.number_field :year, placeholder: "2023", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :price, "Fiyat (₺)", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.number_field :price, placeholder: "2950000", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :mileage, "Kilometre (km)", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.number_field :mileage, placeholder: "18400", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :fuel_type, "Yakıt Türü", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.select :fuel_type, ["Benzin", "Elektrik", "Hibrit", "Dizel"], {}, class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :transmission, "Vites Türü", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.select :transmission, ["Otomatik", "Manuel", "Yarı Otomatik"], {}, class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :color, "Renk", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :color, placeholder: "Örn: Mineral Gri, İnci Beyazı...", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :body_type, "Kasa Tipi", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.select :body_type, ["Sedan", "SUV", "Hatchback", "Coupe", "Cabriolet"], {}, class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :expertise, "Ekspertiz Durumu", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :expertise, placeholder: "Hatasız / Boyasız / Değişensiz", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :tramer, "Tramer Durumu", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :tramer, placeholder: "Hasar Kaydı Yok / 0 TL", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :dealer_name, "Galeri / Satıcı Adı", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :dealer_name, placeholder: "AutoAorta Premier Fleet", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>

        <div>
          <%= f.label :dealer_phone, "Satıcı Telefonu / WhatsApp", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_field :dealer_phone, placeholder: "+90 532 500 40 30", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
        </div>
      </div>

      <div>
        <%= f.label :description, "İlan Açıklaması", class: "block text-xs font-semibold text-slate-700 mb-1.5" %>
        <%= f.text_area :description, rows: 4, placeholder: "Aracın durumu, opsiyonları, servis geçmişi ve donanım paketleri...", class: "w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 transition" %>
      </div>
    </div>

    <!-- Card 2: AI Stüdyo & Toplu Fotoğraf Yükleme -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="font-headline text-lg font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center text-xs font-black">2</span>
            <span>AI Studio Fotoğraf Yükleme (360° Açı & Vitrin Analizi)</span>
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Aracın etrafında çekilmiş dış fotoğraflarını ve iç mekan fotoğraflarını topluca seçiniz.
          </p>
        </div>
        <span class="px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#1D4ED8] text-xs font-semibold">
          Otomatik 360° Sıralama
        </span>
      </div>

      <!-- AI Feature Callout -->
      <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-200 flex items-start gap-3 text-xs text-slate-700">
        <span class="material-symbols-outlined text-[#1D4ED8] text-lg mt-0.5">auto_awesome</span>
        <div class="leading-relaxed">
          <span class="font-bold text-slate-900">Yapay Zeka Nasıl Çalışır?</span> Fotoğraflar yüklendiğinde, Multimodal Vision motorumuz açıları otomatik tanır (Ön 3/4, Ön, Yan, Arka 3/4, Arka, Kokpit). Stüdyo simetri puanıyla en kusursuz Ön 3/4 açılı kareyi <span class="text-[#1D4ED8] font-semibold">Hero Shot</span> olarak vitrine atar ve dış çekimleri 360° döner sekansa bağlar.
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2">Fotoğrafları Seçin (Birden Fazla Dosya Yüklenebilir)</label>
        <div class="flex justify-center px-6 pt-5 pb-6 border-2 border-slate-200 border-dashed rounded-2xl hover:border-[#1D4ED8] transition bg-slate-50/60">
          <div class="space-y-2 text-center">
            <span class="material-symbols-outlined text-4xl text-slate-400">cloud_upload</span>
            <div class="text-sm text-slate-600">
              <label for="listing_photos" class="relative cursor-pointer rounded-md font-semibold text-[#1D4ED8] hover:underline focus-within:outline-none">
                <span>Fotoğrafları Seç</span>
                <%= f.file_field :photos, multiple: true, accept: "image/*", class: "sr-only", id: "listing_photos" %>
              </label>
              <span class="pl-1">veya sürükleyip bırakın</span>
            </div>
            <p class="text-[11px] text-slate-400">PNG, JPG, WEBP formatları desteklenir</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Submit Toolbar -->
    <div class="flex items-center justify-end gap-3 pt-2">
      <%= link_to "İptal", root_path, class: "px-5 py-3 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition" %>
      <%= f.submit "İlanı Kaydet & AI Stüdyoyu Başlat", class: "px-6 py-3 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-bold text-xs shadow-sm transition cursor-pointer" %>
    </div>
  <% end %>
</div>
