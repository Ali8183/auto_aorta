<div class="max-w-4xl mx-auto space-y-8">
  <!-- Top Navigation & Header -->
  <div class="space-y-2">
    <div class="flex items-center gap-2 text-xs text-slate-400 font-medium">
      <%= link_to "Araç Filosu", root_path, class: "hover:text-blue-400 transition" %>
      <span class="material-symbols-outlined text-xs text-slate-600">chevron_right</span>
      <span class="text-white font-semibold">Yeni İlan Ekle</span>
    </div>
    <h1 class="font-display text-2xl sm:text-4xl font-extrabold text-white tracking-tight">Yeni Araç İlanı Ekle</h1>
    <p class="text-sm text-slate-400">
      Araç bilgilerini ve ticari kondisyonu girin. AutoAorta AI motoru 360° döner vitrin sekansını ve altın oran Hero Shot vitrin açısını otomatik oluşturacaktır.
    </p>
  </div>

  <!-- Form Container -->
  <%= form_with model: @listing, local: true, class: "space-y-8" do |f| %>
    <% if @listing.errors.any? %>
      <div class="p-5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm space-y-2 shadow-xl backdrop-blur-md">
        <div class="font-bold">Lütfen formdaki hataları düzeltin:</div>
        <ul class="list-disc list-inside text-xs space-y-1">
          <% @listing.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Card 1: Temel Bilgiler & Ticari Özellikler -->
    <div class="bg-slate-900/80 rounded-3xl border border-white/[0.08] p-6 sm:p-8 space-y-6 shadow-2xl backdrop-blur-xl">
      <h2 class="font-display text-lg font-bold text-white tracking-tight flex items-center gap-3">
        <span class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center text-xs font-black">1</span>
        <span>Araç Tanımı & Ticari Bilgiler</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= f.label :title, "İlan Başlığı", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :title, placeholder: "Örn: 2023 BMW 320i M Sport Hatasız Stüdyo Çekim", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :brand, "Marka", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :brand, placeholder: "BMW, Tesla, Porsche, Mercedes-Benz...", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :model_name, "Model / Seri", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :model_name, placeholder: "Örn: 320i Sedan M Sport", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :year, "Model Yılı", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.number_field :year, placeholder: "2023", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :price, "Fiyat (₺)", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.number_field :price, placeholder: "2950000", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :mileage, "Kilometre (km)", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.number_field :mileage, placeholder: "18400", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :fuel_type, "Yakıt Türü", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.select :fuel_type, ["Benzin", "Elektrik", "Hibrit", "Dizel"], {}, class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :transmission, "Vites Türü", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.select :transmission, ["Otomatik", "Manuel", "Yarı Otomatik"], {}, class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :color, "Renk", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :color, placeholder: "Örn: Mineral Gri, İnci Beyazı...", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :body_type, "Kasa Tipi", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.select :body_type, ["Sedan", "SUV", "Hatchback", "Coupe", "Cabriolet"], {}, class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :expertise, "Ekspertiz Durumu", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :expertise, placeholder: "Hatasız / Boyasız / Değişensiz", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :tramer, "Tramer Durumu", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :tramer, placeholder: "Hasar Kaydı Yok / 0 TL", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :dealer_name, "Galeri / Satıcı Adı", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :dealer_name, placeholder: "AutoAorta Premier Fleet", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>

        <div>
          <%= f.label :dealer_phone, "Satıcı Telefonu / WhatsApp", class: "block text-xs font-semibold text-slate-300 mb-2" %>
          <%= f.text_field :dealer_phone, placeholder: "+90 532 500 40 30", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
        </div>
      </div>

      <div>
        <%= f.label :description, "İlan Açıklaması", class: "block text-xs font-semibold text-slate-300 mb-2" %>
        <%= f.text_area :description, rows: 4, placeholder: "Aracın durumu, opsiyonları, servis geçmişi ve donanım paketleri...", class: "w-full rounded-2xl bg-slate-950/80 border border-white/10 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" %>
      </div>
    </div>

    <!-- Card 2: AI Stüdyo & Toplu Fotoğraf Yükleme -->
    <div class="bg-slate-900/80 rounded-3xl border border-white/[0.08] p-6 sm:p-8 space-y-6 shadow-2xl backdrop-blur-xl">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="font-display text-lg font-bold text-white tracking-tight flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xs font-black">2</span>
            <span>AI Studio Fotoğraf Yükleme (360° Açı & Vitrin Analizi)</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Aracın etrafında çekilmiş dış fotoğraflarını ve iç mekan fotoğraflarını topluca seçiniz.
          </p>
        </div>
        <span class="px-3.5 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold">
          Otomatik 360° Sıralama
        </span>
      </div>

      <!-- AI Feature Callout -->
      <div class="p-5 rounded-2xl bg-blue-500/[0.05] border border-blue-500/20 flex items-start gap-3.5 text-xs text-slate-300">
        <span class="material-symbols-outlined text-blue-400 text-xl mt-0.5">auto_awesome</span>
        <div class="leading-relaxed">
          <span class="font-bold text-white">Yapay Zeka Nasıl Çalışır?</span> Fotoğraflar yüklendiğinde, Multimodal Vision motorumuz açıları otomatik tanır (Ön 3/4, Ön, Yan, Arka 3/4, Arka, Kokpit). Stüdyo simetri puanıyla en kusursuz Ön 3/4 açılı kareyi <span class="text-blue-400 font-semibold">Hero Shot</span> olarak vitrine atar ve dış çekimleri 360° döner sekansa bağlar.
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-2.5">Fotoğrafları Seçin (Birden Fazla Dosya Yüklenebilir)</label>
        <div class="flex justify-center px-6 pt-8 pb-8 border-2 border-white/10 border-dashed rounded-3xl hover:border-blue-500/50 transition bg-slate-950/60">
          <div class="space-y-2.5 text-center">
            <span class="material-symbols-outlined text-5xl text-slate-500">cloud_upload</span>
            <div class="text-sm text-slate-300">
              <label for="listing_photos" class="relative cursor-pointer rounded-md font-semibold text-blue-400 hover:text-blue-300 focus-within:outline-none">
                <span>Fotoğrafları Seç</span>
                <%= f.file_field :photos, multiple: true, accept: "image/*", class: "sr-only", id: "listing_photos" %>
              </label>
              <span class="pl-1">veya sürükleyip bırakın</span>
            </div>
            <p class="text-[11px] text-slate-500">PNG, JPG, WEBP formatları desteklenir</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Submit Toolbar -->
    <div class="flex items-center justify-end gap-3 pt-2">
      <%= link_to "İptal", root_path, class: "px-6 py-3.5 rounded-2xl bg-white/[0.05] border border-white/10 hover:bg-white/10 text-slate-300 hover:text-white text-xs font-semibold transition" %>
      <%= f.submit "İlanı Kaydet & AI Stüdyoyu Başlat", class: "px-8 py-3.5 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs shadow-lg shadow-blue-600/30 transition cursor-pointer active:scale-95" %>
    </div>
  <% end %>
</div>
