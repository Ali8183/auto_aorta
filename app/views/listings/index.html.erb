<div class="space-y-8">
  <!-- Enterprise Fleet Header & B2B Metrics -->
  <div class="relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 p-8 shadow-2xl">
    <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <span>B2B Enterprise Merchandising Engine</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Araç Filosu & 360° Vitrin Yönetimi
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Carvana ve Impel.io standartlarında; araç fotoğraflarından otomatik 360° döner sekans üreten, altın oran 45° Hero Shot belirleyen ve 24 saat SLA kuralıyla çalışan kurumsal vitrin altyapısı.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to new_listing_path, class: "inline-flex items-center justify-center space-x-2 px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-xl shadow-blue-600/25 transition-all hover:scale-105" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Yeni Araç Ekle & Optimize Et</span>
        <% end %>
      </div>
    </div>

    <!-- Quick Enterprise Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 pt-8 border-t border-slate-800">
      <div class="bg-slate-950/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-slate-400 uppercase font-semibold">Toplam Filo Değeri</span>
        <div class="text-2xl font-black text-white mt-1">
          <%= number_to_currency(@listings.sum(:price), unit: "₺", precision: 0, format: "%n %u") %>
        </div>
      </div>
      <div class="bg-slate-950/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-blue-400 uppercase font-semibold">Aktif Araç Portföyü</span>
        <div class="text-2xl font-black text-blue-300 mt-1"><%= @listings.size %> Araç</div>
      </div>
      <div class="bg-slate-950/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-emerald-400 uppercase font-semibold">Tahmini CTR Artışı</span>
        <div class="text-2xl font-black text-emerald-300 mt-1">+%170</div>
      </div>
      <div class="bg-slate-950/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-amber-400 uppercase font-semibold">24h SLA Motoru</span>
        <div class="text-2xl font-black text-amber-300 mt-1">Aktif</div>
      </div>
    </div>
  </div>

  <!-- Listings Grid Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white tracking-tight">Filodaki Araçlar</h2>
      <p class="text-xs text-slate-400">Yapay zeka stüdyosu ile optimize edilmiş 360° vitrinler</p>
    </div>
    <span class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
      <%= @listings.size %> Araç Listelendi
    </span>
  </div>

  <!-- Listings Grid -->
  <% if @listings.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @listings.each do |listing| %>
        <% hero_analysis = listing.hero_photo_analysis %>
        <% hero = listing.hero_photo %>

        <div class="group bg-slate-900/90 rounded-3xl border border-slate-800 overflow-hidden hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-300 flex flex-col justify-between">
          <!-- Card Image Container -->
          <div class="relative aspect-video bg-slate-950 overflow-hidden">
            <% if hero.present? %>
              <%= image_tag hero, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", alt: listing.title %>
            <% else %>
              <div class="w-full h-full flex flex-col items-center justify-center text-slate-600 bg-slate-950">
                <svg class="w-12 h-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-xs">Fotoğraf Bekleniyor</span>
              </div>
            <% end %>

            <!-- Top Left: Hero / 360 Badge -->
            <div class="absolute top-3 left-3 flex items-center space-x-1.5">
              <span class="px-2.5 py-1 rounded-lg bg-blue-600 text-white text-[11px] font-extrabold shadow-md flex items-center space-x-1">
                <span>360° SPIN</span>
              </span>
              <% if hero_analysis %>
                <span class="px-2 py-1 rounded-lg bg-slate-900/90 text-emerald-400 text-[11px] font-bold border border-slate-800 backdrop-blur">
                  ★ <%= hero_analysis.quality_score %>/100
                </span>
              <% end %>
            </div>

            <!-- Top Right: Status Badge -->
            <div class="absolute top-3 right-3">
              <% if listing.published? %>
                <span class="px-2.5 py-1 rounded-lg bg-emerald-500 text-white text-[11px] font-extrabold shadow">
                  YAYINDA
                </span>
              <% elsif listing.optimized? %>
                <span class="px-2.5 py-1 rounded-lg bg-blue-500/90 text-white text-[11px] font-bold backdrop-blur">
                  OPTİMİZE
                </span>
              <% elsif listing.analyzing? %>
                <span class="px-2.5 py-1 rounded-lg bg-amber-500 text-white text-[11px] font-bold animate-pulse">
                  ANALİZDE
                </span>
              <% else %>
                <span class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 text-[11px]">
                  TASLAK
                </span>
              <% end %>
            </div>

            <!-- Bottom Left: Angle Tag -->
            <% if hero_analysis %>
              <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-lg bg-slate-900/90 text-slate-300 text-[10px] font-mono border border-slate-800 backdrop-blur">
                <%= hero_analysis.detected_angle.to_s.titleize %>
              </div>
            <% end %>
          </div>

          <!-- Card Content -->
          <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-semibold text-slate-300"><%= listing.brand %></span>
                <span class="font-mono"><%= listing.year %> Model</span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-blue-400 transition-colors line-clamp-1">
                <%= link_to listing.title, listing_path(listing) %>
              </h3>
            </div>

            <!-- Vehicle Specs Pills -->
            <div class="grid grid-cols-2 gap-2 text-xs text-slate-300 bg-slate-950/60 p-3 rounded-2xl border border-slate-800/80">
              <div class="flex items-center space-x-1.5">
                <span class="text-slate-500">KM:</span>
                <span class="font-bold"><%= number_with_delimiter(listing.mileage) %></span>
              </div>
              <div class="flex items-center space-x-1.5">
                <span class="text-slate-500">Vites:</span>
                <span class="font-bold"><%= listing.transmission %></span>
              </div>
              <div class="flex items-center space-x-1.5">
                <span class="text-slate-500">Kasa:</span>
                <span class="font-bold"><%= listing.body_type.presence || "Sedan" %></span>
              </div>
              <div class="flex items-center space-x-1.5">
                <span class="text-slate-500">Yakıt:</span>
                <span class="font-bold"><%= listing.fuel_type %></span>
              </div>
            </div>

            <!-- Bottom Price & Action -->
            <div class="flex items-center justify-between pt-3 border-t border-slate-800">
              <div>
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Nakit Fiyat</span>
                <div class="text-xl font-black text-white">
                  <%= number_to_currency(listing.price, unit: "₺", precision: 0, format: "%n %u") %>
                </div>
              </div>

              <%= link_to listing_path(listing), class: "inline-flex items-center space-x-1 px-4 py-2 rounded-xl bg-slate-800 hover:bg-blue-600 text-white font-semibold text-xs transition-colors" do %>
                <span>İncele</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-12 text-center space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Henüz Araç Eklenmedi</h3>
      <p class="text-slate-400 text-sm max-w-md mx-auto">
        Filoya yeni bir araç ekleyin ve AutoAorta AI Stüdyosu'nun saniyeler içinde 360° döner vitrin üretmesini izleyin.
      </p>
      <%= link_to new_listing_path, class: "inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-sm shadow-lg shadow-blue-600/30 hover:bg-blue-500 transition" do %>
        <span>İlk Aracı Ekle</span>
      <% end %>
    </div>
  <% end %>
</div>
