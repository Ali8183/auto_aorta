<div class="space-y-8">
  <!-- Studio Hero Banner / Metrics -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 border border-slate-800/80 p-8 shadow-2xl">
    <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-10 -top-10 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold tracking-wider uppercase">
          <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Automated Merchandising Engine</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          AI Vehicle Merchandising & 360° Spin Studio
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Carvana ve AutoNation standartlarında; araç fotoğraflarından otomatik 360° sanal tur sekansları üreten, stüdyo kalite puanı ile kusursuz vitrin (hero shot) belirleyen ve 24 saat SLA kurallı kurumsal platform.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to new_listing_path, class: "inline-flex items-center justify-center space-x-2 px-5 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold text-sm shadow-xl shadow-cyan-500/25 hover:from-cyan-400 hover:to-blue-500 transition-all hover:scale-105" do %>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Yeni Araç Ekle & Analiz Et</span>
        <% end %>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 pt-8 border-t border-slate-800/80">
      <div class="bg-slate-900/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-slate-400 uppercase font-semibold">Toplam İlan</span>
        <div class="text-2xl font-black text-white mt-1"><%= @listings.size %></div>
      </div>
      <div class="bg-slate-900/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-cyan-400 uppercase font-semibold">AI Optimize Edildi</span>
        <div class="text-2xl font-black text-cyan-300 mt-1"><%= @listings.count(&:optimized?) %></div>
      </div>
      <div class="bg-slate-900/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-emerald-400 uppercase font-semibold">Yayında (Canlı)</span>
        <div class="text-2xl font-black text-emerald-300 mt-1"><%= @listings.count(&:published?) %></div>
      </div>
      <div class="bg-slate-900/60 rounded-2xl p-4 border border-slate-800">
        <span class="text-xs text-amber-400 uppercase font-semibold">24h SLA Kuralı</span>
        <div class="text-2xl font-black text-amber-300 mt-1">Aktif</div>
      </div>
    </div>
  </div>

  <!-- Listings Grid Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white tracking-tight">Araç Portföyü</h2>
      <p class="text-xs text-slate-400">AI stüdyo puanı ve 360° döner sekans ile zenginleştirilmiş ilanlar</p>
    </div>
    <span class="text-xs font-mono-code text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
      <%= @listings.size %> Araç Listelendi
    </span>
  </div>

  <!-- Listings Grid -->
  <% if @listings.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @listings.each do |listing| %>
        <% hero_analysis = listing.hero_photo_analysis %>
        <% hero = listing.hero_photo %>

        <div class="group bg-slate-900/80 rounded-2xl border border-slate-800 overflow-hidden hover:border-cyan-500/50 hover:shadow-2xl hover:shadow-cyan-500/10 transition-all duration-300 flex flex-col">
          <!-- Card Image Container -->
          <div class="relative aspect-video bg-slate-950 overflow-hidden">
            <% if hero.present? %>
              <%= image_tag hero, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", alt: listing.title %>
            <% else %>
              <div class="w-full h-full flex flex-col items-center justify-center text-slate-600 bg-slate-950">
                <svg class="w-12 h-12 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-xs">Fotoğraf Yok</span>
              </div>
            <% end %>

            <!-- Top Badges Overlay -->
            <div class="absolute top-3 inset-x-3 flex items-center justify-between">
              <!-- AI Hero Shot Badge -->
              <% if hero_analysis&.is_hero_candidate? %>
                <div class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-full bg-slate-950/80 backdrop-blur-md border border-cyan-500/50 text-cyan-300 text-[11px] font-bold shadow-lg">
                  <svg class="w-3.5 h-3.5 text-cyan-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span>AI HERO SHOT (<%= hero_analysis.quality_score %>/100)</span>
                </div>
              <% else %>
                <div></div>
              <% end %>

              <!-- Status Badge -->
              <% case listing.status %>
              <% when "draft" %>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-800/90 text-slate-300 border border-slate-700 backdrop-blur-md">
                  Taslak
                </span>
              <% when "analyzing" %>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-900/90 text-blue-300 border border-blue-600 animate-pulse backdrop-blur-md">
                  Analiz Ediliyor...
                </span>
              <% when "optimized" %>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-indigo-900/90 text-indigo-300 border border-indigo-500 backdrop-blur-md">
                  AI Optimize Edildi
                </span>
              <% when "published" %>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-950/90 text-emerald-300 border border-emerald-500 backdrop-blur-md">
                  ● Yayında
                </span>
              <% end %>
            </div>

            <!-- Bottom 360 Spin Badge Overlay -->
            <% if listing.spin_photos.size > 1 %>
              <div class="absolute bottom-3 left-3 inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-slate-950/80 backdrop-blur-md border border-slate-700/80 text-[11px] font-medium text-slate-200">
                <svg class="w-3.5 h-3.5 text-cyan-400 animate-spin" style="animation-duration: 6s;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>360° Sanal Tur (<%= listing.spin_photos.size %> Açı)</span>
              </div>
            <% end %>
          </div>

          <!-- Card Content -->
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span><%= listing.brand %> &bull; <%= listing.year %></span>
                <span class="font-mono-code"><%= number_with_delimiter(listing.mileage) %> km</span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-1">
                <%= listing.title %>
              </h3>

              <div class="mt-2 text-2xl font-black text-cyan-400 tracking-tight">
                <%= number_to_currency(listing.price, unit: "₺", precision: 0, format: "%n %u") %>
              </div>
            </div>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-2 text-xs text-slate-300 py-2 border-y border-slate-800/80">
              <div class="flex items-center space-x-1.5">
                <span class="text-slate-500">Yakıt:</span>
                <span class="font-medium"><%= listing.fuel_type.presence || "Benzin" %></span>
              </div>
              <div class="flex items-center space-x-1.5">
                <span class="text-slate-500">Vites:</span>
                <span class="font-medium"><%= listing.transmission.presence || "Otomatik" %></span>
              </div>
            </div>

            <!-- Card Actions -->
            <div class="pt-1 flex items-center justify-between gap-2">
              <%= link_to listing_path(listing), class: "flex-1 inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-cyan-600 text-white font-medium text-xs transition-colors" do %>
                <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <span>360° Studio & Rapor</span>
              <% end %>

              <% if listing.optimized? %>
                <%= button_to simulate_time_lapse_listing_path(listing), method: :post, class: "p-2.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 transition text-xs font-medium", title: "24 Saat İleri Sar (SLA Testi)" do %>
                  ⏱️
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="rounded-3xl border border-dashed border-slate-800 bg-slate-900/40 p-12 text-center">
      <div class="mx-auto w-16 h-16 rounded-2xl bg-slate-800 flex items-center justify-center text-slate-500 mb-4">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Henüz Araç Eklenmedi</h3>
      <p class="text-sm text-slate-400 mt-1 max-w-md mx-auto">
        AI Studio'nun fotoğrafları analiz etmesi, 360° tur sekansları oluşturması ve vitrin açısını belirlemesi için hemen ilk aracınızı ekleyin veya seed verisini yükleyin.
      </p>
      <div class="mt-6">
        <%= link_to new_listing_path, class: "inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-white font-semibold text-sm transition" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>İlk Aracı Ekle</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
