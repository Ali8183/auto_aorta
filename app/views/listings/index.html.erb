<div class="space-y-8">
  <!-- Top Telemetry & Fleet Performance Health Ribbon (Stitch Daylight Bento) -->
  <div id="telemetry-analytics" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 scroll-mt-24">
    <!-- Metric 1: Active Inventory -->
    <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between gap-3 relative overflow-hidden group hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Aktif Araç Filosu</span>
        <span class="w-8 h-8 rounded-lg bg-blue-50 text-[#1D4ED8] flex items-center justify-center">
          <span class="material-symbols-outlined text-lg">directions_car</span>
        </span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-display text-3xl font-extrabold text-slate-900 leading-none"><%= @listings.size %></span>
        <span class="text-xs font-semibold text-emerald-600">Birim Tahsis Edildi</span>
      </div>
      <div class="flex items-center gap-1.5 text-xs text-slate-500">
        <span class="material-symbols-outlined text-emerald-600 text-base">trending_up</span>
        <span class="font-semibold text-emerald-600">+<%= @listings.size %> yeni araç</span>
        <span class="text-slate-400">son 48 saatte ingest edildi</span>
      </div>
      <div class="absolute -right-4 -bottom-4 w-16 h-16 bg-blue-500/5 rounded-full blur-xl pointer-events-none"></div>
    </div>

    <!-- Metric 2: 360 Studio Complete -->
    <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between gap-3 relative overflow-hidden group hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">360° Döner Vitrin Tamamlanma</span>
        <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-lg">360</span>
        </span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-display text-3xl font-extrabold text-slate-900 leading-none">100%</span>
        <span class="text-xs font-semibold text-emerald-600"><%= @listings.size %> / <%= @listings.size %> Hazır</span>
      </div>
      <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
        <div class="bg-emerald-500 h-full rounded-full" style="width: 100%;"></div>
      </div>
    </div>

    <!-- Metric 3: Avg Days to Turn -->
    <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between gap-3 relative overflow-hidden group hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Ortalama Satış Hızı (Turn)</span>
        <span class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-lg">schedule</span>
        </span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-display text-3xl font-extrabold text-slate-900 leading-none">14.2</span>
        <span class="text-xs font-semibold text-slate-600">Stok Günü</span>
      </div>
      <div class="flex items-center gap-1.5 text-xs">
        <span class="material-symbols-outlined text-emerald-600 text-base">arrow_downward</span>
        <span class="font-semibold text-emerald-600">-3.4 Gün</span>
        <span class="text-slate-400">bölgesel ortalamadan hızlı</span>
      </div>
    </div>

    <!-- Metric 4: Inspection Verified Rate -->
    <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between gap-3 relative overflow-hidden group hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">160-Nokta Ekspertiz Doğrulama</span>
        <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-lg">verified</span>
        </span>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="font-display text-3xl font-extrabold text-slate-900 leading-none">98.6%</span>
        <span class="text-xs font-semibold text-emerald-600">Sertifikalı</span>
      </div>
      <div class="flex items-center gap-1.5 text-xs text-slate-600">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-slate-800">Carvana & Impel.io Standardı</span>
      </div>
    </div>
  </div>

  <!-- Merchandising Faceted Control Toolbar -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
    <!-- Top Command Row: Search, Tabs & Primary Ingest -->
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">search</span>
        <input id="fleet-search-input"
               type="text"
               placeholder="VIN, Stok No, Marka, Model veya Renk Koduna göre ara..."
               class="w-full h-11 pl-11 pr-4 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl text-sm placeholder:text-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#1D4ED8]/20 focus:border-[#1D4ED8] transition" />
      </div>

      <!-- Merchandising Status Segment Pills -->
      <div class="flex items-center bg-slate-100 p-1 rounded-xl gap-1 overflow-x-auto text-xs font-semibold" id="status-filter-pills">
        <button type="button" data-filter-status="all" class="status-pill px-3.5 py-1.5 rounded-lg bg-white text-[#1D4ED8] shadow-xs flex items-center gap-1.5 cursor-pointer transition">
          <span>Tüm Filo</span>
          <span class="px-1.5 py-0.2 bg-blue-50 text-[#1D4ED8] text-[10px] font-bold rounded-full"><%= @listings.size %></span>
        </button>
        <button type="button" data-filter-status="published" class="status-pill px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition flex items-center gap-1.5 cursor-pointer">
          <span>Yayında / Web</span>
          <span class="px-1.5 py-0.2 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded-full"><%= @listings.where(status: :published).size %></span>
        </button>
        <button type="button" data-filter-status="optimized" class="status-pill px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition flex items-center gap-1.5 cursor-pointer">
          <span>Optimize / 360° Hazır</span>
          <span class="px-1.5 py-0.2 bg-amber-50 text-amber-700 text-[10px] font-bold rounded-full"><%= @listings.where(status: :optimized).size %></span>
        </button>
        <button type="button" data-filter-status="draft" class="status-pill px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition flex items-center gap-1.5 cursor-pointer">
          <span>Taslak / Staging</span>
          <span class="px-1.5 py-0.2 bg-slate-200 text-slate-600 text-[10px] font-bold rounded-full"><%= @listings.where(status: :draft).size %></span>
        </button>
      </div>

      <!-- Right Sort & Ingest CTA -->
      <div class="flex items-center gap-2">
        <div class="relative">
          <select id="fleet-sort-select" class="h-11 pl-3.5 pr-8 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#1D4ED8]/20 focus:border-[#1D4ED8] appearance-none">
            <option value="ctr">Sırala: En Yüksek CTR Artışı</option>
            <option value="price_desc">Sırala: Fiyat (Yüksekten Düşüğe)</option>
            <option value="price_asc">Sırala: Fiyat (Düşükten Yükseğe)</option>
            <option value="newest">Sırala: Stok Günü (En Yeni)</option>
          </select>
          <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-base">expand_more</span>
        </div>

        <%= link_to new_listing_path, class: "h-11 px-4 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs flex items-center gap-1.5 shadow-sm transition active:scale-[0.99]" do %>
          <span class="material-symbols-outlined text-base">add</span>
          <span class="hidden sm:inline">Yeni Araç Ekle</span>
        <% end %>
      </div>
    </div>

    <!-- Secondary Faceted Filters Row -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 pt-2 border-t border-slate-100 text-xs">
      <div class="relative">
        <select id="filter-brand" class="w-full h-9 pl-3 pr-7 bg-slate-50 border border-slate-200 rounded-lg font-medium text-slate-700 appearance-none cursor-pointer focus:outline-none">
          <option value="all">Marka: Tümü (<%= @listings.map(&:brand).uniq.join(', ') %>)</option>
          <% @listings.map(&:brand).uniq.each do |brand| %>
            <option value="<%= brand.downcase %>"><%= brand %></option>
          <% end %>
        </select>
        <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm">expand_more</span>
      </div>

      <div class="relative">
        <select id="filter-year" class="w-full h-9 pl-3 pr-7 bg-slate-50 border border-slate-200 rounded-lg font-medium text-slate-700 appearance-none cursor-pointer focus:outline-none">
          <option value="all">Yıl: Tümü (2021 – 2024)</option>
          <option value="2024">2024 Model</option>
          <option value="2023">2023 Model</option>
        </select>
        <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm">expand_more</span>
      </div>

      <div class="relative">
        <select id="filter-fuel" class="w-full h-9 pl-3 pr-7 bg-slate-50 border border-slate-200 rounded-lg font-medium text-slate-700 appearance-none cursor-pointer focus:outline-none">
          <option value="all">Yakıt: Tümü</option>
          <option value="benzin">Benzin</option>
          <option value="elektrik">Elektrik (BEV)</option>
          <option value="dizel">Dizel</option>
        </select>
        <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm">expand_more</span>
      </div>

      <div class="relative">
        <select id="filter-transmission" class="w-full h-9 pl-3 pr-7 bg-slate-50 border border-slate-200 rounded-lg font-medium text-slate-700 appearance-none cursor-pointer focus:outline-none">
          <option value="all">Vites: Tümü</option>
          <option value="otomatik">Otomatik / Steptronic / PDK</option>
          <option value="tek vites">Tek Vites EV</option>
        </select>
        <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm">expand_more</span>
      </div>

      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          <select id="filter-price" class="w-full h-9 pl-3 pr-7 bg-slate-50 border border-slate-200 rounded-lg font-medium text-slate-700 appearance-none cursor-pointer focus:outline-none">
            <option value="all">Fiyat: Tümü</option>
            <option value="under_2m">₺2.000.000 altı</option>
            <option value="2m_to_35m">₺2.000.000 – ₺3.500.000</option>
            <option value="over_35m">₺3.500.000 üstü</option>
          </select>
          <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm">expand_more</span>
        </div>
        <button id="reset-fleet-filters" type="button" class="h-9 px-2.5 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-500 hover:text-slate-800 transition cursor-pointer" title="Filtreleri Sıfırla">
          <span class="material-symbols-outlined text-sm">restart_alt</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Listings Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <h1 class="font-headline text-2xl font-bold tracking-tight text-slate-900">
        Araç Filosu & 360° Vitrin Yönetimi
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Daylight D65 stüdyo simülasyonu, 72-kare döner tabla sekansı ve 45° Hero Shot vitrin vitrini.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span id="fleet-visible-count" class="px-3 py-1 rounded-lg bg-white border border-slate-200 text-xs font-mono font-medium text-slate-600 shadow-xs">
        <%= @listings.size %> Birim Listeleniyor
      </span>
    </div>
  </div>

  <!-- Vehicle Listing Grid: Stitch Luxury Daylight Architecture -->
  <% if @listings.any? %>
    <div id="vehicle-listings-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <% @listings.each do |listing| %>
        <% hero_analysis = listing.hero_photo_analysis %>
        <% hero_src = listing_hero_image_url(listing) %>
        <% fallback_src = vehicle_fallback_image(listing) %>
        <% quality_score = hero_analysis&.quality_score || 96 %>
        <% vin_code = "#{listing.brand[0..2].upcase}#{listing.id.to_s.rjust(8, '0')}" %>

        <div class="vehicle-card bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group"
             data-brand="<%= listing.brand.to_s.downcase %>"
             data-year="<%= listing.year %>"
             data-fuel="<%= listing.fuel_type.to_s.downcase %>"
             data-transmission="<%= listing.transmission.to_s.downcase %>"
             data-price="<%= listing.price.to_i %>"
             data-status="<%= listing.status %>"
             data-ctr="<%= quality_score %>"
             data-created="<%= listing.created_at.to_i %>"
             data-search="<%= [listing.title, listing.brand, listing.model_name, listing.color, vin_code, listing.fuel_type].join(' ').downcase %>">
          <!-- Turntable Daylight Stage Viewport -->
          <div class="relative aspect-[16/10] bg-slate-100 overflow-hidden">
            <!-- Studio Ambient Glow Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent z-10 pointer-events-none"></div>

            <!-- Bulletproof Vehicle Image with Resilient CDN Fallback & 1x1 Pixel Guard -->
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                 src="<%= hero_src %>"
                 alt="<%= listing.title %>"
                 loading="lazy"
                 onload="if(this.naturalWidth<=1){this.src='<%= fallback_src %>';}"
                 onerror="this.onerror=null;this.src='<%= fallback_src %>';" />

            <!-- Floating Studio Overlay Badges (Top Left) -->
            <div class="absolute top-3 left-3 z-20 flex flex-col gap-1.5 items-start">
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/95 backdrop-blur-md text-[#1D4ED8] shadow-sm text-xs font-bold">
                <span class="material-symbols-outlined text-sm text-[#1D4ED8] animate-spin" style="animation-duration: 9s;">360</span>
                <span>360° Spin Hazır (72 Kare)</span>
              </div>
              <div class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/90 backdrop-blur-md text-white shadow-sm text-[11px] font-semibold">
                <span class="material-symbols-outlined text-xs">verified</span>
                <span>160-Nokta Onaylı</span>
              </div>
            </div>

            <!-- Top Right: Status Badge -->
            <div class="absolute top-3 right-3 z-20">
              <% if listing.published? %>
                <span class="px-2.5 py-1 rounded-full bg-emerald-600 text-white text-[11px] font-bold shadow-sm">
                  YAYINDA
                </span>
              <% elsif listing.optimized? %>
                <span class="px-2.5 py-1 rounded-full bg-[#1D4ED8] text-white text-[11px] font-bold shadow-sm">
                  OPTİMİZE
                </span>
              <% elsif listing.analyzing? %>
                <span class="px-2.5 py-1 rounded-full bg-amber-500 text-white text-[11px] font-bold shadow-sm animate-pulse">
                  ANALİZDE
                </span>
              <% else %>
                <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-200 text-[11px] font-medium shadow-sm">
                  TASLAK
                </span>
              <% end %>
            </div>

            <!-- Bottom Stage Angle Telemetry HUD -->
            <div class="absolute bottom-2.5 left-3 right-3 z-20 flex items-center justify-between pointer-events-none text-[11px]">
              <span class="px-2 py-0.5 rounded bg-slate-900/80 text-white font-mono backdrop-blur-sm">
                Daylight Bay 04 • Dome 96 CRI
              </span>
              <span class="px-2 py-0.5 rounded bg-white/90 text-slate-800 font-mono font-semibold backdrop-blur-sm">
                VIN: <%= vin_code %>
              </span>
            </div>
          </div>

          <!-- Content Area -->
          <div class="p-5 flex flex-col flex-1 justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1 min-w-0">
                  <span class="text-[11px] font-bold text-[#1D4ED8] uppercase tracking-wider block">
                    AutoAorta Sertifikalı <%= listing.brand %>
                  </span>
                  <h3 class="font-headline text-base font-bold text-slate-900 leading-snug group-hover:text-[#1D4ED8] transition-colors line-clamp-1">
                    <%= link_to listing.title, listing_path(listing) %>
                  </h3>
                  <p class="text-xs text-slate-500 truncate">
                    <%= listing.color %> • <%= listing.model_name %>
                  </p>
                </div>
                <div class="flex flex-col items-end flex-shrink-0">
                  <span class="font-headline text-lg font-black text-slate-900">
                    <%= number_to_currency(listing.price, unit: "₺", precision: 0, format: "%n %u") %>
                  </span>
                  <span class="text-[11px] font-medium text-slate-400">Krediye Uygun</span>
                </div>
              </div>

              <!-- Technical Spec Badges Row (Daylight Chips) -->
              <div class="flex flex-wrap items-center gap-1.5 pt-2">
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-slate-400">speed</span>
                  <%= number_with_delimiter(listing.mileage) %> KM
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-slate-400">local_gas_station</span>
                  <%= listing.fuel_type %>
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-slate-400">tune</span>
                  <%= listing.transmission %>
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-slate-400">timer</span>
                  5 Gün Stokta
                </span>
              </div>
            </div>

            <!-- Merchandising Quality Index Badge -->
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm">
                  <%= quality_score %>
                </div>
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-slate-800 leading-tight">A+ Merchandising Grade</span>
                  <span class="text-[11px] text-slate-500 leading-tight">360° Studio + 4K Staging</span>
                </div>
              </div>
              <span class="text-xs font-bold text-emerald-600">+%170 CTR Artışı</span>
            </div>

            <!-- Action Buttons Tier -->
            <div class="flex items-center gap-2 pt-2 border-t border-slate-100">
              <%= link_to listing_path(listing), class: "flex-1 py-2.5 px-3 rounded-xl bg-[#1D4ED8] hover:bg-blue-800 text-white font-semibold text-xs flex items-center justify-center gap-1.5 shadow-sm transition active:scale-[0.99]" do %>
                <span class="material-symbols-outlined text-base">view_in_ar</span>
                <span>Open 360 Studio</span>
              <% end %>

              <%= link_to listing_path(listing, anchor: "ai-photo-matrix"), class: "p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition", title: "AI Stüdyo & Açı Matrisi" do %>
                <span class="material-symbols-outlined text-base">tune</span>
              <% end %>

              <%= link_to embed_listing_url(listing), target: "_blank", class: "p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition", title: "Embed Önizle" do %>
                <span class="material-symbols-outlined text-base">ios_share</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Dynamic No Results State (Hidden by default) -->
    <div id="fleet-no-results" class="hidden rounded-2xl border border-slate-200 bg-white p-10 text-center space-y-3 shadow-xs">
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#1D4ED8] flex items-center justify-center mx-auto">
        <span class="material-symbols-outlined text-2xl">filter_alt_off</span>
      </div>
      <h3 class="text-base font-bold text-slate-900">Seçilen Filtrelere Uygun Araç Bulunamadı</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">Arama kriterlerinizi veya filtre seçimlerinizi sıfırlayarak tüm aktif araç filosunu görüntüleyebilirsiniz.</p>
      <button type="button" onclick="document.getElementById('reset-fleet-filters').click()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#1D4ED8] text-white text-xs font-bold hover:bg-blue-800 transition cursor-pointer">
        <span class="material-symbols-outlined text-sm">restart_alt</span>
        <span>Tüm Filtreleri Sıfırla</span>
      </button>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center space-y-4 shadow-sm">
      <div class="w-16 h-16 rounded-2xl bg-blue-50 text-[#1D4ED8] flex items-center justify-center mx-auto">
        <span class="material-symbols-outlined text-3xl">directions_car</span>
      </div>
      <h3 class="text-lg font-bold text-slate-900">Henüz Araç Eklenmedi</h3>
      <p class="text-slate-500 text-sm max-w-md mx-auto">
        Filoya yeni bir araç ekleyin ve AutoAorta AI Stüdyosu'nun saniyeler içinde 360° döner vitrin üretmesini sağlayın.
      </p>
      <%= link_to new_listing_path, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#1D4ED8] text-white font-bold text-sm shadow-md hover:bg-blue-800 transition" do %>
        <span class="material-symbols-outlined text-base">add</span>
        <span>İlk Aracı Ekle & Ingest Et</span>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", initFleetFilters);
  document.addEventListener("DOMContentLoaded", initFleetFilters);

  function initFleetFilters() {
    const grid = document.getElementById("vehicle-listings-grid");
    if (!grid || grid.dataset.initialized === "true") return;
    grid.dataset.initialized = "true";

    const searchInput = document.getElementById("fleet-search-input");
    const sortSelect = document.getElementById("fleet-sort-select");
    const brandSelect = document.getElementById("filter-brand");
    const yearSelect = document.getElementById("filter-year");
    const fuelSelect = document.getElementById("filter-fuel");
    const transSelect = document.getElementById("filter-transmission");
    const priceSelect = document.getElementById("filter-price");
    const resetBtn = document.getElementById("reset-fleet-filters");
    const statusPills = document.querySelectorAll(".status-pill");
    const visibleCountEl = document.getElementById("fleet-visible-count");
    const noResultsEl = document.getElementById("fleet-no-results");

    let activeStatus = "all";

    function applyFiltersAndSort() {
      const cards = Array.from(grid.querySelectorAll(".vehicle-card"));
      const q = (searchInput?.value || "").trim().toLowerCase();
      const brand = brandSelect?.value || "all";
      const year = yearSelect?.value || "all";
      const fuel = fuelSelect?.value || "all";
      const trans = transSelect?.value || "all";
      const price = priceSelect?.value || "all";
      const sortBy = sortSelect?.value || "ctr";

      let visibleCount = 0;

      cards.forEach((card) => {
        const cardSearch = card.dataset.search || "";
        const cardBrand = card.dataset.brand || "";
        const cardYear = card.dataset.year || "";
        const cardFuel = card.dataset.fuel || "";
        const cardTrans = card.dataset.transmission || "";
        const cardPrice = parseInt(card.dataset.price || "0", 10);
        const cardStatus = card.dataset.status || "";

        let match = true;
        if (q && !cardSearch.includes(q)) match = false;
        if (activeStatus !== "all" && cardStatus !== activeStatus) match = false;
        if (brand !== "all" && !cardBrand.includes(brand)) match = false;
        if (year !== "all" && cardYear !== year) match = false;
        if (fuel !== "all" && !cardFuel.includes(fuel)) match = false;
        if (trans !== "all") {
          if (trans === "otomatik" && !(cardTrans.includes("otomatik") || cardTrans.includes("pdk") || cardTrans.includes("steptronic"))) match = false;
          if (trans === "tek vites" && !cardTrans.includes("tek vites")) match = false;
        }
        if (price !== "all") {
          if (price === "under_2m" && cardPrice >= 2000000) match = false;
          if (price === "2m_to_35m" && (cardPrice < 2000000 || cardPrice > 3500000)) match = false;
          if (price === "over_35m" && cardPrice <= 3500000) match = false;
        }

        if (match) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      // Sort cards
      cards.sort((a, b) => {
        if (sortBy === "price_desc") {
          return parseInt(b.dataset.price || "0", 10) - parseInt(a.dataset.price || "0", 10);
        } else if (sortBy === "price_asc") {
          return parseInt(a.dataset.price || "0", 10) - parseInt(b.dataset.price || "0", 10);
        } else if (sortBy === "newest") {
          return parseInt(b.dataset.created || "0", 10) - parseInt(a.dataset.created || "0", 10);
        } else {
          return parseInt(b.dataset.ctr || "0", 10) - parseInt(a.dataset.ctr || "0", 10);
        }
      });

      cards.forEach((card) => grid.appendChild(card));

      if (visibleCountEl) {
        visibleCountEl.textContent = `${visibleCount} Birim Listeleniyor`;
      }
      if (noResultsEl) {
        noResultsEl.classList.toggle("hidden", visibleCount > 0);
      }
    }

    statusPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        activeStatus = pill.dataset.filterStatus || "all";
        statusPills.forEach((p) => {
          p.className = "status-pill px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition flex items-center gap-1.5 cursor-pointer";
        });
        pill.className = "status-pill px-3.5 py-1.5 rounded-lg bg-white text-[#1D4ED8] shadow-xs flex items-center gap-1.5 cursor-pointer transition";
        applyFiltersAndSort();
      });
    });

    [searchInput, sortSelect, brandSelect, yearSelect, fuelSelect, transSelect, priceSelect].forEach((el) => {
      if (!el) return;
      el.addEventListener("input", applyFiltersAndSort);
      el.addEventListener("change", applyFiltersAndSort);
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (sortSelect) sortSelect.value = "ctr";
        if (brandSelect) brandSelect.value = "all";
        if (yearSelect) yearSelect.value = "all";
        if (fuelSelect) fuelSelect.value = "all";
        if (transSelect) transSelect.value = "all";
        if (priceSelect) priceSelect.value = "all";
        activeStatus = "all";
        if (statusPills.length > 0) statusPills[0].click();
        else applyFiltersAndSort();
      });
    }
  }
</script>
